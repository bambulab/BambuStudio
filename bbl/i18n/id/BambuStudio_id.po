msgstr "Profil standar untuk nosel 0,4 mm, memprioritaskan kecepatan."

msgid "High quality profile for 0.6mm nozzle, prioritizing print quality and strength."
msgstr "Profil kualitas tinggi untuk nosel 0,6 mm, memprioritaskan kualitas cetak."

msgid "Strength profile for 0.6mm nozzle, prioritizing strength."
msgstr "Profil kekuatan untuk nosel 0,6 mm, memprioritaskan kekuatan."

msgid "Standard profile for 0.6mm nozzle, prioritizing speed."
msgstr "Profil standar untuk nosel 0,6 mm, memprioritaskan kecepatan."

msgid "High quality profile for 0.8mm nozzle, prioritizing print quality."
msgstr "Profil kualitas tinggi untuk nosel 0,8 mm, memprioritaskan kualitas cetak."

msgid "Strength profile for 0.8mm nozzle, prioritizing strength."
msgstr "Profil kekuatan untuk nosel 0,8 mm, memprioritaskan kekuatan."

msgid "Standard profile for 0.8mm nozzle, prioritizing speed."
msgstr "Profil standar nosel 0,8mm, mengutamakan kecepatan."

