msgstr "File CA HTTPS bersifat opsional. Ini hanya diperlukan jika Anda menggunakan HTTPS dengan sertifikat yang ditandatangani sendiri."

msgid "Certificate files (*.crt, *.pem)|*.crt;*.pem|All files|*.*"
msgstr "File sertifikat (*.crt, *.pem)|*.crt;*.pem|Semua file|*.*"

msgid "Open CA certificate file"
msgstr "Buka file sertifikat CA"

#, c-format, boost-format
