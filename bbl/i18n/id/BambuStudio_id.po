msgstr "Menghentikan pencetakan jika terdeteksi pergeseran pelat cetak."

msgid "Build Plate Detection"
msgstr "Deteksi Pelat Cetak"

msgid "Identifies the type and position of the build plate on the heatbed. Pausing printing if a mismatch is detected."
msgstr "Mengidentifikasi jenis dan posisi pelat cetak pada alas panas. Mencetak akan dijeda jika terdeteksi ketidakcocokan."

msgid "AI Detections"
msgstr "Deteksi AI"

msgid "Printer will send assistant message or pause printing if any of the following problem is detected."
msgstr "Printer akan mengirim pesan bantuan atau menjeda pencetakan jika salah satu masalah berikut terdeteksi."

