msgstr "Akselerasi Maksimum Sumbu X"

msgid "Maximum acceleration of the Y axis"
msgstr "Akselerasi Maksimum Sumbu Y"

msgid "Maximum acceleration of the Z axis"
msgstr "Akselerasi Maksimum Sumbu Z"

msgid "Maximum acceleration of the E axis"
msgstr "Akselerasi Maksimum Sumbu E"

