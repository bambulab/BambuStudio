msgstr "Pola garis untuk pengisian kerangka"

msgid "Acceleration of top surface infill. Using a lower value may improve top surface quality"
msgstr "Akselerasi pengisian permukaan atas. Menggunakan nilai yang lebih rendah dapat meningkatkan kualitas permukaan atas"

msgid "Acceleration of outer wall. Using a lower value can improve quality"
msgstr "Akselerasi dinding luar. Menggunakan nilai yang lebih rendah dapat meningkatkan kualitas"

msgid "Acceleration of inner walls. 0 means using normal printing acceleration"
msgstr "Akselerasi dinding dalam. 0 berarti menggunakan akselerasi pencetakan normal"

msgid "Acceleration of sparse infill. If the value is expressed as a percentage (e.g. 100%), it will be calculated based on the default acceleration."
msgstr "Akselerasi pengisian sparse. Jika nilai dinyatakan sebagai persentase (misalnya 100%), akan dihitung berdasarkan akselerasi default."

msgid "mm/s² or %"
msgstr "mm/s² atau %"

msgid "Acceleration of initial layer. Using a lower value can improve build plate adhensive"
msgstr "Akselerasi lapisan awal. Menggunakan nilai yang lebih rendah dapat meningkatkan daya rekat pada pelat cetak"

msgid "Enable accel_to_decel"
msgstr "Aktifkan accel_to_decel"

msgid "Klipper's max_accel_to_decel will be adjusted automatically"
msgstr "max_accel_to_decel Klipper akan disesuaikan secara otomatis"

