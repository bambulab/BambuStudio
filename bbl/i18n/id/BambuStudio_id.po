msgstr "Deteksi Tumpukan Bahan di Saluran Pembuangan"

msgid "Monitors if the waste is piled up in the purge chute."
msgstr "Memantau apakah limbah menumpuk di saluran pembersihan."

msgid "Nozzle Clumping Detection"
msgstr "Deteksi Penggumpalan Nosel"

msgid "Checks if the nozzle is clumping by filaments or other foreign objects."
msgstr "Memeriksa apakah nosel tersumbat oleh filamen atau benda asing lainnya."

msgid "Detects air printing caused by nozzle clogging or filament grinding."
msgstr "Mendeteksi cetak udara yang disebabkan oleh penyumbatan nosel atau penggilingan filamen."

msgid "Foreign Object Detection"
msgstr "Deteksi Objek Asing"

msgid "Checks for any objects on the build plate at the start of a print to avoid collisions."
msgstr "Memeriksa objek apa pun di pelat cetak pada awal pencetakan untuk menghindari tabrakan."

msgid "Printed Part Displacement Detection"
msgstr "Deteksi Pergeseran Bagian Tercetak"

msgid "Monitors the printed part during printing and alerts immediately if it shifts or collapses."
msgstr "Memantau bagian tercetak selama pencetakan dan segera memberikan peringatan jika bergeser atau roboh."

msgid "Ensures the build plate type and placement are correct."
msgstr "Memastikan jenis dan penempatan plat cetak sudah benar."

msgid "Type Detection"
msgstr "Deteksi Jenis"

msgid "Pauses printing when the detected build plate type does not match the selected one."
msgstr "Jeda pencetakan saat jenis pelat cetak yang terdeteksi tidak cocok dengan yang dipilih."

msgid "Alignment Detection"
msgstr "Deteksi Pergeseran"

msgid "First Layer Inspection"
msgstr "Inspeksi Lapisan Pertama"

