msgstr "kedua ekstruder"

#, c-format, boost-format
msgid "[ %s ] requires printing in a high-temperature environment. Reminder to close the door if not already closed."
msgstr "[ %s ] memerlukan pencetakan di lingkungan bersuhu tinggi. Ingat untuk menutup pintu jika belum tertutup."

#, c-format, boost-format
msgid "[ %s ] requires printing in a high-temperature environment."
msgstr "[ %s ] memerlukan pencetakan di lingkungan bersuhu tinggi."

#, c-format, boost-format
msgid "The filament on %s may soften. Please unload."
msgstr "Filamen pada %s mungkin melunak. Harap bongkar."

