msgstr "Jerk Maksimum Sumbu X"

msgid "Maximum jerk of the Y axis"
msgstr "Jerk Maksimum Sumbu Y"

msgid "Maximum jerk of the Z axis"
msgstr "Jerk Maksimum Sumbu Z"

msgid "Maximum jerk of the E axis"
msgstr "Jerk Maksimum Sumbu E"

msgid "Maximum force of the Y axis"
msgstr "Gaya maksimum sumbu Y"

msgid "The allowed maximum output force of Y axis"
msgstr "Gaya output maksimum yang diizinkan dari sumbu Y"

