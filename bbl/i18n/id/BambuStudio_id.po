msgstr "Harap selesaikan inisialisasi rak hotend lalu coba lagi."

msgid "Please refresh the nozzle information and try again."
msgstr "Harap segarkan informasi nosel lalu coba lagi."

msgid "Please re-slice."
msgstr "Harap iris ulang."

