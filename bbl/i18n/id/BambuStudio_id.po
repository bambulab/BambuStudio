msgstr "Sarang Lebah"

msgid "Adaptive Cubic"
msgstr "Kubik Adaptif"

msgid "3D Honeycomb"
msgstr "Sarang Lebah 3D"

msgid "Support Cubic"
msgstr "Kubik Dukungan"

msgid "Lightning"
msgstr "Petir"

msgid "Cross Hatch"
msgstr "Garis Silang"

msgid "Zig Zag"
msgstr ""

