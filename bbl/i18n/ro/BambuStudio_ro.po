msgstr "Densitatea umplerii rare interne, 100%% înseamnă solidă pe toată suprafața"

msgid "Fill multiline"
msgstr "Umplere cu linii multiple"

msgid "Using multiple lines for the infill pattern, if supported by infill pattern."
msgstr "Utilizarea mai multor linii pentru modelul de umplere, dacă este acceptat de modelul de umplere."

msgid "Sparse infill pattern"
msgstr "Model umplere rară"

msgid "Line pattern for internal sparse infill"
msgstr "Model linie pentru umplere rară internă"

