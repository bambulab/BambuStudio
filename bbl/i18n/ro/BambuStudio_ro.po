msgstr "Jerk maxim E"

msgid "Maximum jerk of the X axis"
msgstr "Jerk-ul maxim al axei X"

msgid "Maximum jerk of the Y axis"
msgstr "Jerk-ul maxim al axei Y"

msgid "Maximum jerk of the Z axis"
msgstr "Jerk-ul maxim al axei Z"

msgid "Maximum jerk of the E axis"
msgstr "Jerk-ul maxim al axei E"

msgid "Maximum force of the Y axis"
msgstr "Forța maximă a axei Y"

msgid "The allowed maximum output force of Y axis"
msgstr "Forța maximă de ieșire permisă a axei Y"

msgid "N"
msgstr ""

msgid "Bed mass of the Y axis"
msgstr "Masa patului axei Y"

msgid "The machine bed mass load of Y axis"
msgstr "Sarcina de masă a patului mașinii pe axa Y"

