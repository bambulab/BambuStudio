msgid "Minimum speed for extruding"
msgstr "Viteză minimă de extrudare"

msgid "Minimum speed for extruding (M205 S)"
msgstr "Viteză minimă de extrudare (M205 S)"

msgid "Minimum travel speed"
msgstr "Viteză minimă de deplasare"

msgid "Minimum travel speed (M205 T)"
msgstr "Viteză minimă de deplasare (M205 T)"

msgid "Maximum acceleration for extruding"
msgstr "Accelerație maximă pentru extrudare"

msgid "Maximum acceleration for extruding (M204 P)"
msgstr "Accelerație maximă pentru extrudare (M204 P)"

msgid "Maximum acceleration for retracting"
msgstr "Accelerație maximă pentru retragere"

