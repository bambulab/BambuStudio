msgstr "Model fagure 3D"

msgid "Support Cubic"
msgstr "Cubic de suport"

msgid "Lightning"
msgstr "Fulger"

msgid "Cross Hatch"
msgstr "Hășurare în cruce"

msgid "Zig Zag"
msgstr "Zigzag"

msgid "Cross Zag"
msgstr "Zag în cruce"

msgid "Locked Zag"
msgstr "Zag blocat"

msgid "2D Lattice"
msgstr "Rețea 2D"

