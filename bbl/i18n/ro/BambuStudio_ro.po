msgstr "Accelerația maximă a axei X"

msgid "Maximum acceleration of the Y axis"
msgstr "Accelerația maximă a axei Y"

msgid "Maximum acceleration of the Z axis"
msgstr "Accelerația maximă a axei Z"

msgid "Maximum acceleration of the E axis"
msgstr "Accelerația maximă a axei E"

