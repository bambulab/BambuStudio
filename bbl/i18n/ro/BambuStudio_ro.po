msgstr "Fără verificare"

msgid "Do not run any validity checks, such as gcode path conflicts check."
msgstr "Nu rulați nicio verificare de validitate, cum ar fi verificarea conflictelor de cale gcode."

msgid "Error in zip archive"
msgstr "Eroare în arhiva zip"

msgid "Generating walls"
msgstr "Se generează pereți"

msgid "Generating infill regions"
msgstr "Se generează regiuni de umplere"

msgid "Generating infill toolpath"
msgstr "Se generează traseul de uneltire pentru umplere"

msgid "Detect overhangs for auto-lift"
msgstr "Detectare surplombe pentru ridicare automată"

msgid "Checking support necessity"
msgstr "Se verifică necesitatea suportului"

msgid "floating regions"
msgstr "regiuni flotante"

msgid "floating cantilever"
msgstr "consolă flotantă"

msgid "large overhangs"
msgstr "surplombe mari"

