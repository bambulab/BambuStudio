msgstr "Ääriviivan alaraja"

# Finnish review: English/context/Swedish/glossary
msgid "counter_limit_min"
msgstr "counter_limit_min"

# Finnish review: English/context/Swedish/glossary
msgid "Contour limit max"
msgstr "Ääriviivan yläraja"

