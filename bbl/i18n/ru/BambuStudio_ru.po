msgid "TPU is not supported by AMS."
msgstr "AMS не поддерживает TPU."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS не поддерживает 'Bambu Lab PET-CF'."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Текущий филамент несовместим с соплом E3D с повышенным потоком и не может использоваться."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "При использовании %s в правом экструдере этот материал можно использовать только как материал поддержки."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Текущий филамент несовместим с соплом TPU с повышенным потоком и не может использоваться."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "Автоматическая калибровка динамики потока не поддерживается для филамента TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Bambu TPU 85A не поддерживает печать стандартным соплом 0,4 мм или соплом 0,4 мм с повышенным потоком."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "При использовании ABS/ASA/PETG HF в правом экструдере эти материалы можно использовать только как материал поддержки."

msgid "How to feed TPU filament."
msgstr "Как загрузить филамент TPU."

msgid "How to feed TPU filament on X2D."
msgstr "Как загрузить филамент TPU в X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Использование филаментов сторонних производителей может привести к проблемам с качеством печати."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Перед печатью TPU выполните очистку методом Cold Pull, чтобы избежать закупорки. На принтере можно выполнить техническое обслуживание методом Cold Pull."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Влажный PVA становится гибким и может застрять внутри AMS. Перед использованием обязательно просушите его."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Влажный PVA становится гибким и может застрять в экструдере. Просушите его перед использованием."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF хрупкий и может сломаться в изогнутой PTFE-трубке над печатающей головкой."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF хрупкий и может сломаться в изогнутой PTFE-трубке над печатающей головкой."

msgid "CF/GF filaments are hard and brittle, It's easy to break or get stuck in AMS, please use with caution."
msgstr "CF/GF пластиковые нити твердые и хрупкие, легко ломаются или застревают в АСПП, поэтому используйте их с осторожностью."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "PLA Glow может вызвать износ подающего механизма первой ступени AMS. Вместо этого используйте внешнюю катушку."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Настройки по умолчанию могут повлиять на качество печати. Для достижения наилучших результатов при необходимости скорректируйте настройки."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "При использовании%s с соплом 0,4 мм с повышенным потоком существует риск закупорки сопла. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "%s Филаменты твёрдые и хрупкие, поэтому могут сломаться в AMS; кроме того, при использовании сопла 0,4 мм с повышенным потоком существует риск закупорки сопла. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "%s При использовании с соплами 0,4, 0,6 и 0,8 мм с повышенным потоком существует риск закупорки сопла. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "%s Загрузка или выгрузка может завершиться неудачей из-за переключателя тракта филамента. Если вы хотите продолжить."

