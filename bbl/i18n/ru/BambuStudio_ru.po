#, boost-format
msgid "%1% is too close to exclusion area, there may be collisions when printing."
msgstr "%1% слишком близко к зоне исключения, при печати могут возникнуть столкновения."

#, boost-format
msgid "%1% is too close to others, and collisions may be caused."
msgstr "%1% слишком близко к другим объектам, что может привести к столкновениям."

