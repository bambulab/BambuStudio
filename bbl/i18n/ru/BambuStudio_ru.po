msgid "TPU is not supported by AMS."
msgstr "Печать TPU с помощью AMS не поддерживается."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS не поддерживает Bambu Lab PET-CF."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Невозможно использовать материал, несовместимый с высокопроизводительным соплом E3D."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "При использовании %s на правом экструдере его можно использовать только в качестве материала поддержек."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Невозможно использовать материал, несовместимый с высокопроизводительным соплом для TPU."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "TPU не поддерживает автоматическую калибровку динамики потока."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Материал Bambu TPU 85A не предназначен для печати через стандартные и высокопроизводительные сопла диаметром 0,4 мм."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "При использовании ABS/ASA/PETG HF на правом экструдере его можно использовать только в качестве материала поддержек."

msgid "How to feed TPU filament."
msgstr "Заправка TPU."

msgid "How to feed TPU filament on X2D."
msgstr "Заправка TPU в X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Использование филаментов сторонних производителей может привести к ухудшению качества печати."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Перед печатью TPU выполните холодную протяжку, чтобы избежать засорения. Вы можете воспользоваться функцией холодной протяжки на принтере."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Влажный PVA становится гибким и застревает внутри АСПП, поэтому перед использованием его необходимо просушить."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Влажный PVA становится гибким и может застрять в подающем механизме. Перед печатью им необходима сушка."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF – это хрупкий материал, который может сломаться в изогнутом тефлоновом канале подачи."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF – это хрупкий материал, который может сломаться в изогнутом тефлоновом канале подачи."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "Использование PLA Glow может привести к износу привода первой ступени AMS. Воспользуйтесь внешним держателем."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Стандартные настройки могут повлиять на качество печати. Для улучшения результата рекомендуется тонкая настройка параметров."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "%s может привести к затору в высокопроизводительном сопле диаметром 0,4 мм. Используйте его с осторожностью."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Материалы %s жёсткие и ломкие, их использование может привести к поломке внутри AMS и затору в высокопроизводительном сопле диаметром 0,4 мм. Используйте его с осторожностью."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "%s может привести к затору в высокопроизводительных соплах диаметром 0,4, 0,6 или 0,8 мм. Используйте его с осторожностью."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "Filament Track Switch может не справиться с загрузкой/выгрузкой %s."

