msgstr "Максимальный рывок по оси Y"

msgid "Maximum jerk of the Z axis"
msgstr "Максимальный рывок по оси Z"

msgid "Maximum jerk of the E axis"
msgstr "Максимальный рывок по оси E"

msgid "Maximum force of the Y axis"
msgstr "Максимальное усилие по оси Y"

msgid "The allowed maximum output force of Y axis"
msgstr "Допустимое максимальное выходное усилие по оси Y"

