#, boost-format
msgid "%1% is too close to exclusion area, there may be collisions when printing."
msgstr "%1% находится слишком близко к другим объектам; возможны столкновения."

#, boost-format
msgid "%1% is too close to others, and collisions may be caused."
msgstr "%1% находится слишком близко к запретной зоне; при печати возможны столкновения."

#, boost-format
msgid "%1% is too tall, and collisions will be caused."
msgstr "%1% слишком высокий; при печати произойдут столкновения."

msgid " is too close to exclusion area, there may be collisions when printing."
msgstr " находится слишком близко к запретной зоне; при печати возможны столкновения."

msgid " is too close to clumping detection area, there may be collisions when printing."
msgstr " находится слишком близко к зоне обнаружения слипания; при печати возможны столкновения."

msgid "Prime Tower"
msgstr "Башня очистки"

msgid " is too close to others, and collisions may be caused.\n"
msgstr " находится слишком близко к другим объектам; возможны столкновения.\n"

msgid " is too close to exclusion area, and collisions will be caused.\n"
msgstr " находится слишком близко к запретной зоне; при печати произойдут столкновения.\n"

msgid " is too close to clumping detection area, and collisions will be caused.\n"
msgstr " находится слишком близко к зоне обнаружения слипания; при печати произойдут столкновения.\n"

msgid "Printing high-temp and low-temp filaments together may cause nozzle clogging or printer damage."
msgstr "Совместная печать высокотемпературными и низкотемпературными филаментами может привести к закупорке сопла или повреждению принтера."

msgid "Printing high-temp and low-temp filaments together may cause nozzle clogging or printer damage. If you still want to print, you can enable the option in Preferences."
msgstr "Совместная печать высокотемпературными и низкотемпературными филаментами может привести к закупорке сопла или повреждению принтера. Если вы всё же хотите продолжить печать, включите эту опцию в разделе «Настройки»."

msgid "Printing different-temp filaments together may cause nozzle clogging or printer damage."
msgstr "Совместная печать филаментами с разными температурными диапазонами может привести к закупорке сопла или повреждению принтера."

msgid "Printing high-temp and mid-temp filaments together may cause nozzle clogging or printer damage."
msgstr "Совместная печать высокотемпературными и среднетемпературными филаментами может привести к закупорке сопла или повреждению принтера."

msgid "Printing mid-temp and low-temp filaments together may cause nozzle clogging or printer damage."
msgstr "Совместная печать среднетемпературными и низкотемпературными филаментами может привести к закупорке сопла или повреждению принтера."

msgid "No extrusions under current settings."
msgstr "При текущих настройках экструзия отсутствует."

msgid "Smooth mode of timelapse is not supported when \"by object\" sequence is enabled."
msgstr "Плавный режим таймлапса не поддерживается при последовательности печати «По объектам»."

msgid "Clumping detection is not supported when \"by object\" sequence is enabled."
msgstr "Обнаружение слипания не поддерживается при последовательности печати «По объектам»."

msgid "Prime tower is required for clumping detection; otherwise, there may be flaws on the model."
msgstr "Для обнаружения слипания требуется башня очистки; без неё на модели могут появиться дефекты."

msgid "Please select \"By object\" print sequence to print multiple objects in spiral vase mode."
msgstr "Для печати нескольких объектов в режиме «Спиральная ваза» выберите последовательность печати «По объектам»."

msgid "The spiral vase mode does not work when an object contains more than one materials."
msgstr "Режим «Спиральная ваза» не работает, если объект содержит более одного материала."

msgid "The spiral vase mode does not work when an object contains regions with different print settings."
msgstr "Режим «Спиральная ваза» не работает, если объект содержит области с разными настройками печати."

msgid "Variable layer height is not supported with Organic supports."
msgstr "Переменная высота слоя не поддерживается при использовании органических поддержек."

msgid "Different nozzle diameters and different filament diameters is not allowed when prime tower is enabled."
msgstr "При включённой башне очистки нельзя использовать сопла разного диаметра и филаменты разного диаметра."

msgid "The Wipe Tower is currently only supported with the relative extruder addressing (use_relative_e_distances=1)."
msgstr "В настоящее время башня очистки поддерживается только при относительной адресации экструдера (use_relative_e_distances=1)."

msgid "Ooze prevention is currently not supported with the prime tower enabled."
msgstr "В настоящее время функция предотвращения подтекания не поддерживается при включённой башне очистки."

msgid "The prime tower is currently only supported for the Marlin, RepRap/Sprinter, RepRapFirmware and Repetier G-code flavors."
msgstr "В настоящее время башня очистки поддерживается только для диалектов G-кода Marlin, RepRap/Sprinter, RepRapFirmware и Repetier."

msgid "The prime tower is not supported in \"By object\" print."
msgstr "Башня очистки не поддерживается при печати «По объектам»."

msgid "The prime tower is not supported when adaptive layer height is on. It requires that all objects have the same layer height."
msgstr "Башня очистки не поддерживается при включённой адаптивной высоте слоя. Для всех объектов должна быть задана одинаковая высота слоя."

msgid "The prime tower requires \"support gap\" to be multiple of layer height"
msgstr "Для башни очистки «зазор поддержки» должен быть кратен высоте слоя"

msgid "The prime tower requires that all objects have the same layer heights"
msgstr "Для башни очистки у всех объектов должна быть одинаковая высота слоя"

msgid "The prime tower requires that all objects are printed over the same number of raft layers"
msgstr "Для башни очистки все объекты должны печататься с одинаковым количеством слоёв рафта"

msgid "The prime tower requires that all objects are sliced with the same layer heights."
msgstr "Для башни очистки все объекты должны быть нарезаны с одинаковой высотой слоя."

msgid "The prime tower is only supported if all objects have the same variable layer height"
msgstr "Башня очистки поддерживается только при одинаковом профиле переменной высоты слоя у всех объектов"

msgid "Precise Z height gives the objects different layer heights, which may greatly increase the size of the prime tower."
msgstr "Точная высота по Z создаёт для объектов разные высоты слоёв, что может значительно увеличить размер башни очистки."

msgid "Jump to: Precise Z height"
msgstr "Перейти к: Точная высота по оси Z"

msgid "Too small line width"
msgstr "Слишком малая ширина линии"

msgid "Too large line width"
msgstr "Слишком большая ширина линии"

msgid "The prime tower requires that support has the same layer height as object."
msgstr "Для башни очистки высота слоя поддержки должна совпадать с высотой слоя объекта."

msgid "Support enforcers are used but support is not enabled. Please enable support."
msgstr "Используются области принудительной поддержки, но поддержка не включена. Включите поддержку."

msgid "Layer height cannot exceed nozzle diameter"
msgstr "Высота слоя не может превышать диаметр сопла"

#, c-format, boost-format
msgid "Plate %d: %s does not support filament %s"
msgstr "Пластина %d: %s не поддерживает печать филаментом %s"

msgid "Precise outer wall will be ignored unless the order of walls is set to inner/outer"
msgstr "Параметр «Точная внешняя стенка» будет игнорироваться, если порядок стенок не установлен на «внутренняя/внешняя»"

msgid "Generating skirt & brim"
msgstr "Создание юбки и каймы"

msgid "Generating G-code"
msgstr "Генерация G-кода"

msgid "The relative position of the model and the prime tower does not meet the requirements of the \"No sparse layers\" feature. Please adjust their relative positions, lower the model height, or turn off \"No sparse layers\"."
msgstr "Взаимное расположение модели и башни очистки не соответствует требованиям функции \"Без разреженных слоёв\". Измените их взаимное расположение, уменьшите высоту модели или отключите \"Без разреженных слоёв\"."

msgid "Failed processing of the filename_format template."
msgstr "Не удалось обработать шаблон filename_format."

msgid "Printable area"
msgstr "Область печати"

msgid "Extruder printable area"
msgstr "Область печати экструдера"

msgid "Bed exclude area"
msgstr "Запретная зона печатной пластины"

msgid "Unprintable area in XY plane. For example, X1 Series printers use the front left corner to cut filament during filament change. The area is expressed as polygon by points in following format: \"XxY, XxY, ...\""
msgstr "Непечатаемая область в плоскости XY. Например, принтеры серии X1 используют передний левый угол для обрезки филамента при его смене. Область задаётся многоугольником по точкам в следующем формате: \"XxY, XxY, ...\""

msgid "Bed custom texture"
msgstr "Пользовательская текстура печатной пластины"

msgid "Bed custom model"
msgstr "Пользовательская модель печатной пластины"

msgid "Elephant foot compensation"
msgstr "Компенсация эффекта «слоновьей ноги»"

msgid "Shrink the initial layer on build plate to compensate for elephant foot effect"
msgstr "Уменьшает первый слой на печатной пластине для компенсации эффекта «слоновьей ноги»"

msgid "Slicing height for each layer. Smaller layer height means more accurate and more printing time"
msgstr "Высота каждого слоя при нарезке. Меньшая высота слоя повышает точность, но увеличивает время печати"

msgid "Printable height"
msgstr "Доступная высота печати"

msgid "Maximum printable height which is limited by mechanism of printer"
msgstr "Максимальная доступная высота печати, ограниченная конструкцией принтера"

msgid "Extruder printable height"
msgstr "Доступная высота печати экструдера"

msgid "Maximum printable height of this extruder which is limited by mechanism of printer"
msgstr "Максимальная доступная высота печати этого экструдера, ограниченная конструкцией принтера"

msgid "Printer preset names"
msgstr "Названия предустановок принтера"

msgid "Hostname, IP or URL"
msgstr "Имя хоста, IP-адрес или URL"

msgid "Slic3r can upload G-code files to a printer host. This field should contain the hostname, IP address or URL of the printer host instance. Print host behind HAProxy with basic auth enabled can be accessed by putting the user name and password into the URL in the following format: https://username:password@your-octopi-address/"
msgstr "Slic3r может загружать файлы G-кода на хост принтера. В этом поле следует указать имя хоста, IP-адрес или URL хоста принтера. Для доступа к хосту печати за HAProxy с включённой базовой аутентификацией укажите имя пользователя и пароль в URL в следующем формате: https://username:password@your-octopi-address/"

msgid "Device UI"
msgstr "Интерфейс устройства"

msgid "Specify the URL of your device user interface if it's not same as print_host"
msgstr "Укажите URL интерфейса устройства, если он отличается от print_host"

msgid "API Key / Password"
msgstr "Ключ API / пароль"

msgid "Slic3r can upload G-code files to a printer host. This field should contain the API Key or the password required for authentication."
msgstr "Slic3r может загружать файлы G-кода на хост принтера. В этом поле следует указать ключ API или пароль, необходимый для аутентификации."

msgid "Name of the printer"
msgstr "Название принтера"

msgid "HTTPS CA File"
msgstr "Файл CA-сертификата HTTPS"

msgid "Custom CA certificate file can be specified for HTTPS OctoPrint connections, in crt/pem format. If left blank, the default OS CA certificate repository is used."
msgstr "Для HTTPS-подключений к OctoPrint можно указать пользовательский файл CA-сертификата в формате crt/pem. Если оставить поле пустым, будет использоваться системное хранилище CA-сертификатов по умолчанию."

msgid "User"
msgstr "Пользователь"

msgid "Password"
msgstr "Пароль"

msgid "Ignore HTTPS certificate revocation checks"
msgstr "Игнорировать проверку отзыва HTTPS-сертификатов"

msgid "Ignore HTTPS certificate revocation checks in case of missing or offline distribution points. One may want to enable this option for self signed certificates if connection fails."
msgstr "Игнорировать проверку отзыва HTTPS-сертификатов, если точки распространения недоступны или отсутствуют. Если подключение не удаётся, эту опцию можно включить для самоподписанных сертификатов."

msgid "Names of presets related to the physical printer"
msgstr "Названия предустановок, связанных с физическим принтером"

msgid "Authorization Type"
msgstr "Тип авторизации"

msgid "API key"
msgstr "ключ API"

msgid "HTTP digest"
msgstr "Дайджест-аутентификация HTTP"

msgid "Avoid crossing wall"
msgstr "Избегать пересечения стен"

msgid "Detour and avoid traveling across wall which may cause blob on surface (when travel length greater than Travel distance threshold)"
msgstr "Использует обходной маршрут и избегает перемещений через стенки, которые могут вызвать наплывы на поверхности (если длина перемещения превышает порог расстояния перемещения)"

msgid "Smoothing wall speed along Z(experimental)"
msgstr "Сглаживание скорости стенок по оси Z (экспериментально)"

msgid "Smoothing outwall speed in z direction to get better surface quality. Print time will increases. This does not work on spiral vase mode."
msgstr "Сглаживает скорость внешней стенки по оси Z для улучшения качества поверхности. Время печати увеличится. Не работает в режиме «Спиральная ваза»."

msgid "Avoid crossing wall - Max detour length"
msgstr "Избегать пересечения стен — максимальная длина обхода"

msgid "Maximum detour distance for avoiding crossing wall. Don't detour if the detour distance is larger than this value. Detour length could be specified either as an absolute value or as percentage (for example 50%) of a direct travel path. Zero to disable"
msgstr "Максимальная длина обхода для предотвращения пересечения стен. Не выполнять обход, если его длина превышает это значение. Длина обхода может задаваться абсолютным значением или в процентах (например, 50%) от длины прямого перемещения. 0 — отключить"

msgid "mm or %"
msgstr "мм или %"

msgid "Avoid crossing wall - Includes support"
msgstr "Избегать пересечения стен — включая поддержку"

msgid "Including support while avoiding crossing wall."
msgstr "Учитывать поддержку при избегании пересечения стен."

msgid "Other layers"
msgstr "Остальные слои"

msgid "Bed temperature for layers except the initial one. Value 0 means the filament does not support to print on the Cool Plate"
msgstr "Температура плиты для всех слоёв, кроме первого. Значение 0 означает, что этот филамент не поддерживает печать на холодной пластине."

msgid "Bed temperature for layers except the initial one. Value 0 means the filament does not support to print on the Engineering Plate"
msgstr "Температура плиты для всех слоёв, кроме первого. Значение 0 означает, что этот филамент не поддерживает печать на инженерной пластине."

msgid "Bed temperature for layers except the initial one. Value 0 means the filament does not support to print on the High Temp Plate"
msgstr "Температура плиты для всех слоёв, кроме первого. Значение 0 означает, что этот филамент не поддерживает печать на высокотемпературной пластине"

msgid "Bed temperature for layers except the initial one. Value 0 means the filament does not support to print on the Textured PEI Plate"
msgstr "Температура плиты для всех слоёв, кроме первого. Значение 0 означает, что этот филамент не поддерживает печать на текстурированной PEI пластине."

msgid "Initial layer"
msgstr "Первый слой"

msgid "Initial layer bed temperature"
msgstr "Температура плиты для первого слоя"

msgid "Bed temperature of the initial layer. Value 0 means the filament does not support to print on the Bambu Cool Plate SuperTack"
msgstr "Температура плиты для первого слоя. Значение 0 означает, что этот филамент не поддерживает печать на холодной пластине Bambu SuperTack."

msgid "Bed temperature of the initial layer. Value 0 means the filament does not support to print on the Cool Plate"
msgstr "Температура плиты для первого слоя. Значение 0 означает, что этот филамент не поддерживает печать на холодной пластине."

msgid "Bed temperature of the initial layer. Value 0 means the filament does not support to print on the Engineering Plate"
msgstr "Температура плиты для первого слоя. Значение 0 означает, что этот филамент не поддерживает печать на инженерной пластине."

msgid "Bed temperature of the initial layer. Value 0 means the filament does not support to print on the High Temp Plate"
msgstr "Температура плиты для первого слоя. Значение 0 означает, что этот филамент не поддерживает печать на высокотемпературной пластине"

msgid "Bed temperature of the initial layer. Value 0 means the filament does not support to print on the Textured PEI Plate"
msgstr "Температура плиты для первого слоя. Значение 0 означает, что этот филамент не поддерживает печать на текстурированной PEI пластине."

msgid "Bed types supported by the printer"
msgstr "Типы печатных пластин, поддерживаемые принтером"

msgid "First layer print sequence"
msgstr "Последовательность печати первого слоя"

msgid "Other layers print sequence"
msgstr "Последовательность печати остальных слоёв"

# ??? Количество слоёв при последовательной печати остальных слоёв, Количество других слоёв в последовательной печати
msgid "The number of other layers print sequence"
msgstr "Количество слоёв в последовательности печати остальных слоёв"

msgid "Other layers filament sequence"
msgstr "Последовательность филаментов на остальных слоях"

msgid "This G-code is inserted at every layer change before lifting z"
msgstr "Этот G-код вставляется при каждой смене слоя перед подъёмом оси Z"

msgid "Bottom shell layers"
msgstr "Слои нижней оболочки"

msgid "This is the number of solid layers of bottom shell, including the bottom surface layer. When the thickness calculated by this value is thinner than bottom shell thickness, the bottom shell layers will be increased"
msgstr "Количество сплошных слоёв нижней оболочки, включая слой нижней поверхности. Если рассчитанная по этому значению толщина меньше заданной толщины нижней оболочки, количество слоёв нижней оболочки будет увеличено"

msgid "Bottom shell thickness"
msgstr "Толщина нижней оболочки"

msgid "The number of bottom solid layers is increased when slicing if the thickness calculated by bottom shells layers is thinner than this value. This can avoid having too thin shell when layer height is small. 0 means that this setting is disabled and thickness of bottom shell is absolutely determained by bottom shell layers"
msgstr "При нарезке количество нижних сплошных слоёв увеличивается, если толщина, рассчитанная по количеству слоёв нижней оболочки, меньше этого значения. Это позволяет избежать слишком тонкой оболочки при малой высоте слоя. Значение 0 означает, что этот параметр отключён, а толщина нижней оболочки полностью определяется количеством слоёв нижней оболочки."

msgid "Force cooling for overhang and bridge"
msgstr "Принудительное охлаждение нависающих элементов и мостов"

msgid "Enable this option to optimize part cooling fan speed for overhang and bridge to get better cooling"
msgstr "Включите эту опцию, чтобы оптимизировать скорость вентилятора обдува модели при печати нависающих элементов и мостов и улучшить охлаждение."

msgid "Fan speed for overhang"
msgstr "Скорость вентилятора для нависающих элементов"

msgid "Force part cooling fan to be at this speed when printing bridge or overhang wall which has large overhang degree. Forcing cooling for overhang and bridge can get better quality for these part"
msgstr "При печати мостов или стенок с большой степенью нависания вентилятор обдува модели принудительно работает на этой скорости. Принудительное охлаждение нависающих элементов и мостов позволяет повысить качество этих участков."

msgid "Ironing fan speed"
msgstr "Скорость вентилятора при разглаживании"

msgid "This part cooling fan speed is applied when ironing. Setting this parameter to a lower than regular speed reduces possible nozzle clogging due to the low volumetric flow rate, making the interface smoother. Set to -1 to disable it."
msgstr "Эта скорость вентилятора обдува модели применяется при разглаживании. Установка значения ниже обычной скорости снижает риск закупорки сопла при низком объёмном потоке и делает разглаживаемую поверхность более гладкой. Установите -1, чтобы отключить эту функцию."

msgid "Pre start fan time"
msgstr "Время предварительного запуска вентилятора"

# ??? Запуск вентилятора раньше на заданное количество секунд при печати нависающих участков.
msgid "Force fan start early(0-5 second) when encountering overhangs. This is because the fan needs time to physically increase its speed."
msgstr "При обнаружении нависающих элементов принудительно запускать вентилятор заранее (за 0–5 секунд). Это связано с тем, что вентилятору требуется время, чтобы набрать скорость."

msgid "s"
msgstr "с"

msgid "Cooling overhang threshold"
msgstr "Порог нависания для принудительного охлаждения"

#, fuzzy, no-c-format, no-boost-format
msgid "Force cooling fan to be specific speed when overhang degree of printed part exceeds this value. Expressed as percentage which indicides how much width of the line without support from lower layer. 0% means forcing cooling for all outer wall no matter how much overhang degree"
msgstr "Если степень нависания печатаемого участка превышает это значение, вентилятор охлаждения принудительно работает с заданной скоростью. Выражается в процентах и показывает, какая доля ширины линии не имеет опоры на нижнем слое. 0% означает принудительное охлаждение всех внешних стенок независимо от степени нависания"

msgid "Overhang threshold for participating cooling"
msgstr "Порог нависания для включения охлаждения"

#, fuzzy, no-c-format, no-boost-format
msgid "Decide which overhang part join the cooling function to slow down the speed.Expressed as percentage which indicides how much width of the line without support from lower layer. 100% means forcing cooling for all outer wall no matter how much overhang degree"
msgstr "Определяет, какие нависающие участки участвуют в функции охлаждения с замедлением печати. Значение выражается в процентах и показывает, какая доля ширины линии не имеет опоры на нижнем слое. 100% означает принудительное охлаждение всех внешних стенок независимо от степени нависания"

msgid "Bridge direction"
msgstr "Направление мостов"

msgid "Bridging angle override. If left to zero, the bridging angle will be calculated automatically. Otherwise the provided angle will be used for external bridges. Use 180°for zero angle."
msgstr "Переопределение угла мостов. Если оставить значение равным 0, угол мостов будет рассчитан автоматически. В противном случае для внешних мостов будет использоваться заданный угол. Для нулевого угла используйте 180°."

msgid "Bridge flow"
msgstr "Поток мостов"

msgid "Decrease this value slightly(for example 0.9) to reduce the amount of material for bridge, to improve sag"
msgstr "Немного уменьшите это значение (например, до 0,9), чтобы снизить расход материала на мостах и уменьшить провисание."

msgid "Bridge counterbore holes"
msgstr "Мосты для цекованных отверстий"

msgid ""
"This option creates bridges for counterbore holes, allowing them to be printed without support. Available modes include:\n"
"1. None: No bridge is created\n"
"2. Partially Bridged: Only a part of the unsupported area will be bridged\n"
"3. Sacrificial Layer: A full sacrificial bridge layer is created"
msgstr ""
"Этот параметр создаёт мосты для цекованных отверстий, позволяя печатать их без поддержки. Доступны следующие режимы:\n"
"1. Нет: Мост не создаётся\n"
"2. Частичное перекрытие: Мостом перекрывается только часть неподдерживаемой области\n"
"3. Жертвенный слой: Создаётся полный жертвенный мостовой слой"

msgid "Partially bridged"
msgstr "Частичное перекрытие"

msgid "Sacrificial layer"
msgstr "Жертвенный слой"

msgid "Top surface flow ratio"
msgstr "Коэффициент потока для верхней поверхности"

msgid "This factor affects the amount of material for top solid infill. You can decrease it slightly to have smooth surface finish"
msgstr "Этот коэффициент влияет на количество материала для верхнего сплошного заполнения. Его можно немного уменьшить, чтобы получить более гладкую поверхность"

msgid "Initial layer flow ratio"
msgstr "Коэффициент потока первого слоя"

msgid "This factor affects the amount of material for the initial layer"
msgstr "Этот коэффициент влияет на количество материала для первого слоя"

msgid "Only one wall on top surfaces"
msgstr "Только одна стенка на верхних поверхностях"

msgid "Use only one wall on flat top surface, to give more space to the top infill pattern. Could be applied on topmost surface or all top surface."
msgstr "Использовать только одну стенку на плоской верхней поверхности, чтобы оставить больше места для рисунка верхнего заполнения. Можно применять только к самой верхней поверхности или ко всем верхним поверхностям."

msgid "Not apply"
msgstr "Не применять"

msgid "Top surfaces"
msgstr "Верхние поверхности"

msgid "Topmost surface"
msgstr "Самая верхняя поверхность"

# ???
msgid "Top area threshold"
msgstr "Порог площади верхней области"

# ??? Минимальная ширина верхних областей в процентах от ширины линии периметра.
msgid "The min width of top areas in percentage of perimeter line width."
msgstr "Минимальная ширина верхних областей в процентах от ширины линии периметра."

msgid "Only one wall on first layer"
msgstr "Только одна стенка на первом слое"

msgid "Use only one wall on the first layer of model"
msgstr "Использовать только одну стенку на первом слое модели"

msgid "Slow down for overhang"
msgstr "Замедление для нависающих элементов"

msgid "Enable this option to slow printing down for different overhang degree"
msgstr "Включите эту опцию, чтобы снижать скорость печати в зависимости от степени нависания"

msgid "mm/s"
msgstr "мм/с"

#, fuzzy, no-c-format, no-boost-format
msgid "Speed of 100% overhang wall which has 0 overlap with the lower layer."
msgstr "Скорость стенки со 100% нависанием и 0 перекрытия с нижним слоем."

msgid "Slow down by height"
msgstr "Замедление по высоте"

msgid "Enable this option to slow printing down by height"
msgstr "Включите эту опцию, чтобы снижать скорость печати в зависимости от высоты"

msgid "Starting height"
msgstr "Начальная высота"

msgid "The height starts to slow down"
msgstr "Высота, с которой начинается замедление"

msgid "Speed at starting height"
msgstr "Скорость на начальной высоте"

msgid "Acceleration at starting height"
msgstr "Ускорение на начальной высоте"

msgid "mm/s²"
msgstr "мм/с²"

msgid "Ending height"
msgstr "Конечная высота"

msgid "The height finishes slowing down, Ending height should be larger than Starting height, or the slowing down will not work!"
msgstr "Высота, на которой заканчивается замедление. Конечная высота должна быть больше начальной, иначе замедление работать не будет!"

msgid "Speed at ending height"
msgstr "Скорость на конечной высоте"

msgid "Acceleration at ending height"
msgstr "Ускорение на конечной высоте"

msgid "Speed of bridge and completely overhang wall"
msgstr "Скорость мостов и полностью нависающих стенок"

msgid "Brim width"
msgstr "Ширина каймы"

msgid "Distance from model to the outermost brim line"
msgstr "Расстояние от модели до самой внешней линии каймы"

msgid "Brim type"
msgstr "Тип каймы"

msgid "This controls the generation of the brim at outer and/or inner side of models. Auto means the brim width is analysed and calculated automatically."
msgstr "Определяет создание каймы с внешней и/или внутренней стороны моделей. В режиме «Авто» ширина каймы анализируется и рассчитывается автоматически."

msgid "Brim-object gap"
msgstr "Зазор между каймой и объектом"

msgid "A gap between innermost brim line and object can make brim be removed more easily"
msgstr "Зазор между самой внутренней линией каймы и объектом облегчает удаление каймы"

msgid "Compatible machine"
msgstr "Совместимый принтер"

msgid "upward compatible machine"
msgstr "с восходящей совместимостью"

msgid "Compatible machine condition"
msgstr "Условие совместимости принтера"

msgid "Compatible process profiles"
msgstr "Совместимые профили процесса"

msgid "Compatible process profiles condition"
msgstr "Условие совместимости профилей процесса"

msgid "Print sequence, layer by layer or object by object"
msgstr "Последовательность печати: по слоям или по объектам"

msgid "By layer"
msgstr "По слоям"

msgid "By object"
msgstr "По объектам"

msgid "Slow printing down for better layer cooling"
msgstr "Замедление печати для улучшения охлаждения слоя"

msgid "Enable this option to slow printing speed down to make the final layer time not shorter than the layer time threshold in \"Max fan speed threshold\", so that layer can be cooled for a longer time. This can improve the cooling quality for needle and small details"
msgstr "Включите эту опцию, чтобы снизить скорость печати и не допустить, чтобы фактическое время слоя было меньше порога, заданного в параметре «Порог максимальной скорости вентилятора». Это увеличит время охлаждения слоя. Это улучшает охлаждение тонких выступающих элементов и мелких деталей"

msgid "Don't slow down outer walls"
msgstr "Не замедлять внешние стенки"

msgid ""
"If enabled, this setting will ensure external perimeters are not slowed down to meet the minimum layer time. This is particularly helpful in the below scenarios:\n"
"1. To avoid changes in shine when printing glossy filaments\n"
"2. To avoid changes in external wall speed which may create slight wall artifacts that appear like Z banding\n"
"3. To avoid printing at speeds which cause VFAs (fine artifacts) on the external walls"
msgstr ""
"Если параметр включён, внешние периметры не будут замедляться для соблюдения минимального времени слоя. Это особенно полезно в следующих случаях:\n"
"1. Чтобы избежать изменения блеска при печати глянцевыми филаментами\n"
"2 Чтобы избежать изменения скорости внешних стенок, которое может вызывать небольшие дефекты стенок, похожие на Z-полосы\n"
"3 Чтобы избежать скоростей печати, вызывающих VFA (мелкие артефакты) на внешних стенках"

msgid "Cooling slowdown logic"
msgstr "Логика замедления для охлаждения"

msgid ""
"Determines how the printer slows down when minimum layer time isn't reached.\n"
"\n"
"'Uniform cooling' slows down all print features equally (current default behavior).\n"
"\n"
"'Consistent surface' prioritizes slowing infill and internal perimeters first, preserving external perimeter speed for better surface finish on glossy filaments. This helps reduce VFA (Vertical Fine Artifacts) and maintains consistent surface shine."
msgstr ""
"Определяет, как принтер снижает скорость, если минимальное время слоя не достигнуто.\n"
"\n"
"«Равномерное охлаждение» одинаково замедляет все элементы печати (текущее поведение по умолчанию).\n"
"\n"
"«Однородная поверхность» в первую очередь замедляет заполнение и внутренние периметры, сохраняя скорость внешних периметров для более качественной поверхности при печати глянцевыми филаментами. Это помогает уменьшить VFA (вертикальные мелкие артефакты) и сохранить равномерный блеск поверхности."

msgid "Uniform cooling"
msgstr "Равномерное охлаждение"

msgid "Consistent surface"
msgstr "Однородная поверхность"

msgid "Perimeter transition distance"
msgstr "Расстояние перехода периметра"

msgid ""
"Distance in millimeters before the end of slowed perimeters where the original print speed is gradually restored. This reduces quality issues when transitioning from slowed features to fast external perimeter printing.\n"
"\n"
"Only applies when 'Consistent surface' cooling logic is selected.\n"
"Recommended value: 5-10mm. Set to 0 to disable."
msgstr ""
"Расстояние в миллиметрах перед концом замедленного периметра, на котором исходная скорость печати постепенно восстанавливается. Это уменьшает дефекты качества при переходе от замедленных элементов к быстрой печати внешнего периметра.\n"
"\n"
"Применяется только при выборе логики охлаждения «Однородная поверхность».\n"
"Рекомендуемое значение: 5–10 мм. Установите 0, чтобы отключить."

msgid "Normal printing"
msgstr "Обычная печать"

msgid "The default acceleration of both normal printing and travel except initial layer"
msgstr "Ускорение по умолчанию для обычной печати и перемещений, кроме первого слоя"

msgid "The acceleration of travel except initial layer"
msgstr "Ускорение перемещений, кроме первого слоя"

msgid "Short travel"
msgstr "Короткое перемещение"

msgid ""
"Acceleration used for short travel moves near external perimeters. Short travels are moves shorter than the 'Retraction minimum travel' distance.\n"
"\n"
"Lower values (e.g., 250-500 mm/s²) reduce ringing artifacts on sharp corners without significantly impacting print time.\n"
"\n"
"Set to 0 to disable (uses normal travel acceleration)."
msgstr ""
"Ускорение для коротких перемещений рядом с внешними периметрами. Короткими считаются перемещения короче значения «Минимальное перемещение для ретракции».\n"
"\n"
"Более низкие значения (например, 250–500 мм/с²) уменьшают звон на острых углах, почти не увеличивая время печати.\n"
"\n"
"Установите 0, чтобы отключить (будет использоваться обычное ускорение перемещения)."

msgid "Initial layer travel"
msgstr "Перемещения первого слоя"

msgid "The acceleration of travel of initial layer"
msgstr "Ускорение перемещений первого слоя"

msgid "Default filament profile"
msgstr "Профиль филамента по умолчанию"

msgid "Default filament profile when switch to this machine profile"
msgstr "Профиль филамента по умолчанию при переключении на этот профиль принтера"

msgid "Default process profile"
msgstr "Профиль процесса по умолчанию"

msgid "Default process profile when switch to this machine profile"
msgstr "Профиль процесса по умолчанию при переключении на этот профиль принтера"

msgid "Activate air filtration"
msgstr "Включить фильтрацию воздуха"

msgid "Activate for better air filtration"
msgstr "Включите для более эффективной фильтрации воздуха."

msgid "Fan speed"
msgstr "Скорость вентилятора"

msgid "Speed of exhaust fan during printing.This speed will overwrite the speed in filament custom gcode"
msgstr "Скорость вентилятора вытяжки во время печати. Это значение переопределяет скорость, заданную в пользовательском G-коде филамента."

msgid "Speed of exhuast fan after printing completes"
msgstr "Скорость вентилятора вытяжки после завершения печати"

msgid "For the first"
msgstr "Для первых"

msgid "Set special auxiliary cooling fan for the first certain layers."
msgstr "Задать специальную скорость вспомогательного вентилятора охлаждения для первых нескольких слоёв."

msgid "Full fan speed at layer"
msgstr "Слой выхода вентилятора на полную скорость"

msgid "Auxiliary fan speed will be ramped up linearly from layer \"For the first\" to maximum at layer \"Full fan speed at layer\". \"Full fan speed at layer\" will be ignored if lower than \"For the first\", in which case the fan will be running at maximum allowed speed at layer \"For the first\" + 1."
msgstr "Скорость вспомогательного вентилятора будет линейно увеличиваться от слоя «Для первых» до максимума на слое «Полная скорость вентилятора на слое». Параметр «Полная скорость вентилятора на слое» будет проигнорирован, если его значение меньше «Для первых»; в этом случае вентилятор будет работать с максимально допустимой скоростью начиная со слоя «Для первых» + 1."

msgid "Set special cooling fan for the first certain layers.The part cooling fan of the first layer used to be closed to get better build plate adhesion and used for auto cooling function"
msgstr "Задать специальную скорость вентилятора обдува модели для первых нескольких слоёв. Вентилятор первого слоя обычно отключён для улучшения адгезии к печатной пластине и используется функцией автоматического охлаждения."

msgid "Part cooling fan speed for the first few layers. Set to 0 to disable the part cooling fan on the initial layers for better bed adhesion"
msgstr "Скорость вентилятора обдува модели для первых нескольких слоёв. Установите 0, чтобы отключить вентилятор обдува модели на первых слоях для лучшей адгезии к печатной пластине"

msgid "Special auxiliary cooling fan speed, effective only for the first x layers"
msgstr "Специальная скорость вспомогательного вентилятора охлаждения, действующая только для первых x слоёв"

msgid "Don't support bridges"
msgstr "Не создавать поддержки под мостами"

msgid "Don't support the whole bridge area which makes support very large. Bridge usually can be printing directly without support if not very long"
msgstr "Не создавать поддержку под всей областью моста, поскольку это значительно увеличивает объём поддержки. Обычно не слишком длинные мосты можно печатать без поддержки"

msgid "Thick bridges"
msgstr "Толстые мосты"

msgid "If enabled, bridges are more reliable, can bridge longer distances, but may look worse. If disabled, bridges look better but are reliable just for shorter bridged distances."
msgstr "Если эта функция включена, мосты становятся надёжнее и могут перекрывать большие расстояния, но качество поверхности может ухудшиться. Если эта функция отключена, мосты выглядят лучше, но надёжны только на небольших расстояниях."

msgid "Max bridge length"
msgstr "Максимальная длина моста"

msgid "Max length of bridges that don't need support. Set it to 0 if you want all bridges to be supported, and set it to a very large value if you don't want any bridges to be supported."
msgstr "Максимальная длина мостов, не требующих поддержки. Установите значение 0, если хотите создавать поддержку для всех мостов, или задайте очень большое значение, если поддержка для мостов не нужна."

msgid "End G-code"
msgstr "Завершающий G-код"

msgid "End G-code when finish the whole printing"
msgstr "Завершающий G-код, выполняемый после завершения всей печати"

msgid "Between Object Gcode"
msgstr "G-код между объектами"

msgid "Insert Gcode between objects. This parameter will only come into effect when you print your models object by object"
msgstr "Вставлять G-код между объектами. Этот параметр действует только при печати моделей по объектам."

msgid "End G-code when finish the printing of this filament"
msgstr "Завершающий G-код после завершения печати этим филаментом"

# ??? Контроль толщины вертикальной оболочки
msgid "Ensure vertical shell thickness"
msgstr "Обеспечить толщину вертикальной оболочки"

msgid "Add solid infill near sloping surfaces to guarantee the vertical shell thickness (top+bottom solid layers)"
msgstr "Добавлять сплошное заполнение рядом с наклонными поверхностями для обеспечения толщины вертикальной оболочки (верхние + нижние сплошные слои)"

msgid "Disabled"
msgstr "Отключено"

msgid "Partial"
msgstr "Частично"

msgid "Enabled"
msgstr "Включено"

msgid "Vertical shell speed"
msgstr "Скорость вертикальной оболочки"

# ??? вертикальные внешние стенки
msgid "Speed for vertical shells with overhang regions. If expressed as percentage (for example: 80%) it will be calculated onthe internal solid infill speed above"
msgstr "Скорость вертикальных оболочек на нависающих участках. Если значение задано в процентах (например: 80%), оно рассчитывается на основе указанной выше скорости внутреннего сплошного заполнения."

msgid "mm/s or %"
msgstr "мм/с или %"

# ?????55 Обнаружение плавающих участков в верт. оболочках,  нависающих, Обнаружение плавающих вертикальных стенок
msgid "Detect floating vertical shells"
msgstr "Обнаруживать нависающие вертикальные оболочки"

# ?????55
# Обнаруживать участки вертикальных стенок, которые печатаются в воздухе (без опоры снизу), и замедляет их печать до скорости мостов. Это нужно, чтобы материал не провисал и сложные участки получались аккуратными.
# Обнаружение нависающих участков в вертикальных стенках и замедление их печати до скорости мостов.
msgid "Detect overhang paths in vertical shells and slow them by bridge speed."
msgstr "Обнаруживать нависающие траектории в вертикальных оболочках и снижать их скорость до скорости мостов."

msgid "Internal bridge support thickness"
msgstr "Толщина поддержки внутреннего моста"

msgid "When sparse infill density is low, the internal solid infill or internal bridge may have no archor at the end of line. This causes falling and bad quality when printing internal solid infill. When enable this feature, loop paths will be added to the sparse fill of the lower layers for specific thickness, so that better archor can be provided for internal bridge. 0 means disable this feature"
msgstr "При низкой плотности разреженного заполнения внутреннее сплошное заполнение или внутренний мост могут не иметь точки опоры на конце линии. Это может привести к провисанию и ухудшению качества внутреннего сплошного заполнения. При включении этой функции в разреженное заполнение нижних слоёв на заданной толщине добавляются замкнутые траектории, обеспечивающие лучшую опору для внутреннего моста. 0 означает, что функция отключена"

msgid "Top surface pattern"
msgstr "Рисунок верхней поверхности"

msgid "Line pattern of top surface infill"
msgstr "Рисунок линий заполнения верхней поверхности"

msgid "Concentric"
msgstr "Концентрический"

msgid "Rectilinear"
msgstr "Прямолинейный"

msgid "Monotonic"
msgstr "Монотонный"

msgid "Monotonic line"
msgstr "Монотонные линии"

msgid "Global monotonic line"
msgstr ""

msgid "Aligned Rectilinear"
msgstr "Выровненный прямолинейный"

msgid "Hilbert Curve"
msgstr "Кривая Гильберта"

msgid "Archimedean Chords"
msgstr "Архимедовы хорды"

msgid "Octagram Spiral"
msgstr "Октаграммная спираль"

msgid "Top surface density"
msgstr "Плотность верхней поверхности"

msgid "Density of top surface infill, 100% means a fully solid filled top layer.Lower values create a textured top surface, at 0%, only the walls are created on the top layer.Intended for aesthetic or functional purposes, not to fix issues such as over-extrusion."
msgstr "Плотность заполнения верхней поверхности: 100% означает полностью сплошной верхний слой. Более низкие значения создают текстурированную верхнюю поверхность; при 0% на верхнем слое создаются только стенки. Параметр предназначен для эстетических или функциональных целей, а не для устранения таких проблем, как чрезмерная экструзия."

msgid "Monotonic line travel extend"
msgstr "Увеличение перемещения монотонных линий"

msgid "Enable this option to extend the travel distance between lines, improving the adhesion between the monotonic line infill and the walls.(percent to line width)"
msgstr "Включите этот параметр, чтобы увеличить расстояние перемещения между линиями и улучшить сцепление монотонного линейного заполнения со стенками. (В процентах от ширины линии)"

msgid "Bottom surface pattern"
msgstr "Рисунок нижней поверхности"

msgid "Line pattern of bottom surface infill, not bridge infill"
msgstr "Рисунок линий заполнения нижней поверхности, не относящийся к заполнению мостов"

msgid "Bottom surface density"
msgstr "Плотность нижней поверхности"

#, no-c-format, no-boost-format
msgid "Density of bottom surface infill, 100% means a fully solid filled top layer.Lower values create a textured bottom surface, Intended for aesthetic or functional purposes, not to fix issues such as over-extrusion.WARNING: Lowering this value may negatively affect bed adhesion."
msgstr "Плотность заполнения нижней поверхности: 100% означает полностью сплошной нижний слой. Меньшие значения создают текстурированную нижнюю поверхность. Предназначено для эстетических или функциональных целей, а не для исправления таких проблем, как чрезмерная экструзия. ВНИМАНИЕ: Снижение этого значения может отрицательно сказаться на адгезии к столу."

msgid "Internal solid infill pattern"
msgstr "Рисунок внутреннего сплошного заполнения"

msgid "Line pattern of internal solid infill. if the detect narrow internal solid infill be enabled, the concentric pattern will be used for the small area."
msgstr "Рисунок линий внутреннего сплошного заполнения. Если включено обнаружение узких участков внутреннего сплошного заполнения, для небольших областей используется концентрический рисунок."

msgid "Sub-top surface pattern"
msgstr "Рисунок под верхней поверхностью"

msgid "Line pattern of the solid layer that supports a visible top surface. Its lines can print through and mark the top, so a monotonic pattern gives the smoothest result. The whole solid area that a top surface reaches uses this pattern, not only the part directly beneath it."
msgstr ""

msgid "Line width of outer wall"
msgstr "Ширина линии внешней стенки"

msgid "Speed of outer wall which is outermost and visible. It's used to be slower than inner wall speed to get better quality."
msgstr "Скорость внешней стенки — самого наружного и видимого контура модели. Обычно она ниже скорости внутренней стенки для повышения качества печати."

msgid "Small perimeters"
msgstr "Малые периметры"

msgid "This setting will affect the speed of perimeters having radius <= small perimeter threshold(usually holes). If expressed as percentage (for example: 80%) it will be calculated onthe outer wall speed setting above. Set to zero for auto."
msgstr "Этот параметр влияет на скорость периметров с радиусом <= порога малого периметра (обычно это отверстия). Если значение задано в процентах (например: 80%) значение будет рассчитано на основе указанной выше скорости внешней стенки. Установите 0 для автоматического режима."

msgid "Small perimeter threshold"
msgstr "Порог малого периметра"

msgid "This sets the threshold for small perimeter length. Default threshold is 0mm"
msgstr "Задаёт порог длины малого периметра. Порог по умолчанию — 0 мм"

msgid "Order of walls"
msgstr "Порядок печати стенок"

msgid "Print sequence of inner wall and outer wall. "
msgstr "Последовательность печати внутренних и внешних стенок. "

msgid "inner/outer"
msgstr "внутренняя/внешняя"

msgid "outer/inner"
msgstr "внешняя/внутренняя"

msgid "inner wall/outer wall/inner wall"
msgstr "внутренняя стенка/внешняя стенка/внутренняя стенка"

msgid "Print infill first"
msgstr "Сначала печатать заполнение"

msgid "Order of wall/infill. false means print wall first. "
msgstr "Порядок печати стенок/заполнения. false означает, что сначала печатаются стенки. "

msgid "Height to rod"
msgstr "Высота до направляющей"

msgid "Distance of the nozzle tip to the lower rod. Used for collision avoidance in by-object printing."
msgstr "Расстояние от кончика сопла до нижней направляющей. Используется для предотвращения столкновений при печати по объектам."

msgid "Height to lid"
msgstr "Высота до крышки"

msgid "Distance of the nozzle tip to the lid. Used for collision avoidance in by-object printing."
msgstr "Расстояние от кончика сопла до крышки. Используется для предотвращения столкновений при печати по объектам."

msgid "Distance to rod"
msgstr "Расстояние до направляющей"

msgid "Horizontal distance of the nozzle tip to the rod's farther edge. Used for collision avoidance in by-object printing."
msgstr "Горизонтальное расстояние от кончика сопла до дальнего края направляющей. Используется для предотвращения столкновений при печати по объектам."

msgid "Nozzle height"
msgstr "Высота сопла"

msgid "The height of nozzle tip."
msgstr "Высота кончика сопла."

msgid "Max Radius"
msgstr "Максимальный радиус"

msgid "Max clearance radius around extruder. Used for collision avoidance in by-object printing."
msgstr "Максимальный радиус безопасной зоны вокруг экструдера. Используется для предотвращения столкновений при печати по объектам."

msgid "Grab length"
msgstr "Длина захвата"

msgid "Extruder Color"
msgstr "Цвет экструдера"

msgid "Only used as a visual help on UI"
msgstr "Используется только для визуального обозначения в интерфейсе."

msgid "Extruder offset"
msgstr "Смещение экструдера"

# ???
msgid "Flow ratio"
msgstr "Коэффициент потока"

msgid "The material may have volumetric change after switching between molten state and crystalline state. This setting changes all extrusion flow of this filament in gcode proportionally. Recommended value range is between 0.95 and 1.05. Maybe you can tune this value to get nice flat surface when there has slight overflow or underflow"
msgstr "При переходе между расплавленным и кристаллическим состояниями объём материала может изменяться. Этот параметр пропорционально изменяет весь поток экструзии этого филамента в G-коде. Рекомендуемый диапазон значений — от 0,95 до 1,05. Это значение можно подстроить для получения ровной поверхности при небольшой чрезмерной или недостаточной экструзии."

msgid "Object flow ratio"
msgstr "Коэффициент потока объекта"

msgid "The flow ratio set by object, the meaning is the same as flow ratio."
msgstr "Коэффициент потока, задаваемый для объекта; значение параметра такое же, как у «Коэффициента потока»."

msgid "Enable pressure advance"
msgstr "Включить компенсацию давления"

msgid "Enable pressure advance, auto calibration result will be overwritten once enabled. Useless for Bambu Printer"
msgstr "Включить компенсацию давления; после включения результат автоматической калибровки будет перезаписан. Не используется на принтерах Bambu"

msgid "Pressure advance(Klipper) AKA Linear advance factor(Marlin). Useless for Bambu Printer"
msgstr "Компенсация давления (Klipper), также известная как коэффициент Linear Advance (Marlin). Не используется на принтерах Bambu"

msgid "Filament notes"
msgstr "Примечания к филаменту"

msgid "You can put your notes regarding the filament here."
msgstr "Здесь можно добавить примечания к филаменту."

msgid "Process notes"
msgstr "Примечания к процессу"

msgid "You can put your notes regarding the process here."
msgstr "Здесь можно добавить примечания к процессу."

msgid "Printer notes"
msgstr "Примечания к принтеру"

msgid "You can put your notes regarding the printer here."
msgstr "Здесь можно добавить примечания к принтеру."

msgid "Default line width if some line width is set to be zero"
msgstr "Ширина линии по умолчанию, если для какой-либо ширины линии задано значение 0"

msgid "Keep fan always on"
msgstr "Не отключать вентилятор"

msgid "If enable this setting, part cooling fan will never be stopped and will run at least at minimum speed to reduce the frequency of starting and stopping"
msgstr "Если включить этот параметр, вентилятор обдува модели не будет останавливаться и будет работать как минимум на минимальной скорости, что уменьшит частоту его включения и выключения."

msgid "Layer time"
msgstr "Время слоя"

msgid "Part cooling fan will be enabled for layers of which estimated time is shorter than this value. Fan speed is interpolated between the minimum and maximum fan speeds according to layer printing time"
msgstr "Вентилятор обдува модели включается для слоёв, расчётное время которых меньше этого значения. Скорость вентилятора интерполируется между минимальным и максимальным значениями в зависимости от времени печати слоя."

msgid "Default color"
msgstr "Цвет по умолчанию"

msgid "Default filament color"
msgstr "Цвет филамента по умолчанию"

msgid "Required nozzle HRC"
msgstr "Требуемая твёрдость сопла по HRC"

msgid "Minimum HRC of nozzle required to print the filament. Zero means no checking of nozzle's HRC."
msgstr "Минимальная твёрдость сопла по HRC, необходимая для печати этим филаментом. 0 означает, что твёрдость сопла по HRC не проверяется."

# ????? Соответствие материала с экструдером
msgid "Filament map to extruder"
msgstr "Сопоставление филамента с экструдером"

# ???
msgid "filament mapping mode"
msgstr "Режим сопоставления филаментов"

# ??? Автоочистка от старого материала
msgid "Auto For Flush"
msgstr "Автоматически для очистки"

# ???? где это, о чем речь? Автоподбор материалов, Автоподбор настроек
msgid "Auto For Match"
msgstr "Автоматически для сопоставления"

msgid "Manual"
msgstr "Вручную"

msgid "Nozzle Manual"
msgstr ""

msgid "Flush temperature"
msgstr "Температура очистки"

msgid "temperature when flushing filament. 0 indicates the upper bound of the recommended nozzle temperature range"
msgstr "Температура при очистке филамента. 0 означает верхнюю границу рекомендуемого диапазона температуры сопла."

msgid "Flush temperature used in fast purge mode."
msgstr "Температура очистки, используемая в режиме быстрого сброса."

msgid "Flush volumetric speed"
msgstr "Объёмная скорость очистки"

msgid "Volumetric speed when flushing filament. 0 indicates the max volumetric speed"
msgstr "Объёмная скорость при очистке филамента. 0 означает максимальную объёмную скорость"

msgid "mm³/s"
msgstr "мм³/с"

msgid "This setting stands for how much volume of filament can be melted and extruded per second. Printing speed is limited by max volumetric speed, in case of too high and unreasonable speed setting. Can't be zero"
msgstr "Этот параметр определяет объём филамента, который может быть расплавлен и экструдирован за секунду. Максимальная объёмная скорость ограничивает скорость печати, предотвращая чрезмерно высокие и необоснованные значения скорости. Не может быть равно 0"

msgid "Extruder change"
msgstr "Смена экструдера"

msgid "The maximum volumetric speed for ramming before extruder change, where -1 means using the maximum volumetric speed."
msgstr "Максимальная объемная скорость продавливания перед сменой экструдера; -1 означает использование максимальной объемной скорости."

msgid "Hotend change"
msgstr "Смена хотенда"

msgid "The maximum volumetric speed for ramming before a hotend change, where -1 means using the maximum volumetric speed."
msgstr "Максимальная объемная скорость продавливания перед сменой хотенда; -1 означает использование максимальной объемной скорости."

msgid "Minimal purge on wipe tower"
msgstr "Минимальный объём сброса на башне очистки"

msgid "mm³"
msgstr "мм³"

msgid "Filament load time"
msgstr "Время загрузки филамента"

msgid "Time to load new filament when switch filament. For statistics only"
msgstr "Время загрузки нового филамента при смене филамента. Только для статистики"

msgid "Filament unload time"
msgstr "Время выгрузки филамента"

msgid "Time to unload old filament when switch filament. For statistics only"
msgstr "Время выгрузки старого филамента при смене филамента. Только для статистики"

msgid "AMS filament load time"
msgstr "Время загрузки филамента AMS"

msgid "Filament load time when printing with an AMS. For statistics only"
msgstr "Время загрузки филамента при печати с AMS. Только для статистики"

msgid "AMS Lite filament load time"
msgstr "Время загрузки филамента AMS Lite"

msgid "Filament load time when printing with an AMS Lite. For statistics only"
msgstr "Время загрузки филамента при печати с AMS Lite. Только для статистики."

msgid "N3F/N3S filament load time"
msgstr "Время загрузки филамента N3F/N3S"

msgid "Filament load time when printing with an N3F or N3S. For statistics only"
msgstr "Время загрузки филамента при печати с N3F или N3S. Только для статистики"

msgid "AMS filament unload time"
msgstr "Время выгрузки филамента AMS"

msgid "Filament unload time when printing with an AMS. For statistics only"
msgstr "Время выгрузки филамента при печати с AMS. Только для статистики"

msgid "AMS Lite filament unload time"
msgstr "Время выгрузки филамента AMS Lite"

msgid "Filament unload time when printing with an AMS Lite. For statistics only"
msgstr "Время выгрузки филамента при печати с AMS Lite. Только для статистики"

msgid "N3F/N3S filament unload time"
msgstr "Время выгрузки филамента N3F/N3S"

msgid "Filament unload time when printing with an N3F or N3S. For statistics only"
msgstr "Время выгрузки филамента при печати с N3F или N3S. Только для статистики"

msgid "Default AMS type"
msgstr "Тип AMS по умолчанию"

msgid "The default AMS type used to estimate filament load/unload time, stored as the AMS timing type enum value. It comes from the printer preset and does not reflect the AMS currently attached to the machine."
msgstr "Тип AMS по умолчанию, используемый для оценки времени загрузки/выгрузки филамента, хранится как значение перечисления типа времени AMS. Он берется из предустановки принтера и не отражает AMS, подключенный к машине в данный момент."

msgid "Extruder switch time"
msgstr "Время переключения экструдера"

msgid "Time to switch extruder. For statistics only"
msgstr "Время переключения экструдера. Только для статистики"

msgid "Hotend change time"
msgstr "Время смены хотенда"

msgid "Time to change hotend."
msgstr "Время, необходимое для смены хотенда."

# ???? Выбор темп. стола
msgid "Bed temperature type"
msgstr "Способ задания температуры плиты"

msgid "This option determines how the bed temperature is set during slicing: based on the temperature of the first filament or the highest temperature of the printed filaments."
msgstr "Этот параметр определяет, как задаётся температура плиты при нарезке: по температуре первого филамента или по максимальной температуре используемых филаментов."

msgid "By First filament"
msgstr "По первому филаменту"

# ??? Прутком с самой высокой темп.
msgid "By Highest Temp"
msgstr "По максимальной температуре"

msgid "Filament diameter is used to calculate extrusion in gcode, so it's important and should be accurate"
msgstr "Диаметр филамента используется для расчёта экструзии в G-коде, поэтому его значение должно быть точным."

msgid "Adaptive volumetric speed"
msgstr "Адаптивная объемная скорость"

msgid "When enabled, the extrusion flow is limited by the smaller of the fitted value (calculated from line width and layer height) and the user-defined maximum flow. When disabled, only the user-defined maximum flow is applied."
msgstr "Если параметр включён, поток экструзии ограничивается меньшим из двух значений: аппроксимированным значением (рассчитанным по ширине линии и высоте слоя) или заданным пользователем максимальным потоком. Если параметр отключён, применяется только заданный пользователем максимальный поток."

msgid "Max volumetric speed multinomial coefficients"
msgstr "Полиномиальные коэффициенты максимальной объемной скорости"

msgid "Shrinkage"
msgstr "Усадка"

#, no-c-format, no-boost-format
msgid ""
"Enter the shrinkage percentage that the filament will get after cooling (94% if you measure 94mm instead of 100mm). The part will be scaled in xy to compensate. Only the filament used for the perimeter is taken into account.\n"
"Be sure to allow enough space between objects, as this compensation is done after the checks."
msgstr ""
"Укажите процент усадки филамента после охлаждения (94%, если вместо 100 мм получилось 94 мм). Для компенсации размер детали будет масштабирован по осям XY. Учитывается только филамент, используемый для периметра.\n"
"Оставляйте достаточно места между объектами, поскольку компенсация применяется после проверки расстояний."

msgid "Velocity Adaptation Factor"
msgstr "Коэффициент адаптации скорости"

msgid "This parameter reflects the speed at which a material transitions from one state to another. It, along with the smooth coefficient, determines the final length of the transition zone. A larger value: requires a shorter transition zone. A smaller value: requires a longer transition zone to avoid flow instability."
msgstr "Этот параметр отражает скорость перехода материала из одного состояния в другое. Вместе с коэффициентом сглаживания он определяет итоговую длину переходной зоны. Большее значение: требуется более короткая переходная зона. Меньшее значение: требуется более длинная переходная зона, чтобы избежать нестабильности потока."

msgid "Adhesiveness Category"
msgstr "Категория адгезии"

# ???? материала
msgid "Filament category"
msgstr "Категория филамента"

msgid "Metal stickiness"
msgstr "Прилипание к металлу"

msgid "Indicates how strongly the filament tends to stick to the metal nozzle and leave residue. \"None\" means untested or custom filament, behaves the same as Low. Low: e.g. PLA - retraction can be safely skipped in infill areas. Medium: moderate stickiness - use with caution. High: e.g. PETG - retraction should not be skipped to avoid oozing artifacts on outer walls."
msgstr "Показывает, насколько сильно филамент склонен прилипать к металлическому соплу и оставлять на нём остатки. «Нет» означает непроверенный или пользовательский филамент; поведение такое же, как при «Низкая». Низкая: например, PLA — в областях заполнения ретракцию можно безопасно пропускать. Средняя: умеренное прилипание — использовать с осторожностью. Высокая: например, PETG — ретракцию не следует пропускать, чтобы избежать артефактов от подтекания на внешних стенках."

msgid "Density"
msgstr "Плотность"

msgid "Filament density. For statistics only"
msgstr "Плотность филамента. Только для статистики"

msgid "g/cm³"
msgstr "г/см³"

msgid "The material type of filament"
msgstr "Тип материала филамента"

msgid "Soluble material"
msgstr "Растворимый материал"

msgid "Soluble material is commonly used to print support and support interface"
msgstr "Растворимый материал обычно используется для печати поддержек и интерфейсов поддержки."

msgid "Scarf seam type"
msgstr "Тип косого шва"

msgid "Set scarf seam type for this filament. This setting could minimize seam visibiliy."
msgstr "Задать тип косого шва для этого филамента. Этот параметр позволяет уменьшить заметность шва."

msgid "Contour"
msgstr "Контур"

msgid "Contour and hole"
msgstr "Контур и отверстия"

msgid "Scarf start height"
msgstr "Начальная высота косого шва"

msgid "This amount can be specified in millimeters or as a percentage of the current layer height."
msgstr "Это значение можно задать в миллиметрах или в процентах от текущей высоты слоя."

msgid "mm/%"
msgstr "мм/%"

msgid "Scarf slope gap"
msgstr "Зазор наклона косого шва"

# Чтобы уменьшить видимость шва в замкнутом контуре, внутренняя и внешняя стенки укорачиваются на указанное значение.???
# укорачивается,  срезается, обрезается
msgid "In order to reduce the visiblity of the seam in closed loop, the inner wall and outer wall are shortened by a specified amount."
msgstr "Чтобы уменьшить заметность шва в замкнутом контуре, внутренняя и внешняя стенки укорачиваются на заданную величину."

msgid "Scarf length"
msgstr "Длина косого шва"

msgid "Length of the scarf. Setting this parameter to zero effectively disables the scarf."
msgstr "Длина косого шва. Значение 0 фактически отключает косой шов."

# original extruder??? старого экструдера
msgid "When changing the extruder, it is recommended to extrude a certain length of filament from the original extruder. This helps minimize nozzle oozing."
msgstr "При переключении экструдера рекомендуется выдавить из исходного экструдера филамент заданной длины. Это помогает свести к минимуму подтекание из сопла."

msgid "When changing the hotend, it is recommended to extrude a certain length of filament from the original nozzle. This helps minimize nozzle oozing."
msgstr "При смене хотенда рекомендуется экструдировать определённую длину филамента через исходное сопло. Это помогает свести к минимуму подтекание из сопла."

msgid "Support material"
msgstr "Материал поддержки"

msgid "Support material is commonly used to print support and support interface"
msgstr "Материал поддержки обычно используется для печати поддержек и интерфейсов поддержки."

msgid "Is mixed filament"
msgstr "Смешанный филамент"

msgid "Whether this filament slot is a mixed filament composed of multiple physical filaments"
msgstr "Определяет, является ли филамент в этом слоте смешанным филаментом, состоящим из нескольких физических филаментов."

msgid "Mixed filament components"
msgstr "Компоненты смешанного филамента"

msgid "Comma-separated 1-based indices of component filaments, e.g. \"1,3\""
msgstr "Индексы компонентов филамента с нумерацией от 1, разделённые запятыми, например \"1,3\""

msgid "Mixed filament sublayer ratios"
msgstr "Соотношения подслоёв смешанного филамента"

msgid "Comma-separated ratio values summing to 1.0, e.g. \"0.7,0.3\""
msgstr "Значения соотношений, разделённые запятыми и в сумме равные 1.0, например \"0.7,0.3\""

msgid "Mixed filament gradient"
msgstr "Градиент смешанного филамента"

msgid "Enable Z-direction gradient mode for mixed filament sub-layers. When enabled, the sub-layer ratios vary linearly across layers."
msgstr "Включить режим градиента по оси Z для подслоёв смешанного филамента. При включении соотношения подслоёв линейно изменяются по слоям."

msgid "Mixed filament gradient range"
msgstr "Диапазон градиента смешанного филамента"

msgid "Start and end ratios for the first component in gradient mode. Comma-separated pair, e.g. \"0.10,0.90\" means 10% to 90%."
msgstr "Начальное и конечное соотношения первого компонента в градиентном режиме. Пара значений, разделённых запятой, например \"0.10,0.90\", означает диапазон от 10% до 90%."

msgid "Mixed filament gradient curve"
msgstr "Кривая градиента смешанного филамента"

msgid "Optional Photoshop-style custom curve mapping Z progress to the first component ratio. Encoded as pipe-separated control points, either \"x,y\" (legacy) or \"x,y,m_in,m_out\" when a tangent override is needed (empty token or \"nan\" means use PCHIP default). x in [0,1]; y is clamped to the configured ratio range, e.g. \"0,0.15|0.5,0.50|1,0.85\". When empty, the linear gradient_range is used instead."
msgstr "Необязательная пользовательская кривая в стиле Photoshop, сопоставляющая положение по оси Z с долей первого компонента. Кривая кодируется контрольными точками, разделёнными символом |: либо \"x,y\" (устаревший формат), либо \"x,y,m_in,m_out\", если требуется переопределение касательной (пустой токен или \"nan\" означает использование значения PCHIP по умолчанию). x находится в диапазоне [0,1]; y ограничивается настроенным диапазоном соотношений, например \"0,0.15|0.5,0.50|1,0.85\". Если значение пустое, вместо него используется линейный gradient_range."

msgid "Mixed filament per-part gradient"
msgstr "Градиент смешанного филамента для каждой части"

msgid "When gradient mode is enabled, apply the gradient to each part of an assembly independently rather than treating the whole assembly as one Z range."
msgstr "При включённом градиентном режиме градиент применяется независимо к каждой части сборки, а не ко всей сборке как к единому диапазону по оси Z."

msgid "Filament printable"
msgstr "Пригодность филамента для печати"

msgid "The filament is printable in extruder"
msgstr "Этот филамент можно использовать для печати данным экструдером."

msgid "Filament-extruder compatibility"
msgstr "Совместимость филамента с экструдерами"

msgid "A single 32-bit int encoding the compatibility level of a filament across all extruders (up to 10). Every 3 bits represent one extruder (bits [3*i, 3*i+2] for extruder i). 0: printable, 1: error, 2: critical warning, 3: warning, 4-7: reserved"
msgstr "Одно 32-битное целое число, кодирующее уровень совместимости филамента со всеми экструдерами (до 10). Каждые 3 бита соответствуют одному экструдеру (биты [3*i, 3*i+2] для экструдера i). 0: пригоден для печати, 1: ошибка, 2: критическое предупреждение, 3: предупреждение, 4-7: зарезервировано"

msgid "Filament change"
msgstr "Смена филамента"

msgid "The volume of material required to prime the extruder on the tower, excluding a hotend change."
msgstr "Объём материала, необходимый для прокачки экструдера на башне очистки, без учёта смены хотенда."

msgid "The volume of material required to prime the extruder for a hotend change on the tower."
msgstr "Объём материала, необходимый для прокачки экструдера при смене хотенда на башне очистки."

msgid "Preheat temperature delta"
msgstr "Смещение температуры предварительного нагрева"

msgid "Temperature delta applied during pre-heating before tool change."
msgstr "Смещение температуры, применяемое при предварительном нагреве перед сменой инструмента."

msgid "Wipe tower cooling"
msgstr "Охлаждение башни очистки"

msgid "Temperature drop before entering filament tower"
msgstr "Снижение температуры перед входом в башню очистки"

msgid "Interface layer pre-extrusion distance"
msgstr "Расстояние предварительной экструзии интерфейсного слоя"

msgid "Pre-extrusion distance for prime tower interface layer (where different materials meet)."
msgstr "Расстояние предварительной экструзии для интерфейсного слоя башни очистки (в месте контакта разных материалов)."

msgid "Interface layer pre-extrusion length"
msgstr "Длина предварительной экструзии интерфейсного слоя"

msgid "Pre-extrusion length for prime tower interface layer (where different materials meet)."
msgstr "Длина предварительной экструзии для интерфейсного слоя башни очистки (в месте контакта разных материалов)."

msgid "Tower ironing area"
msgstr "Область разглаживания башни очистки"

msgid "Ironing area for prime tower interface layer (where different materials meet)."
msgstr "Область разглаживания интерфейсного слоя башни очистки (в месте контакта разных материалов)."

msgid "mm²"
msgstr "мм²"

msgid "Interface layer purge length"
msgstr "Длина сброса интерфейсного слоя"

msgid "Purge length for prime tower interface layer (where different materials meet)."
msgstr "Длина сброса для интерфейсного слоя башни очистки (в месте контакта разных материалов)."

msgid "Interface layer print temperature"
msgstr "Температура печати интерфейсного слоя"

msgid "Print temperature for prime tower interface layer (where different materials meet). If set to -1, use max recommended nozzle temperature."
msgstr "Температура печати интерфейсного слоя башни очистки (в месте контакта разных материалов). Если установлено -1, использовать максимальную рекомендуемую температуру сопла."

msgid "°C"
msgstr "°С"

msgid "Enable tower interface features"
msgstr "Включить функции интерфейсных слоёв башни очистки"

msgid "When enabled, use dedicated temperature, pre-extrusion and purge settings for prime tower interface layers (where different materials meet), to improve multi-material tool change quality."
msgstr "Если включено, для интерфейсных слоёв башни очистки (в местах контакта разных материалов) используются отдельные настройки температуры, предварительной экструзии и сброса для повышения качества смены инструмента при многоматериальной печати."

msgid "Softening temperature"
msgstr "Температура размягчения"

msgid "The material softens at this temperature, so when the bed temperature is equal to or greater than it, it's highly recommended to open the front door and/or remove the upper glass to avoid cloggings."
msgstr "При этой температуре материал размягчается. Если температура плиты равна ей или выше, настоятельно рекомендуется открыть переднюю дверцу и/или снять верхнее стекло, чтобы избежать закупорки."

# ?????? в смысле сопло?
msgid "To prevent oozing, the nozzle will perform a reverse travel movement for a certain period after the ramming is complete. The setting define the travel time."
msgstr "Чтобы предотвратить подтекание, после завершения продавливания выполняется обратное перемещение в течение заданного времени. Этот параметр задаёт время обратного перемещения."

# ??? Чтобы предотвратить просачивание\подтекание\течи, температура сопла будет снижена во время трамбовки.
msgid "To prevent oozing, the nozzle temperature will be cooled during ramming. Therefore, the ramming time must be greater than the cooldown time. 0 means disabled."
msgstr "Чтобы предотвратить подтекание, температура сопла снижается во время продавливания. Поэтому время продавливания должно быть больше времени охлаждения. 0 означает, что функция отключена."

msgid "To prevent oozing, the nozzle temperature will be cooled during ramming. Note: only a cooldown command and fan activation are triggered, reaching the target temperature is not guaranteed. 0 means disabled."
msgstr "Чтобы предотвратить подтекание, температура сопла снижается во время продавливания. Примечание: запускаются только команда охлаждения и включение вентилятора; достижение целевой температуры не гарантируется. 0 означает, что функция отключена."

msgid "Price"
msgstr "Цена"

msgid "Filament price. For statistics only"
msgstr "Цена филамента. Только для статистики"

msgid "money/kg"
msgstr "валюта/кг"

msgid "Vendor"
msgstr "Производитель"

msgid "Vendor of filament. For show only"
msgstr "Производитель филамента. Только для отображения"

msgid "(Undefined)"
msgstr "(Не определено)"

# уточнил из описания
msgid "Infill direction"
msgstr "Направление заполнения"

msgid "Angle for sparse infill pattern, which controls the start or main direction of line"
msgstr "Угол рисунка разреженного заполнения, задающий начальное или основное направление линий."

msgid "Sparse infill density"
msgstr "Плотность разреженного заполнения"

#, fuzzy, no-c-format, no-boost-format
msgid "Density of internal sparse infill, 100% means solid throughout"
msgstr "Плотность внутреннего разреженного заполнения; 100% означает сплошное заполнение всего объёма."

msgid "Fill multiline"
msgstr "Многострочное заполнение"

msgid "Using multiple lines for the infill pattern, if supported by infill pattern."
msgstr "Использовать несколько линий для рисунка заполнения, если выбранный рисунок заполнения поддерживает эту функцию."

msgid "Sparse infill pattern"
msgstr "Тип внутреннего заполнения"

msgid "Line pattern for internal sparse infill"
msgstr "Рисунок линий внутреннего разреженного заполнения"

msgid "Grid"
msgstr "Сетка"

msgid "Line"
msgstr "Линии"

msgid "Cubic"
msgstr "Кубический"

msgid "Tri-hexagon"
msgstr "Трёхшестиугольник"

msgid "Gyroid"
msgstr "Гироид"

msgid "Honeycomb"
msgstr "Соты"

msgid "Adaptive Cubic"
msgstr "Адаптивный кубический"

msgid "3D Honeycomb"
msgstr "3D-соты"

msgid "Support Cubic"
msgstr "Кубическая поддержка"

msgid "Lightning"
msgstr "Молния"

msgid "Cross Hatch"
msgstr "Перекрёстная штриховка"

msgid "Zig Zag"
msgstr "Зигзаг"

msgid "Cross Zag"
msgstr "Перекрёстный зигзаг"

msgid "Locked Zag"
msgstr "Фиксированный зигзаг"

msgid "2D Lattice"
msgstr "2D-решётка"

msgid "Skin infill pattern"
msgstr "Рисунок заполнения оболочки"

msgid "Line pattern for skin"
msgstr "Рисунок линий оболочки"

msgid "Skeleton infill pattern"
msgstr "Рисунок заполнения каркаса"

msgid "Line pattern for skeleton"
msgstr "Рисунок линий каркаса"

msgid "Acceleration of top surface infill. Using a lower value may improve top surface quality"
msgstr "Ускорение заполнения верхней поверхности. Более низкое значение может улучшить качество верхней поверхности."

msgid "Acceleration of outer wall. Using a lower value can improve quality"
msgstr "Ускорение внешней стенки. Более низкое значение может улучшить качество."

msgid "Acceleration of inner walls. 0 means using normal printing acceleration"
msgstr "Ускорение внутренних стенок. 0 означает использование обычного ускорения печати."

msgid "Acceleration of sparse infill. If the value is expressed as a percentage (e.g. 100%), it will be calculated based on the default acceleration."
msgstr "Ускорение разреженного заполнения. Если значение задано в процентах (например, 100%), оно рассчитывается на основе ускорения по умолчанию."

msgid "mm/s² or %"
msgstr "мм/с² или %"

msgid "Acceleration of initial layer. Using a lower value can improve build plate adhensive"
msgstr "Ускорение первого слоя. Более низкое значение может улучшить адгезию к печатной пластине."

msgid "Enable accel_to_decel"
msgstr "Включить accel_to_decel"

msgid "Klipper's max_accel_to_decel will be adjusted automatically"
msgstr "Параметр max_accel_to_decel в Klipper будет скорректирован автоматически."

msgid "accel_to_decel"
msgstr "Ограничение ускорения зигзагов"

msgid "Klipper's max_accel_to_decel will be adjusted to this percent of acceleration"
msgstr "Параметр max_accel_to_decel в Klipper будет установлен в указанном процентном отношении к ускорению."

msgid "Default jerk"
msgstr "Рывок по умолчанию"

msgid "Jerk of outer walls"
msgstr "Рывок внешних стенок"

msgid "Jerk of inner walls"
msgstr "Рывок внутренних стенок"

msgid "Jerk of infill"
msgstr "Рывок заполнения"

msgid "Jerk of top surface"
msgstr "Рывок верхней поверхности"

msgid "First layer"
msgstr "Первый слой"

msgid "Jerk of first layer"
msgstr "Рывок первого слоя"

msgid "Jerk of travel"
msgstr "Рывок перемещений"

msgid "Line width of initial layer"
msgstr "Ширина линии первого слоя"

msgid "Initial layer infill"
msgstr "Заполнение первого слоя"

msgid "Line width of the infill of initial layer, including sparse infill, solid infill and top surface. Walls, support and everything else of the initial layer are not affected and keep using the line width of initial layer. Zero means to use the line width of initial layer."
msgstr "Ширина линии заполнения первого слоя, включая разреженное заполнение, сплошное заполнение и верхнюю поверхность. Стенки, поддержка и остальные элементы первого слоя не затрагиваются и продолжают использовать ширину линии первого слоя. 0 означает использование ширины линии первого слоя."

msgid "Initial layer height"
msgstr "Высота первого слоя"

msgid "Height of initial layer. Making initial layer height thick slightly can improve build plate adhension"
msgstr "Высота первого слоя. Небольшое увеличение высоты первого слоя может улучшить адгезию к печатной пластине."

msgid "Speed of initial layer except the solid infill part"
msgstr "Скорость первого слоя, кроме участков сплошного заполнения"

msgid "Speed of solid infill part of initial layer"
msgstr "Скорость участков сплошного заполнения первого слоя"

msgid "Initial layer nozzle temperature"
msgstr "Температура сопла для первого слоя"

msgid "Nozzle temperature to print initial layer when using this filament"
msgstr "Температура сопла при печати первого слоя этим филаментом."

msgid "Randomly jitter while printing the wall, so that the surface has a rough look. This setting controls the fuzzy position"
msgstr "При печати стенок траектория случайным образом смещается, придавая поверхности шероховатый вид. Этот параметр определяет, где применяется нечёткая оболочка."

msgid "None(allow paint)"
msgstr "Нет (покраска разрешена)"

msgid "All walls"
msgstr "Все стенки"

msgid "Fuzzy skin thickness"
msgstr "Толщина нечёткой оболочки"

msgid "The width within which to jitter. It's adversed to be below outer wall line width"
msgstr "Диапазон, в пределах которого выполняются случайные смещения. Рекомендуется задавать значение меньше ширины линии внешней стенки."

msgid "Fuzzy skin point distance"
msgstr "Расстояние между точками нечёткой оболочки"

msgid "The average distance between the random points introduced on each line segment"
msgstr "Среднее расстояние между случайными точками на каждом сегменте линии."

msgid "Apply fuzzy skin to first layer"
msgstr "Применять нечёткую оболочку к первому слою"

msgid "Whether to apply fuzzy skin on the first layer."
msgstr "Определяет, применять ли нечёткую оболочку к первому слою."

msgid "Fuzzy skin noise type"
msgstr "Тип шума нечёткой оболочки"

msgid ""
"Noise type to use for fuzzy skin generation:\n"
"Classic: Classic uniform random noise.\n"
"Perlin: Perlin noise, which gives a more consistent texture.\n"
"Billow: Similar to perlin noise, but clumpier.\n"
"Ridged Multifractal: Ridged noise with sharp, jagged features. Creates marble-like textures.\n"
"Voronoi: Divides the surface into voronoi cells, and displaces each one by a random amount. Creates a patchwork texture."
msgstr ""
"Тип шума, используемый для генерации нечёткой оболочки:\n"
"Классический: Классический равномерный случайный шум.\n"
"Perlin: Шум Perlin, обеспечивающий более однородную текстуру.\n"
"Billow: Похож на шум Perlin, но образует более сгруппированную текстуру.\n"
"Ridged Multifractal: Гребенчатый шум с резкими, зазубренными элементами. Создаёт текстуры, похожие на мрамор.\n"
"Voronoi: Разделяет поверхность на ячейки Voronoi и смещает каждую из них на случайную величину. Создаёт лоскутную текстуру."

msgid "Classic"
msgstr "Классический"

msgid "Fuzzy skin feature size"
msgstr "Размер элементов нечёткой оболочки"

msgid "The base size of the coherent noise features, in mm. Higher values will result in larger features."
msgstr "Базовый размер элементов когерентного шума, мм. Чем выше значение, тем крупнее элементы."

msgid "Fuzzy skin noise octaves"
msgstr "Октавы шума нечёткой оболочки"

msgid "The number of octaves of coherent noise to use. Higher values increase the detail of the noise, but also increase computation time."
msgstr "Количество используемых октав когерентного шума. Более высокие значения повышают детализацию шума, но увеличивают время вычислений."

msgid "Fuzzy skin noise persistence"
msgstr "Персистентность шума нечёткой оболочки"

msgid "The decay rate for higher octaves of the coherent noise. Lower values will result in smoother noise."
msgstr "Коэффициент затухания более высоких октав когерентного шума. Более низкие значения дают более плавный шум."

msgid "Fuzzy skin generator mode"
msgstr "Режим генерации нечёткой оболочки"

msgid ""
"Displacement: Pattern is formed by shifting the nozzle sideways from the original path.\n"
"Extrusion: Pattern is formed by varying the amount of extruded plastic (nozzle path stays straight).\n"
"Combined: Displacement + Extrusion. Similar look to Displacement but fills gaps between perimeters.\n"
"Note: Extrusion and Combined only work when fuzzy skin thickness is not greater than the printed line width."
msgstr ""
"Смещение: Рисунок формируется за счёт бокового смещения сопла относительно исходной траектории.\n"
"Экструзия: Рисунок формируется за счёт изменения объёма экструдируемого материала (траектория сопла остаётся прямой).\n"
"Комбинированный: Смещение + экструзия. Выглядит аналогично режиму «Смещение», но заполняет зазоры между периметрами.\n"
"Примечание: Режимы «Экструзия» и «Комбинированный» работают только в том случае, если толщина нечёткой оболочки не превышает ширину печатаемой линии."

msgid "Displacement"
msgstr "Смещение"

msgid "Extrusion"
msgstr "Экструзия"

msgid "Combined"
msgstr "Комбинированный"

msgid "Filter out tiny gaps"
msgstr "Фильтровать мелкие зазоры"

msgid "Filter out gaps smaller than the threshold specified. Gaps smaller than this threshold will be ignored"
msgstr "Отфильтровывать зазоры меньше заданного порога. Зазоры меньше этого порога будут игнорироваться"

msgid "Precise wall"
msgstr "Точные стенки"

msgid "Improve shell precision by adjusting outer wall spacing. This also improves layer consistency."
msgstr "Повышает точность оболочки за счёт корректировки расстояния между внешними стенками. Это также повышает однородность слоёв."

msgid "Speed of gap infill. Gap usually has irregular line width and should be printed more slowly"
msgstr "Скорость заполнения зазоров. Заполнение зазоров обычно имеет неравномерную ширину линии, поэтому его следует печатать медленнее."

msgid "Precise Z height"
msgstr "Точная высота по оси Z"

msgid "Enable this to get precise z height of object after slicing. It will get the precise object height by fine-tuning the layer heights of the last few layers. Note that this is an experimental parameter."
msgstr "Включите эту опцию, чтобы после нарезки получить точную высоту объекта по оси Z. Точная высота объекта достигается за счёт точной корректировки высоты нескольких последних слоёв. Обратите внимание, что это экспериментальный параметр."

msgid "Arc fitting"
msgstr "Аппроксимация дуг"

msgid "Enable this to get a G-code file which has G2 and G3 moves. And the fitting tolerance is the same as resolution"
msgstr "Включите эту опцию, чтобы получить файл G-кода с командами перемещения G2 и G3. Допуск аппроксимации совпадает с разрешением."

msgid "Add line number"
msgstr "Добавлять номера строк"

msgid "Enable this to add line number(Nx) at the beginning of each G-Code line"
msgstr "Включите эту опцию, чтобы добавлять номер строки (Nx) в начало каждой строки G-кода."

msgid "Scan first layer"
msgstr "Сканировать первый слой"

msgid "Enable this to enable the camera on printer to check the quality of first layer"
msgstr "Включите эту опцию, чтобы камера принтера проверяла качество первого слоя."

msgid "Print loops in clockwise"
msgstr "Печатать контуры по часовой стрелке"

msgid "Print in clockwise when enabled, or counterclockwise when not enabled, not work for spiral vase mode"
msgstr "Если включено, контуры печатаются по часовой стрелке; если выключено — против часовой стрелки. Не работает в режиме «Спиральная ваза»"

msgid "Enable clumping detection"
msgstr "Включить обнаружение слипания"

msgid "Order-independent overlap carving"
msgstr "Вырезание перекрытий независимо от порядка"

msgid "When enabled, overlapping model parts are carved by bounding-box size so smaller embedded parts are not removed by larger parts due to volume order."
msgstr "Если включено, перекрывающиеся части модели вырезаются в порядке размера ограничивающих параллелепипедов, поэтому меньшие встроенные части не удаляются более крупными из-за порядка объёмов."

msgid "Clumping detection layers"
msgstr "Слои обнаружения слипания"

msgid "Clumping detection layers."
msgstr "Слои обнаружения слипания."

msgid "Probing exclude area of clumping"
msgstr "Зона исключения зондирования при обнаружении слипания"

msgid "Probing exclude area of clumping."
msgstr "Зона исключения зондирования при обнаружении слипания."

msgid "Thumbnail size"
msgstr "Размер миниатюры"

msgid "Decides the size of thumbnail stored in gcode files"
msgstr "Определяет размер миниатюры, сохраняемой в файлах G-кода."

msgid "Printer structure"
msgstr "Конструкция принтера"

msgid "The physical arrangement and components of a printing device"
msgstr "Физическая компоновка и компоненты печатающего устройства."

msgid "Undefine"
msgstr "Не определено"

msgid "Best object position"
msgstr "Оптимальное положение объекта"

msgid "Best auto arranging position in range [0,1] w.r.t. bed shape."
msgstr "Оптимальное положение при автоматической расстановке в диапазоне [0,1] с учётом формы печатной пластины."

msgid "Enable this option if machine has auxiliary part cooling fan"
msgstr "Включите эту опцию, если принтер оснащён вспомогательным вентилятором обдува модели."

msgid "Fan direction"
msgstr "Направление вентилятора"

msgid "Cooling fan direction of the printer"
msgstr "Направление вентилятора охлаждения принтера"

msgid "Both"
msgstr "Оба"

msgid "Support control chamber temperature"
msgstr "Поддержка управления температурой камеры"

msgid "This option is enabled if machine support controlling chamber temperature"
msgstr "Эта опция включена, если принтер поддерживает управление температурой камеры."

msgid "Air filtration enhancement"
msgstr "Усиленная фильтрация воздуха"

msgid "Enable this if printer support air filtration enhancement."
msgstr "Включите эту функцию, если принтер поддерживает усиленную фильтрацию воздуха."

msgid "Use cooling filter"
msgstr "Использовать охлаждающий фильтр"

msgid "Enable this if printer support cooling filter"
msgstr "Включите эту функцию, если принтер поддерживает охлаждающий фильтр."

msgid "G-code flavor"
msgstr "Диалект G-кода"

msgid "What kind of gcode the printer is compatible with"
msgstr "Определяет, с каким диалектом G-кода совместим принтер."

msgid "Exclude objects"
msgstr "Исключение объектов"

msgid "Enable this option to add EXCLUDE OBJECT command in g-code for klipper firmware printer"
msgstr "Включите эту опцию, чтобы добавить команду EXCLUDE OBJECT в G-код для принтера с прошивкой Klipper."

msgid "Infill combination"
msgstr "Комбинирование заполнения"

msgid "Automatically Combine sparse infill of several layers to print together to reduce time. Wall is still printed with original layer height."
msgstr "Автоматически объединяет разреженное заполнение нескольких слоёв для совместной печати, сокращая время. Стенки по-прежнему печатаются с исходной высотой слоя."

msgid "Infill shift step"
msgstr "Шаг смещения заполнения"

msgid "This parameter adds a slight displacement to each layer of infill to create a cross texture."
msgstr "Этот параметр слегка смещает заполнение каждого слоя, создавая перекрёстную текстуру."

# ??? Угол поворота шаблона заполнения
msgid "Infill rotate step"
msgstr "Шаг поворота заполнения"

msgid "This parameter adds a slight rotation to each layer of infill to create a cross texture."
msgstr "Этот параметр слегка поворачивает заполнение каждого слоя, создавая перекрёстную текстуру."

msgid "Skeleton infill density"
msgstr "Плотность заполнения каркаса"

msgid "The remaining part of the model contour after removing a certain depth from the surface is called the skeleton. This parameter is used to adjust the density of this section.When two regions have the same sparse infill settings but different skeleton densities, their skeleton areas will develop overlapping sections.default is as same as infill density."
msgstr "Часть модели, остающаяся после удаления от поверхности слоя заданной глубины, называется каркасом. Этот параметр регулирует плотность каркаса. Если две области имеют одинаковые настройки разреженного заполнения, но разную плотность каркаса, их области каркаса будут перекрываться. Значение по умолчанию совпадает с плотностью заполнения."

msgid "Skin infill density"
msgstr "Плотность заполнения оболочки"

msgid "The portion of the model's outer surface within a certain depth range is called the skin. This parameter is used to adjust the density of this section.When two regions have the same sparse infill settings but different skin densities, This area will not be split into two separate regions.default is as same as infill density."
msgstr "Часть модели в пределах заданной глубины от внешней поверхности называется оболочкой. Этот параметр регулирует плотность оболочки. Если две области имеют одинаковые настройки разреженного заполнения, но разную плотность оболочки, эта зона не разделяется на две отдельные области. Значение по умолчанию совпадает с плотностью заполнения."

msgid "Skin infill depth"
msgstr "Глубина заполнения оболочки"

msgid "The parameter sets the depth of skin."
msgstr "Этот параметр задаёт глубину оболочки."

msgid "Infill lock depth"
msgstr "Глубина перекрытия заполнения"

msgid "The parameter sets the overlapping depth between the interior and skin."
msgstr "Этот параметр задаёт глубину перекрытия между внутренней частью и оболочкой."

msgid "Skin line width"
msgstr "Ширина линии оболочки"

msgid "Adjust the line width of the selected skin paths."
msgstr "Регулирует ширину линии выбранных траекторий оболочки."

msgid "Skeleton line width"
msgstr "Ширина линии каркаса"

msgid "Adjust the line width of the selected skeleton paths."
msgstr "Регулирует ширину линии выбранных траекторий каркаса."

msgid "Conformal infill"
msgstr ""

msgid "Make sparse infill follow each layer's outline instead of using one set of parallel lines. On elongated or curved shapes, lines radiate from a center. Applies to Zig Zag, Cross Zag, Rectilinear, Aligned Rectilinear, and Locked Zag skin."
msgstr ""

msgid "Layer stagger"
msgstr ""

msgid "How neighboring layers are offset. Off stacks the same layout. Alternate keeps the same line directions but connects each line to the neighboring one on the opposite side, which improves interlayer bonding."
msgstr ""

msgid "Alternate"
msgstr ""

msgid "Forward layers"
msgstr ""

msgid "Conformal forward layers"
msgstr ""

msgid "Number of consecutive layers that keep the forward zigzag. Together with Reverse layers this repeats: N forward, then M reversed. 0 means reverse from the first layer."
msgstr ""

msgid "Reverse layers"
msgstr ""

msgid "Conformal reverse layers"
msgstr ""

msgid "Number of consecutive layers that reverse the zigzag (start from the opposite rim). 0 disables reversing. Forward 1 and Reverse 1 reverses every other layer."
msgstr ""

msgid "Radial center"
msgstr ""

msgid "Where the radial center comes from. Each layer picks a center on that slice. Axis fits one 3D line through those centers. Smooth curve fits a curve so the center does not jump between layers."
msgstr ""

msgid "Each layer"
msgstr ""

msgid "Axis"
msgstr ""

msgid "Smooth curve"
msgstr ""

msgid "Radial line count"
msgstr ""

msgid "How many radial lines around the center. 0 uses the count from sparse infill density. A positive value is the radial line count, rounded up to an even number of at least 4."
msgstr ""

msgid "Center region radius"
msgstr ""

msgid "Radius of the center region that uses ordinary rectilinear infill; outside this circle the infill stays radial. 0 chooses the radius automatically. A positive value is in millimeters."
msgstr ""

msgid "Symmetric infill y axis"
msgstr "Симметричное заполнение относительно оси Y"

# ?????
msgid "If the model has two parts that are symmetric about the y-axis, and you want these parts to have symmetric textures, please click this option on one of the parts."
msgstr "Если модель содержит две части, симметричные относительно оси Y, и для них требуется симметричная текстура, включите этот параметр для одной из частей."

msgid "Lattice angle 1"
msgstr "Угол решётки 1"

msgid "The angle of the first set of 2D lattice elements in the Z direction. Zero is vertical."
msgstr "Угол первого набора элементов 2D-решётки относительно оси Z. 0 соответствует вертикальному направлению."

msgid "Lattice angle 2"
msgstr "Угол решётки 2"

msgid "The angle of the second set of 2D lattice elements in the Z direction. Zero is vertical."
msgstr "Угол второго набора элементов 2D-решётки относительно оси Z. 0 соответствует вертикальному направлению."

msgid "Length of sparse infill anchor"
msgstr "Длина анкеровки разреженного заполнения"

msgid "Connect a sparse infill line to an internal perimeter with a short segment of an additional perimeter. If expressed as percentage (example: 15%) it is calculated over sparse infill line width. Slicer tries to connect two close infill lines to a short perimeter segment. If no such perimeter segment shorter than infill_anchor_max is found, the infill line is connected to a perimeter segment at just one side and the length of the perimeter segment taken is limited to this parameter, but no longer than anchor_length_max. Set this parameter to zero to disable anchoring perimeters connected to a single infill line."
msgstr "Соединяет линию разреженного заполнения с внутренним периметром коротким дополнительным сегментом периметра. Если значение задано в процентах (например: 15%), оно рассчитывается относительно ширины линии разреженного заполнения. Слайсер пытается соединить две близко расположенные линии заполнения коротким сегментом периметра. Если сегмент периметра короче infill_anchor_max не найден, линия заполнения соединяется с сегментом периметра только с одной стороны, а длина используемого сегмента ограничивается этим параметром, но не может превышать anchor_length_max. Установите значение 0, чтобы отключить анкеровку периметров, соединённых только с одной линией заполнения."

msgid "0 (no open anchors)"
msgstr "0 (без открытых анкеров)"

msgid "1000 (unlimited)"
msgstr "1000 (без ограничений)"

msgid "Maximum length of sparse infill anchor"
msgstr "Максимальная длина анкеровки разреженного заполнения"

msgid "Connect a sparse infill line to an internal perimeter with a short segment of an additional perimeter. If expressed as percentage (example: 15%) it is calculated over sparse infill line width. Slicer tries to connect two close infill lines to a short perimeter segment. If no such perimeter segment shorter than this parameter is found, the infill line is connected to a perimeter segment at just one side and the length of the perimeter segment taken is limited to infill_anchor, but no longer than this parameter. Set this parameter to zero to disable anchoring."
msgstr "Соединяет линию разреженного заполнения с внутренним периметром коротким дополнительным сегментом периметра. Если значение задано в процентах (например: 15%), оно рассчитывается относительно ширины линии разреженного заполнения. Слайсер пытается соединить две близко расположенные линии заполнения коротким сегментом периметра. Если сегмент периметра короче этого значения не найден, линия заполнения соединяется с сегментом периметра только с одной стороны, а длина используемого сегмента ограничивается параметром infill_anchor и не может превышать это значение. Установите значение 0, чтобы отключить анкеровку."

msgid "0 (not anchored)"
msgstr "0 (без анкеровки)"

msgid "Sparse infill filament"
msgstr "Филамент разреженного заполнения"

msgid "Filament to print internal sparse infill."
msgstr "Филамент для печати внутреннего разреженного заполнения."

msgid "Line width of internal sparse infill"
msgstr "Ширина линии внутреннего разреженного заполнения"

msgid "Infill/Wall overlap"
msgstr "Перекрытие заполнения и стенок"

msgid "Infill area is enlarged slightly to overlap with wall for better bonding. The percentage value is relative to line width of sparse infill"
msgstr "Область заполнения немного расширяется, чтобы перекрываться со стенками и обеспечивать лучшее сцепление. Процентное значение задаётся относительно ширины линии разреженного заполнения."

msgid "Speed of internal sparse infill"
msgstr "Скорость внутреннего разреженного заполнения"

msgid "Interface shells"
msgstr "Интерфейсные оболочки"

msgid "Force the generation of solid shells between adjacent materials/volumes. Useful for multi-extruder prints with translucent materials or manual soluble support material"
msgstr "Принудительно создавать сплошные оболочки между соседними материалами/объёмами. Полезно при многоэкструдерной печати полупрозрачными материалами или при ручном использовании растворимого материала поддержки."

msgid "Maximum width of a segmented region"
msgstr "Максимальная ширина сегментированной области"

msgid "Maximum width of a segmented region. Zero disables this feature."
msgstr "Максимальная ширина сегментированной области. 0 отключает эту функцию."

msgid "Interlocking depth of a segmented region"
msgstr "Глубина взаимосвязи сегментированной области"

msgid "Interlocking depth of a segmented region. Zero disables this feature."
msgstr "Глубина взаимосвязи сегментированной области. 0 отключает эту функцию."

msgid "Use beam interlocking"
msgstr "Использовать взаимосвязанную структуру"

msgid "Generate interlocking beam structure at the locations where different filaments touch. This improves the adhesion between filaments, especially models printed in different materials."
msgstr "Создавать взаимосвязанную балочную структуру в местах контакта разных филаментов. Это улучшает сцепление между филаментами, особенно при печати модели из разных материалов."

msgid "Interlocking beam width"
msgstr "Ширина взаимосвязанных структур"

msgid "The width of the interlocking structure beams."
msgstr "Ширина балок взаимосвязанной структуры."

msgid "Interlocking direction"
msgstr "Направление взаимосвязанных структур"

msgid "Orientation of interlock beams."
msgstr "Ориентация балок взаимосвязанной структуры."

msgid "Interlocking beam layers"
msgstr "Количество слоев взаимосвязанных структур"

msgid "The height of the beams of the interlocking structure, measured in number of layers. Less layers is stronger, but more prone to defects."
msgstr "Высота балок взаимосвязанной структуры, выраженная количеством слоёв. Меньшее количество слоёв повышает прочность, но увеличивает вероятность дефектов."

msgid "Interlocking depth"
msgstr "Глубина взаимосвязанной структуры"

msgid "The distance from the boundary between filaments to generate interlocking structure, measured in cells. Too few cells will result in poor adhesion."
msgstr "Расстояние от границы между филаментами, на котором создаётся взаимосвязанная структура, измеряется в ячейках. Слишком малое количество ячеек приведёт к недостаточному сцеплению."

msgid "Interlocking boundary avoidance"
msgstr "Избегание границ взаимосвязанной структуры"

msgid "The distance from the outside of a model where interlocking structures will not be generated, measured in cells."
msgstr "Расстояние от внешней границы модели, в пределах которого взаимосвязанные структуры не создаются, измеряется в ячейках."

msgid "Ironing Type"
msgstr "Тип разглаживания"

msgid "Ironing is using small flow to print on same height of surface again to make flat surface more smooth. This setting controls which layer being ironed"
msgstr "Разглаживание — это повторная печать поверхности на той же высоте с небольшим потоком материала для получения более гладкой плоской поверхности. Этот параметр определяет, какие слои будут разглаживаться."

msgid "No ironing"
msgstr "Без разглаживания"

msgid "All solid layer"
msgstr "Все сплошные слои"

msgid "Ironing Pattern"
msgstr "Рисунок разглаживания"

msgid "Ironing flow"
msgstr "Поток разглаживания"

msgid "The amount of material to extrude during ironing. Relative to flow of normal layer height. Too high value results in overextrusion on the surface"
msgstr "Количество материала, экструдируемого при разглаживании. Относительно потока при обычной высоте слоя. Слишком высокое значение приводит к чрезмерной экструзии на поверхности."

msgid "Ironing line spacing"
msgstr "Расстояние между линиями разглаживания"

msgid "The distance between the lines of ironing"
msgstr "Расстояние между линиями разглаживания"

# ??? Отступ от края без разглаживания, Отступ разглаживания от края, Отступ разглаживания, Граница без разглаживания, Отступ без разглаживания
msgid "Ironing inset"
msgstr "Отступ разглаживания"

msgid "The distance to keep the from the edges of ironing line. 0 means not apply."
msgstr "Отступ линий разглаживания от краёв поверхности. 0 означает, что параметр не применяется."

msgid "Ironing speed"
msgstr "Скорость разглаживания"

msgid "Print speed of ironing lines"
msgstr "Скорость печати линий разглаживания"

msgid "ironing direction"
msgstr "Направление разглаживания"

msgid "Angle for ironing, which controls the relative angle between the top surface and ironing"
msgstr "Угол разглаживания, определяющий относительный угол между линиями верхней поверхности и линиями разглаживания."

msgid "This gcode part is inserted at every layer change after lift z"
msgstr "Этот фрагмент G-кода вставляется при каждой смене слоя после подъёма оси Z."

msgid "Clumping detection G-code"
msgstr "G-код обнаружения слипания"

msgid "Supports silent mode"
msgstr "Поддержка бесшумного режима"

msgid "Whether the machine supports silent mode in which machine use lower acceleration to print"
msgstr "Определяет, поддерживает ли принтер бесшумный режим, в котором печать выполняется с меньшим ускорением."

msgid "This G-code will be used as a code for the pause print. User can insert pause G-code in gcode viewer"
msgstr "Этот G-код используется для приостановки печати. Пользователь может вставить G-код паузы в окне просмотра G-кода"

# используется для пользовательского шаблона
msgid "This G-code will be used as a custom code"
msgstr "Этот G-код используется как пользовательский код."

msgid "Support fast purge mode"
msgstr "Поддержка режима быстрого сброса"

msgid "Whether this printer supports fast purge mode with optimized temperature and multiplier."
msgstr "Определяет, поддерживает ли принтер режим быстрого сброса с оптимизированной температурой и множителем."

msgid "Maximum speed X"
msgstr "Максимальная скорость по оси X"

msgid "Maximum speed Y"
msgstr "Максимальная скорость по оси Y"

msgid "Maximum speed Z"
msgstr "Максимальная скорость по оси Z"

msgid "Maximum speed E"
msgstr "Максимальная скорость по оси E"

msgid "Machine limits"
msgstr "Ограничения принтера"

msgid "Maximum X speed"
msgstr "Максимальная скорость по оси X"

msgid "Maximum Y speed"
msgstr "Максимальная скорость по оси Y"

msgid "Maximum Z speed"
msgstr "Максимальная скорость по оси Z"

msgid "Maximum E speed"
msgstr "Максимальная скорость по оси E"

msgid "Maximum acceleration X"
msgstr "Максимальное ускорение по оси X"

msgid "Maximum acceleration Y"
msgstr "Максимальное ускорение по оси Y"

msgid "Maximum acceleration Z"
msgstr "Максимальное ускорение по оси Z"

msgid "Maximum acceleration E"
msgstr "Максимальное ускорение по оси E"

msgid "Maximum acceleration of the X axis"
msgstr "Максимальное ускорение по оси X"

msgid "Maximum acceleration of the Y axis"
msgstr "Максимальное ускорение по оси Y"

msgid "Maximum acceleration of the Z axis"
msgstr "Максимальное ускорение по оси Z"

msgid "Maximum acceleration of the E axis"
msgstr "Максимальное ускорение по оси E"

