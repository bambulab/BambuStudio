msgid "TPU is not supported by AMS."
msgstr "TPU не поддерживается AMS."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS не поддерживает 'Bambu Lab PET-CF'."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Текущий филамент не поддерживает высокопроизводительное сопло E3D и не может быть использован."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "%s можно использовать в правом экструдере только в качестве материала поддержки."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Текущий филамент не поддерживает высокопоточное сопло для TPU и не может быть использован."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "Автоматическая калибровка динамического потока не поддерживается для филамента TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Bambu TPU 85A не поддерживается для печати соплами 0.4 мм Standard или High Flow."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "При использовании ABS/ASA/PETG HF на правом экструдере его можно использовать только в качестве материала поддержки."

msgid "How to feed TPU filament."
msgstr "Как загружать TPU филамент."

msgid "How to feed TPU filament on X2D."
msgstr "Как загружать TPU филамент на X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Использование филамента, не произведенного компанией Bambu lab, может привести к проблемам с качеством печати."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Пожалуйста, выполните холодную протяжку перед печатью TPU, чтобы избежать закупорки. Вы можете использовать функцию холодной протяжки на принтере."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Влажный PVA станет гибким и может застрять внутри AMS, пожалуйста, высушите его перед использованием."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Влажный PVA эластичен и может застрять в экструдере. Просушите его перед использованием."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF хрупкий и может сломаться в изогнутой PTFE трубке над печатающей головкой."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF хрупкий и может сломаться в изогнутой PTFE трубке над печатающей головкой."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "Печать с помощью PLA Glow может приводить к износу первичного механизма подачи AMS. Используйте вместо него внешнюю катушку."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Настройки по умолчанию могут повлиять на качество печати. Для достижения наилучших результатов откорректируйте их по необходимости."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "При использовании %s с соплами 0,4 мм с увеличенным потоком существует риск закупорки. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Филаменты %s являются твердыми и хрупкими и могут сломаться в AMS, а также существует риск закупорки сопла при использовании сопел 0,4 мм с увеличенным потоком. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "При использовании %s с соплами 0,4, 0,6, 0,8 мм с увеличенным потоком существует риск закупорки. Используйте с осторожностью."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "%s может не загрузиться или не выгрузиться из-за переключателя тракта филамента. Если вы хотите продолжить."

