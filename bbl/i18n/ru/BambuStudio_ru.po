msgstr "Без проверки"

msgid "Do not run any validity checks, such as gcode path conflicts check."
msgstr "Не выполнять проверку достоверности, например, проверку конфликтов путей G-кода."

msgid "Error in zip archive"
msgstr "Ошибка в ZIP-архиве"

msgid "Generating walls"
msgstr "Генерация стенок"

msgid "Generating infill regions"
msgstr "Генерация областей заполнения"

msgid "Generating infill toolpath"
msgstr "Генерация траектории инструмента для заполнения"

msgid "Detect overhangs for auto-lift"
msgstr "Обнаружение нависающих элементов для автоматического подъема"

msgid "Checking support necessity"
msgstr "Проверка необходимости поддержки"

msgid "floating regions"
msgstr "Плавающие области"

msgid "floating cantilever"
msgstr "Нависающая консоль"

msgid "large overhangs"
msgstr "Большие нависания"

#, c-format, boost-format
msgid "It seems object %s has %s. Please re-orient the object or enable support generation."
msgstr "Похоже, объект %s имеет %s. Измените ориентацию объекта или включите генерацию поддержек."

msgid "Generating support"
msgstr "Генерация поддержек"

msgid "Optimizing toolpath"
msgstr "Оптимизация траектории"

#, boost-format
msgid ""
"Unsupported overhangs were detected.\n"
"Model \"%1%\" has %2% overhang region(s). Because \"Support on build plate only\" is enabled, supports cannot grow down to the build plate. Try turning this option off."
msgstr ""
"Обнаружены неподдерживаемые нависания.\n"
"Модель «%1%» имеет %2% областей нависания. Поскольку включена опция «Поддержки только на печатной пластине», поддержки не могут опускаться до печатной пластины. Попробуйте отключить эту опцию."

#, boost-format
msgid ""
"Unsupported overhangs were detected.\n"
"Model \"%1%\" has %2% overhang region(s) that could not get support. Try adjusting the support settings or re-orienting the object."
msgstr ""
"Обнаружены неподдерживаемые нависания.\n"
"Модель «%1%» имеет %2% областей нависания, которые не получили поддержки. Попробуйте настроить параметры поддержек или переориентировать объект."

msgid "Empty layers around bottom are replaced by nearest normal layers."
msgstr "Пустые слои у основания заменены ближайшими нормальными слоями."

msgid "The model has too many empty layers."
msgstr "В модели слишком много пустых слоев."

msgid "Slicing mesh"
msgstr "Нарезка сетки"

msgid "No layers were detected. You might want to repair your STL file(s) or check their size or thickness and retry.\n"
msgstr "Слои не обнаружены. Возможно, потребуется восстановить файл(ы) STL или проверить их размер/толщину, затем повторить попытку.\n"

msgid ""
"An object's XY size compensation will not be used because it is also color-painted.\n"
"XY Size compensation can not be combined with color-painting."
msgstr ""
"Компенсация размера объекта по осям XY не будет применяться, так как он также окрашен.\n"
"Компенсация размера по осям XY не может быть совмещена с окрашиванием."

msgid ""
"An object has enabled XY Size compensation which will not be used because it is also fuzzy skin painted.\n"
"XY Size compensation cannot be combined with fuzzy skin painting."
msgstr ""
"Для объекта включена компенсация размера по осям XY, которая не будет использоваться, так как он также окрашен «пушистой кожей».\n"
"Компенсация размера по осям XY не может быть совмещена с окрашиванием «пушистой кожей»."

msgid "Loading of a model file failed."
msgstr "Не удалось загрузить файл модели."

msgid "Meshing of a model file failed or no valid shape."
msgstr "Не удалось создать сетку из файла модели или отсутствует допустимая форма."

msgid "The supplied file couldn't be read because it's empty"
msgstr "Предоставленный файл не удалось прочитать, так как он пуст"

msgid "The file format is incompatible and cannot be parsed."
msgstr "Формат файла несовместим и не может быть обработан."

msgid "Unknown file format. Input file must have .stl, .obj, .amf(.xml), .gltf, .glb, .fbx extension."
msgstr "Неизвестный формат файла. Входной файл должен иметь расширение .stl, .obj, .amf(.xml), .gltf, .glb, .fbx."

msgid "Unknown file format. Input file must have .3mf or .zip.amf extension."
msgstr "Неизвестный формат файла. Входной файл должен иметь расширение .3mf или .zip.amf."

msgid "Canceled"
msgstr "Отменено"

msgid "Restoring support painting"
msgstr "Восстановление покраски поддержек"

msgid "Restoring seam painting"
msgstr "Восстановление покраски швов"

msgid "Restoring paint color"
