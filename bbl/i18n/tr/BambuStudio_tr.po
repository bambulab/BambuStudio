msgid "TPU is not supported by AMS."
msgstr "TPU, AMS tarafından desteklenmemektedir."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS, 'Bambu Lab PET-CF'yi desteklemiyor."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Mevcut filament, E3D yüksek akışlı püskürtme ucunu desteklemiyor ve bu püskürtme ucuyla kullanılamaz."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "Sağ ekstrüderde %s kullanıldığında, yalnızca destek malzemesi olarak kullanılabilir."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Mevcut filament, TPU yüksek akışlı püskürtme ucunu desteklemiyor ve bu püskürtme ucuyla kullanılamaz."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "TPU filament için Otomatik Akış Dinamiği Kalibrasyonu desteklenmez."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Bambu TPU 85A, 0,4 mm Standart veya Yüksek Akışlı püskürtme uçlarıyla baskı için desteklenmez."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "Sağ ekstrüderde ABS/ASA/PETG HF kullanılırken, bu malzeme yalnızca destek malzemesi olarak kullanılabilir."

msgid "How to feed TPU filament."
msgstr "TPU filament nasıl beslenir."

msgid "How to feed TPU filament on X2D."
msgstr "X2D'de TPU filament nasıl beslenir?"

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Bambu dışı filament kullanmak baskı kalitesi sorunlarına yol açabilir."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Tıkanmayı önlemek için lütfen TPU yazdırmadan önce soğuk çekme işlemi yap. Yazıcıdaki püskürtme ucu soğuk çekme bakımını kullanabilirsin."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Nemli PVA esnekleşir ve AMS içinde sıkışabilir; lütfen kullanmadan önce iyice kurut."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Nemli PVA esnektir ve ekstrüderde sıkışabilir. Kullanmadan önce kurut."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF kırılgandır ve takım kafasının üzerindeki bükülmüş PTFE boruda kırılabilir."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF kırılgandır ve takım kafasının üzerindeki bükülmüş PTFE boruda kırılabilir."

msgid "CF/GF filaments are hard and brittle, It's easy to break or get stuck in AMS, please use with caution."
msgstr "CF/GF filamentleri sert ve kırılgandır. AMS'de kırılması veya sıkışması kolaydır, lütfen dikkatli kullanın."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "PLA Glow, AMS birinci aşama besleyicisini aşındırabilir. Bunun yerine harici makara kullan."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Varsayılan ayarlar baskı kalitesini etkileyebilir. En iyi sonuçlar için ayarları gerektiği gibi düzenle."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "%s için 0,4 mm yüksek akışlı püskürtme uçları kullanıldığında püskürtme ucu tıkanması riski vardır. Dikkatli kullan."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "%s filamentleri sert ve kırılgandır; AMS içinde kırılabilirler. Ayrıca 0,4 mm'lik yüksek akışlı püskürtme uçları kullanıldığında püskürtme ucu tıkanması riski vardır. Dikkatli kullan."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "%s için 0,4, 0,6 ve 0,8 mm yüksek akışlı püskürtme uçları kullanıldığında püskürtme ucu tıkanması riski vardır. Dikkatli kullan."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "%s , Filament Hattı Değiştirici nedeniyle yüklenemeyebilir veya boşaltılamayabilir. Devam etmek istersen."

#, c-format, boost-format
msgid "%s is not supported by %s extruder."
msgstr "%s, %s ekstrüder tarafından desteklenmiyor."

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s Bowden extruder. Use with caution!"
msgstr "'%s' filamenti %s Bowden ekstrüder ile yazdırılırken ciddi baskı kalitesi sorunları oluşabilir. Dikkatli kullan!"

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s extruder. Use with caution!"
msgstr "'%s' filamenti %s ekstrüder ile yazdırılırken ciddi baskı kalitesi sorunları oluşabilir. Dikkatli kullan!"

#, c-format, boost-format
