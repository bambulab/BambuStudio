msgstr "“Dikey kabuk kalınlığını sağla” ayarını Kısmi olarak ayarla."

#, c-format, boost-format
msgid "Set wall loops to %d."
msgstr "Duvar halkalarını %d olarak ayarla."

#, c-format, boost-format
msgid "Set sparse infill density to %d%%."
msgstr "Seyrek dolgu yoğunluğunu %d%% olarak ayarla."

msgid "Disable spiral vase mode."
msgstr "Spiral vazo modunu devre dışı bırak."

msgid ""
"Change these settings automatically?\n"
"Yes - Apply and keep alternate extra wall enabled\n"
"No  - Don't use alternate extra wall"
msgstr ""
"Bu ayarlar otomatik olarak değiştirilsin mi?\n"
"Evet - Ayarları uygula ve alternatif ek duvarı etkin tut.\n"
"Hayır - Alternatif ek duvarı kullanma."

