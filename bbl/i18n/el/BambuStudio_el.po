msgstr "Η εισαγωγή στο Bambu Studio απέτυχε. Παρακαλώ κατεβάστε το αρχείο και εισαγάγετέ το χειροκίνητα."

msgid "The current settings produce a model that is too large. Please narrow the range or increase the step size. (Model size is proportional to (End - Start) / Step size.)"
msgstr "Οι τρέχουσες ρυθμίσεις παράγουν ένα μοντέλο που είναι πολύ μεγάλο. Παρακαλώ περιορίστε το εύρος ή αυξήστε το μέγεθος βήματος. (Το μέγεθος του μοντέλου είναι ανάλογο με το (Τέλος - Αρχή) / Μέγεθος βήματος.)"

msgid "The selected file"
msgstr "Το επιλεγμένο αρχείο"

msgid "does not contain valid gcode."
msgstr "δεν περιέχει έγκυρο gcode."

msgid "Error occurs while loading G-code file"
msgstr "Παρουσιάζεται σφάλμα κατά τη φόρτωση του αρχείου G-code"

msgid "Drop project file"
msgstr "Αποθήκευση αρχείου έργου"

msgid "Please select an action"
msgstr "Παρακαλώ επιλέξτε μια ενέργεια"

msgid "Open as project"
msgstr "Άνοιγμα ως έργο"

msgid "Import geometry only"
msgstr "Εισαγωγή μόνο γεωμετρίας"

msgid "Please import multiple files with the same suffix."
msgstr "Παρακαλούμε εισάγετε πολλά αρχεία με την ίδια κατάληξη."

msgid "Only one G-code file can be opened at the same time."
msgstr "Μπορεί να ανοιχτεί μόνο ένα αρχείο G-code κάθε φορά."

msgid "G-code loading"
msgstr "Φόρτωση κώδικα G"

msgid "G-code files can not be loaded with models together!"
msgstr "Τα αρχεία G-code δεν μπορούν να φορτωθούν μαζί με τα μοντέλα!"

msgid "Can not add models when in preview mode!"
msgstr "Δεν είναι δυνατή η προσθήκη μοντέλων όταν βρίσκεστε σε λειτουργία προεπισκόπησης!"

msgid "Add Models"
msgstr "Προσθήκη μοντέλων"

msgid "All objects will be removed, continue?"
msgstr "Όλα τα αντικείμενα θα αφαιρεθούν, θέλετε να συνεχίσετε;"

msgid "The current project has unsaved changes, save it before continue?"
msgstr "Το τρέχον έργο περιέχει α αποθηκευμένες αλλαγές. Θέλετε να το αποθηκεύσετε πριν συνεχίσετε;"

msgid "Remember my choice."
msgstr "Να θυμάστε την επιλογή μου."

msgid "Number of copies:"
msgstr "Αριθμός αντιγράφων:"

msgid "Copies of the selected object"
msgstr "Αντίγραφα του επιλεγμένου αντικειμένου"

msgid "Save G-code file as:"
msgstr "Αποθήκευση αρχείου G-code ως:"

msgid "Save SLA file as:"
msgstr "Αποθήκευση αρχείου SLA ως:"

msgid "The provided file name is not valid."
msgstr "Το όνομα του αρχείου που παρέχεται δεν είναι έγκυρο."

msgid "The following characters are not allowed by a FAT file system:"
msgstr "Οι ακόλουθοι χαρακτήρες δεν επιτρέπονται από ένα σύστημα αρχείων FAT:"

msgid "Save Sliced file as:"
msgstr "Αποθήκευση του αρχείου κοπής ως:"

msgid ""
"Failed to export the sliced file.\n"
"Please check whether the file is occupied by another program or if there is enough disk space."
msgstr ""
"Δεν κατέστη δυνατή η εξαγωγή του αρχείου που έχει υποστεί κοπή.\n"
"Παρακαλώ ελέγξτε αν το αρχείο χρησιμοποιείται από άλλο πρόγραμμα ή αν υπάρχει αρκετός χώρος στο δίσκο."

msgid "Export sliced file"
msgstr "Εξαγωγή του αρχείου κοπής"

#, c-format, boost-format
msgid "The file %s has been sent to the printer's storage space and can be viewed on the printer."
msgstr "Το αρχείο %s έχει σταλεί στον χώρο αποθήκευσης του εκτυπωτή και μπορεί να προβληθεί στον εκτυπωτή."

msgid "The nozzle type is not set. Please set the nozzle and try again."
msgstr "Ο τύπος ακροφυσίου δεν έχει οριστεί. Ορίστε το ακροφύσιο και δοκιμάστε ξανά."

msgid "The nozzle type is not set. Please check."
msgstr "Ο τύπος ακροφυσίου δεν έχει οριστεί. Παρακαλώ ελέγξτε."

msgid "Unable to perform boolean operation on model meshes. You may fix the meshes and try again."
msgstr "Δεν είναι δυνατή η εκτέλεση λογικής πράξης στα πλέγματα του μοντέλου. Μπορείτε να διορθώσετε τα πλέγματα και να δοκιμάσετε ξανά."

#, boost-format
msgid "Reason: part \"%1%\" is empty."
msgstr "Λόγος: το τμήμα «%1%» είναι κενό."

#, boost-format
msgid "Reason: part \"%1%\" does not bound a volume."
msgstr "Λόγος: το τμήμα «%1%» δεν οριοθετεί έναν όγκο."

#, boost-format
msgid "Reason: part \"%1%\" has self intersection."
msgstr "Λόγος: το τμήμα «%1%» παρουσιάζει αυτοδιασταύρωση."

#, boost-format
msgid "Reason: \"%1%\" and another part have no intersection."
msgstr "Λόγος: Το «%1%» και ένα άλλο τμήμα δεν έχουν καμία τομή."

msgid "Negative parts detected. Would you like to perform mesh boolean before exporting?"
msgstr "Εντοπίστηκαν αρνητικά τμήματα. Θέλετε να εκτελέσετε Boolean πλέγμα πριν από την εξαγωγή;"

msgid "Failed to save the project: an invalid setting value was found while writing the file."
msgstr "Αποτυχία αποθήκευσης του έργου: εντοπίστηκε μη έγκυρη τιμή ρύθμισης κατά την εγγραφή του αρχείου."

msgid "Please check your settings and try again."
msgstr "Παρακαλώ ελέγξτε τις ρυθμίσεις σας και δοκιμάστε ξανά."

msgid ""
"Security Warning: This 3MF file contains post-processing script commands that will run automatically during slicing and may pose security risks!\n"
"Please verify the file source and script contents before continuing."
msgstr ""
"Προειδοποίηση ασφαλείας: Αυτό το αρχείο 3MF περιέχει εντολές σεναρίου μετα-επεξεργασίας που θα εκτελεστούν αυτόματα κατά τη διάρκεια της κοπής και ενδέχεται να ενέχουν κινδύνους ασφαλείας!\n"
"Παρακαλούμε επαληθεύστε την προέλευση του αρχείου και το περιεχόμενο του σεναρίου πριν συνεχίσετε."

#, c-format, boost-format
msgid "The calibration filament is currently assigned to a different extruder than the one selected in the PA Calibration dialog (%s). This may lead to incorrect calibration results. You can change the assignment in the filament grouping settings."
msgstr "Το νήμα βαθμονόμησης έχει επί του παρόντος αντιστοιχιστεί σε διαφορετικό εξωθητή από αυτόν που έχει επιλεγεί στο παράθυρο διαλόγου «PA Calibration» (%s). Αυτό μπορεί να οδηγήσει σε εσφαλμένα αποτελέσματα βαθμονόμησης. Μπορείτε να αλλάξετε την αντιστοίχιση στις ρυθμίσεις ομαδοποίησης νημάτων."

msgid "It is not recommended to use PVA filaments with 0.2mm nozzles."
msgstr "Δεν συνιστάται η χρήση νημάτων PVA με ακροφύσια 0,2 mm."

msgid "Are you sure to use them? \n"
msgstr "Είστε σίγουροι ότι θέλετε να τα χρησιμοποιήσετε; \n"

msgid "When thermal preconditioning is enabled, duration auto-adjusts to the model's position for optimal first-layer quality; the farther from the center, the longer it takes. White boxes mark the boundary lines. To disable the guidelines and this warning, go to Preferences > 3D."
msgstr "Όταν είναι ενεργοποιημένη η θερμική προετοιμασία, η διάρκεια προσαρμόζεται αυτόματα ανάλογα με τη θέση του μοντέλου για βέλτιστη ποιότητα του πρώτου στρώματος· όσο πιο μακριά από το κέντρο, τόσο περισσότερο χρόνο χρειάζεται. Τα λευκά πλαίσια σηματοδοτούν τις γραμμές ορίου. Για να απενεργοποιήσετε τις οδηγίες και αυτήν την προειδοποίηση, μεταβείτε στις «Προτιμήσεις» > «3D»."

