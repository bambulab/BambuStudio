msgstr "Μήκος νήματος που χρησιμοποιείται στην συμπίεση."

msgid "Travel time after ramming"
msgstr "Χρόνος διαδρομής μετά την πρόσκρουση"

msgid "A reverse travel movement after ramming."
msgstr "Μια κίνηση αντίστροφης πορείας μετά την πρόσκρουση."

msgid "Precooling target temperature"
msgstr "Θερμοκρασία-στόχος προψύξης"

msgid "Precooling target temperature during ramming."
msgstr "Θερμοκρασία-στόχος προψύξης κατά τη διάρκεια της συμπίεσης."

msgid "Recommended nozzle temperature"
msgstr "Συνιστώμενη θερμοκρασία ακροφυσίου"

