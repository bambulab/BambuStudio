#, c-format, boost-format
msgid "version %s update information :"
msgstr "πληροφορίες ενημέρωσης έκδοσης %s:"

msgid "Network plug-in update"
msgstr "Ενημέρωση προσθέτου δικτύου"

msgid "Click OK to update the Network plug-in when Bambu Studio launches next time."
msgstr "Κάντε κλικ στο «OK» για να ενημερώσετε το πρόσθετο δικτύου όταν ξεκινήσει το Bambu Studio την επόμενη φορά."

#, c-format, boost-format
msgid "A new Network plug-in(%s) available, Do you want to install it?"
msgstr "Είναι διαθέσιμο ένα νέο πρόσθετο δικτύου (%s). Θέλετε να το εγκαταστήσετε;"

