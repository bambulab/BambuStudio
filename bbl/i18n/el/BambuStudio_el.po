msgstr "Εξαγωγή κομμένου αρχείου"

#, c-format, boost-format
msgid "The file %s has been sent to the printer's storage space and can be viewed on the printer."
msgstr "Το αρχείο %s έχει σταλεί στον χώρο αποθήκευσης του εκτυπωτή και μπορεί να προβληθεί στον εκτυπωτή."

msgid "The nozzle type is not set. Please set the nozzle and try again."
msgstr "Ο τύπος ακροφυσίου δεν έχει οριστεί. Ρυθμίστε το ακροφύσιο και προσπαθήστε ξανά."

msgid "The nozzle type is not set. Please check."
msgstr "Ο τύπος ακροφυσίου δεν έχει οριστεί. Ελέγξτε."

msgid "Unable to perform boolean operation on model meshes. You may fix the meshes and try again."
msgstr "Δεν είναι δυνατή η εκτέλεση λογικής λειτουργίας σε πλέγματα μοντέλων. Μπορείτε να διορθώσετε τα πλέγματα και να προσπαθήσετε ξανά."

#, boost-format
msgid "Reason: part \"%1%\" is empty."
msgstr "Αιτία: το τμήμα «%1%» είναι κενό."

#, boost-format
msgid "Reason: part \"%1%\" does not bound a volume."
msgstr "Αιτία: το τμήμα «%1%» δεν δεσμεύει έναν όγκο."

