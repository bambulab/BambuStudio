msgid "TPU is not supported by AMS."
msgstr "Το TPU δεν υποστηρίζεται από το AMS."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "Το AMS δεν υποστηρίζει το 'Bambu Lab PET-CF'."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Το τρέχον νήμα δεν υποστηρίζει το ακροφύσιο υψηλής ροής E3D και δεν μπορεί να χρησιμοποιηθεί."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "Κατά τη χρήση %s στον δεξιό εξωθητήρα, μπορεί να χρησιμοποιηθεί μόνο ως υλικό υποστήριξης."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Το τρέχον νήμα δεν υποστηρίζει το ακροφύσιο υψηλής ροής TPU και δεν μπορεί να χρησιμοποιηθεί."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "Η αυτόματη δυναμική βαθμονόμηση ροής δεν υποστηρίζεται για το νήμα TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Το Bambu TPU 85A δεν υποστηρίζεται για εκτύπωση με ακροφύσια Τυπικά ή Υψηλής ροής 0,4 mm."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "Όταν χρησιμοποιείτε ABS/ASA/PETG HF στον δεξιό εξωθητήρα, μπορεί να χρησιμοποιηθεί μόνο ως υλικό υποστήριξης."

msgid "How to feed TPU filament."
msgstr "Τρόπος τροφοδοσίας νήματος TPU."

msgid "How to feed TPU filament on X2D."
msgstr "Πώς να τροφοδοτήσετε το νήμα TPU στο X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Η χρήση νήματος που δεν είναι από την Bambu ενδέχεται να προκαλέσει προβλήματα στην ποιότητα εκτύπωσης."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Τραβήξτε το προϊόν εν ψυχρώ πριν από την εκτύπωση TPU, για να αποφύγετε την απόφραξη. Μπορείτε να χρησιμοποιήσετε συντήρηση ψυχρής έλξης στον εκτυπωτή."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Το Damp PVA θα γίνει εύκαμπτο και θα κολλήσει μέσα στον εξωθητήρα. Φροντίστε να το στεγνώσετε πριν από τη χρήση."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Το υγρό PVA είναι εύκαμπτο και ενδέχεται να κολλήσει στον εξωθητήρα. Στεγνώστε το πριν από τη χρήση."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "Το PPS-CF είναι εύθραυστο και μπορεί να σπάσει σε λυγισμένο σωλήνα PTFE πάνω από την κεφαλή εργαλείου."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "Το PPA-CF είναι εύθραυστο και μπορεί να σπάσει σε λυγισμένο σωλήνα PTFE πάνω από την κεφαλή εργαλείου."

msgid "CF/GF filaments are hard and brittle, It's easy to break or get stuck in AMS, please use with caution."
msgstr ""

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "Το PLA Glow ενδέχεται να προκαλέσει φθορά στον τροφοδότη πρώτου σταδίου AMS. Χρησιμοποιείτε εξωτερικό καρούλι."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Οι προεπιλεγμένες ρυθμίσεις ενδέχεται να επηρεάσουν την ποιότητα εκτύπωσης. Προσαρμόστε όπως απαιτείται για καλύτερα αποτελέσματα."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Το %s παρουσιάζει κίνδυνο απόφραξης των ακροφυσίων κατά τη χρήση ακροφυσίων υψηλής ροής 0,4 mm. Χρησιμοποιήστε με προσοχή."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Τα νήματα %s είναι σκληρά και εύθραυστα και μπορεί να σπάσουν στο AMS, ενώ υπάρχει επίσης κίνδυνος απόφραξης ακροφυσίου κατά τη χρήση ακροφυσίων υψηλής ροής 0,4 mm. Χρησιμοποιήστε με προσοχή."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "Το %s παρουσιάζει κίνδυνο απόφραξης των ακροφυσίων κατά τη χρήση ακροφυσίων υψηλής ροής 0,4, 0,6, 0,8 mm. Χρησιμοποιήστε με προσοχή."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "Το %s ενδέχεται να μην είναι μπορεί να φορτωθεί ή εκφορτωθεί, λόγω του Διακόπτη γραμμής νήματος. Αν θέλετε να συνεχίσετε."

#, c-format, boost-format
msgid "%s is not supported by %s extruder."
msgstr "Το %s δεν υποστηρίζεται από τον εξωθητήρα %s."

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s Bowden extruder. Use with caution!"
msgstr "Ενδέχεται να παρουσιαστούν σοβαρά προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση «%s» με %s εξωθητήρα Bowden. Χρησιμοποιήστε με προσοχή!"

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s extruder. Use with caution!"
msgstr "Ενδέχεται να παρουσιαστούν σοβαρά προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση «%s» με εξωθητήρα %s. Χρησιμοποιήστε με προσοχή!"

#, c-format, boost-format
msgid "There may be print quality issues when printing '%s' with %s Bowden extruder. Use with caution."
msgstr "Ενδέχεται να παρουσιαστούν προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση «%s» με %s εξωθητήρα Bowden. Χρησιμοποιήστε με προσοχή."

#, c-format, boost-format
msgid "There may be print quality issues when printing '%s' with %s extruder. Use with caution."
msgstr "Ενδέχεται να παρουσιαστούν προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση «%s» με εξωθητήρα %s. Χρησιμοποιήστε με προσοχή."

msgid "The toolhead and hotend rack may move. Please keep your hands away from the chamber."
msgstr "Η κεφαλή εργαλείου και η σχάρα θερμού άκρου ενδέχεται να μετακινηθούν. Διατηρείτε τα χέρια σας μακριά από τον θάλαμο."

