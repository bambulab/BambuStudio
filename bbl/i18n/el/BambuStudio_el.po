msgid "TPU is not supported by AMS."
msgstr "Το TPU δεν υποστηρίζεται από το AMS."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "Το AMS δεν υποστηρίζει το «Bambu Lab PET-CF»."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Το τρέχον νήμα δεν είναι συμβατό με το ακροφύσιο υψηλής ροής E3D και δεν μπορεί να χρησιμοποιηθεί."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "Όταν χρησιμοποιείτε το %s στον δεξιό εξωθητή, μπορεί να χρησιμοποιηθεί μόνο ως υλικό στήριξης."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Το τρέχον νήμα δεν είναι συμβατό με το ακροφύσιο υψηλής ροής TPU και δεν μπορεί να χρησιμοποιηθεί."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "Η αυτόματη δυναμική βαθμονόμηση ροής δεν υποστηρίζεται για το νήμα TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Το Bambu TPU 85A δεν υποστηρίζεται για εκτύπωση με ακροφύσια 0,4 mm Standard ή High Flow."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "Όταν χρησιμοποιείτε ABS/ASA/PETG HF στον δεξιό εξωθητή, μπορεί να χρησιμοποιηθεί μόνο ως υλικό στήριξης."

msgid "How to feed TPU filament."
msgstr "Πώς να τροφοδοτήσετε το νήμα TPU."

msgid "How to feed TPU filament on X2D."
msgstr "Πώς να τροφοδοτήσετε το νήμα TPU στο X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Η χρήση νήματος που δεν είναι της μάρκας «bambu» ενδέχεται να προκαλέσει προβλήματα στην ποιότητα εκτύπωσης."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Παρακαλούμε να πραγματοποιήσετε «cold pull» πριν από την εκτύπωση TPU, για να αποφύγετε το φράξιμο. Μπορείτε να χρησιμοποιήσετε τη λειτουργία συντήρησης «cold pull» στον εκτυπωτή."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "Το υγρό PVA γίνεται εύκαμπτο και κολλάει μέσα στο AMS, γι’ αυτό φροντίστε να το στεγνώσετε πριν από τη χρήση."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Το υγρό PVA είναι εύκαμπτο και μπορεί να κολλήσει στον εξωθητή. Στεγνώστε το πριν από τη χρήση."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "Το PPS-CF είναι εύθραυστο και ενδέχεται να σπάσει στον καμπυλωμένο σωλήνα PTFE πάνω από την κεφαλή εκτύπωσης."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "Το PPA-CF είναι εύθραυστο και ενδέχεται να σπάσει μέσα στον καμπυλωμένο σωλήνα PTFE πάνω από την κεφαλή εκτύπωσης."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "Το PLA Glow ενδέχεται να φθείρει τον τροφοδότη πρώτου σταδίου του AMS. Χρησιμοποιήστε αντ' αυτού ένα εξωτερικό καρούλι."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Οι προεπιλεγμένες ρυθμίσεις ενδέχεται να επηρεάσουν την ποιότητα εκτύπωσης. Προσαρμόστε τις ανάλογα με τις ανάγκες για βέλτιστα αποτελέσματα."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Το %s ενέχει κίνδυνο απόφραξης του ακροφυσίου όταν χρησιμοποιούνται ακροφύσια υψηλής ροής 0,4 mm. Χρησιμοποιήστε το με προσοχή."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Τα νήματα %s είναι σκληρά και εύθραυστα και ενδέχεται να σπάσουν στο AMS, ενώ υπάρχει επίσης κίνδυνος απόφραξης του ακροφυσίου κατά τη χρήση ακροφυσίων υψηλής ροής 0,4 mm. Χρησιμοποιήστε τα με προσοχή."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "Το %s ενέχει κίνδυνο απόφραξης του ακροφυσίου κατά τη χρήση ακροφυσίων υψηλής ροής διαμέτρου 0,4, 0,6 και 0,8 mm. Χρησιμοποιήστε το με προσοχή."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "Το %s ενδέχεται να μην φορτωθεί ή να μην εκφορτωθεί λόγω του διακόπτη παρακολούθησης νήματος. Εάν επιθυμείτε να συνεχίσετε."

#, c-format, boost-format
msgid "%s is not supported by %s extruder."
msgstr "Το %s δεν υποστηρίζεται από τον εξωθητή %s."

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s Bowden extruder. Use with caution!"
msgstr "Ενδέχεται να προκύψουν σοβαρά προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση του «%s» με τον εξωθητή Bowden %s. Χρησιμοποιήστε το με προσοχή!"

#, c-format, boost-format
msgid "There may be critical print quality issues when printing '%s' with %s extruder. Use with caution!"
msgstr "Ενδέχεται να προκύψουν σοβαρά προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση του «%s» με τον εξωθητή %s. Χρησιμοποιήστε το με προσοχή!"

#, c-format, boost-format
msgid "There may be print quality issues when printing '%s' with %s Bowden extruder. Use with caution."
msgstr "Ενδέχεται να προκύψουν προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση του «%s» με τον εξωθητή Bowden %s. Χρησιμοποιήστε το με προσοχή."

#, c-format, boost-format
msgid "There may be print quality issues when printing '%s' with %s extruder. Use with caution."
msgstr "Ενδέχεται να προκύψουν προβλήματα ποιότητας εκτύπωσης κατά την εκτύπωση του «%s» με τον εξωθητή %s. Χρησιμοποιήστε το με προσοχή."

msgid "The toolhead and hotend rack may move. Please keep your hands away from the chamber."
msgstr "Η κεφαλή εκτύπωσης και η βάση του hotend ενδέχεται να κινηθούν. Παρακαλούμε κρατήστε τα χέρια σας μακριά από τον θάλαμο εκτύπωσης."

msgid "Warning"
msgstr "Προειδοποίηση"

msgid "Hotend information may be inaccurate. Would you like to re-read the hotend? (Hotend information may change during power-off)."
msgstr "Οι πληροφορίες για το hotend ενδέχεται να είναι ανακριβείς. Θέλετε να διαβάσετε ξανά το hotend; (Οι πληροφορίες για το hotend ενδέχεται να αλλάξουν κατά τη διάρκεια της απενεργοποίησης)."

msgid "I confirm all"
msgstr "Επιβεβαιώνω τα πάντα"

msgid "Re-read all"
msgstr "Ξαναδιαβάστε τα πάντα"

msgid "Reading the hotends, please wait."
msgstr "Ανάγνωση των hotends, παρακαλώ περιμένετε."

msgid "During the hotend upgrade, the toolhead will move. Don't reach into the chamber."
msgstr "Κατά τη διάρκεια της αναβάθμισης του hotend, η κεφαλή εκτύπωσης θα κινηθεί. Μην βάζετε τα χέρια σας μέσα στο θάλαμο."

