msgstr "Μη έγκυρη τιμή όταν είναι ενεργοποιημένη η λειτουργία σπειροειδούς βάζου: "

msgid "too large line width "
msgstr "πολύ μεγάλο πλάτος γραμμής "

msgid " not in range "
msgstr " εκτός εύρους "

msgid "No check"
msgstr "Χωρίς έλεγχο"

msgid "Do not run any validity checks, such as gcode path conflicts check."
msgstr "Να μην εκτελούνται έλεγχοι εγκυρότητας, όπως ο έλεγχος για διενέξεις διαδρομής gcode."

msgid "Error in zip archive"
msgstr "Σφάλμα στο αρχείο zip"

msgid "Generating walls"
msgstr "Δημιουργία τοίχων"

msgid "Generating infill regions"
msgstr "Δημιουργία περιοχών πλήρωσης"

msgid "Generating infill toolpath"
msgstr "Δημιουργία διαδρομής εργαλείου πλήρωσης"

msgid "Detect overhangs for auto-lift"
msgstr "Ανίχνευση προεξοχών για αυτόματη ανύψωση"

msgid "Checking support necessity"
msgstr "Έλεγχος αναγκαιότητας υποστήριξης"

msgid "floating regions"
msgstr "αιωρούμενες περιοχές"

msgid "floating cantilever"
msgstr "αιωρούμενος προβόλος"

msgid "large overhangs"
msgstr "μεγάλες προεξοχές"

#, c-format, boost-format
msgid "It seems object %s has %s. Please re-orient the object or enable support generation."
msgstr "Φαίνεται ότι το αντικείμενο %s έχει %s. Παρακαλούμε επαναπροσανατολίστε το αντικείμενο ή ενεργοποιήστε τη δημιουργία υποστηρίξεων."

msgid "Generating support"
msgstr "Δημιουργία υποστήριξης"

msgid "Optimizing toolpath"
msgstr "Βελτιστοποίηση διαδρομής εργαλείου"

