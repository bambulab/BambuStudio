msgstr "Εξαγωγή τεμαχισμένου αρχείου"

#, c-format, boost-format
msgid "The file %s has been sent to the printer's storage space and can be viewed on the printer."
msgstr "Το αρχείο %s έχει σταλεί στον αποθηκευτικό χώρο του εκτυπωτή και μπορεί να προβληθεί στον εκτυπωτή."

msgid "The nozzle type is not set. Please set the nozzle and try again."
msgstr "Ο τύπος του ακροφυσίου δεν έχει οριστεί. Παρακαλούμε ορίστε το ακροφύσιο και προσπαθήστε ξανά."

msgid "The nozzle type is not set. Please check."
msgstr "Ο τύπος του ακροφυσίου δεν έχει οριστεί. Παρακαλούμε ελέγξτε."

msgid "Unable to perform boolean operation on model meshes. You may fix the meshes and try again."
msgstr "Αδυναμία εκτέλεσης Boolean λειτουργίας στα πλέγματα του μοντέλου. Ενδέχεται να χρειαστεί να διορθώσετε τα πλέγματα και να προσπαθήσετε ξανά."

#, boost-format
msgid "Reason: part \"%1%\" is empty."
msgstr "Λόγος: το τμήμα \"%1%\" είναι κενό."

#, boost-format
msgid "Reason: part \"%1%\" does not bound a volume."
msgstr "Λόγος: το τμήμα \"%1%\" δεν οριοθετεί όγκο."

