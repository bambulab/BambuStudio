msgid "Warning: There is a mirror in the text matrix, and dragging it will completely regenerate it."
msgstr "Προειδοποίηση: Υπάρχει κατοπτρισμός στον πίνακα κειμένου και το σύρσιμο προκαλεί πλήρη αναδημιουργία."

msgid "Warning: Due to font upgrades, previous font may not necessarily be replaced successfully. Please modify the font."
msgstr "Προειδοποίηση: Λόγω αναβαθμίσεων γραμματοσειρών, η προηγούμενη γραμματοσειρά ενδέχεται να μην αντικατασταθεί απαραίτητα με επιτυχία. Τροποποιήστε τη γραμματοσειρά."

msgid "Warning: Text creation failed."
msgstr "Προειδοποίηση: Η δημιουργία κειμένου απέτυχε."

msgid "Warning: Text normal has an error."
msgstr "Προειδοποίηση: Το κανονικό κείμενο παρουσιάζει σφάλμα."

msgid "Warning: Text normal has been reset."
msgstr "Προειδοποίηση: Έγινε επαναφορά κανονικού κειμένου."

msgid "Warning: Current text spacing is not optimal. If you continue editing, a more reasonable text spacing will be generated."
msgstr "Προειδοποίηση: Η τρέχουσα απόσταση κειμένου δεν είναι η βέλτιστη. Εάν συνεχίσετε την επεξεργασία, θα δημιουργηθεί μια πιο λογική απόσταση κειμένου."

msgid "Warning: Old matrix has at least two parameters: mirroring, scaling, and rotation. If you continue editing, it may not be correct. Please drag the text or cancel the current pose, save and reedit again."
msgstr "Προειδοποίηση: Ένας παλιός πίνακας έχει τουλάχιστον δύο παραμέτρους: κατοπτρισμό, κλιμάκωση και περιστροφή. Αν συνεχίσετε την επεξεργασία, ενδέχεται να μην είναι σωστό. Σύρετε το κείμενο ή ακυρώστε την τρέχουσα πόζα, αποθηκεύστε και επεξεργαστείτε ξανά."

msgid "Error: Detecting an incorrect mesh id or an unknown error, regenerating text may result in incorrect outcomes. Please drag text, save it then reedit it again."
msgstr "Σφάλμα: Εάν εντοπιστεί εσφαλμένο αναγνωριστικό πλέγματος ή άγνωστο σφάλμα, η αναδημιουργία κειμένου ενδέχεται να οδηγήσει σε εσφαλμένα αποτελέσματα. Σύρετε το κείμενο, αποθηκεύστε το και επεξεργαστείτε το ξανά."

msgid "Warning: Due to functional upgrade, rotation information cannot be restored. Please drag or modify text, save it and reedit it to fix the issue."
msgstr "Προειδοποίηση: Λόγω λειτουργικής αναβάθμισης, δεν είναι δυνατή η επαναφορά των πληροφοριών περιστροφής. Σύρετε ή τροποποιήστε το κείμενο, αποθηκεύστε το και επεξεργαστείτε το ξανά για να διορθώσετε το πρόβλημα."

msgid "Detected that text did not adhere to mesh surface. Please manually drag yellow square to mesh surface that needs to be adhered."
msgstr "Εντοπίστηκε ότι το κείμενο δεν προσκολλήθηκε στην επιφάνεια του πλέγματος. Σύρετε μη αυτόματα το κίτρινο τετράγωνο στην επιφάνεια πλέγματος που πρέπει να προσκολληθεί."

msgid "The text cannot be written using the selected font. Please try choosing a different font."
msgstr "Το κείμενο δεν μπορεί να γραφτεί με την επιλεγμένη γραμματοσειρά. Δοκιμάστε να επιλέξετε διαφορετική γραμματοσειρά."

