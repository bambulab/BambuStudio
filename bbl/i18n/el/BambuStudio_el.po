msgid "Warning: There is a mirror in the text matrix, and dragging it will completely regenerate it."
msgstr "Προειδοποίηση: Υπάρχει ένας καθρέφτης στη μήτρα κειμένου και η μεταφορά του θα την αναδημιουργήσει πλήρως."

msgid "Warning: Due to font upgrades, previous font may not necessarily be replaced successfully. Please modify the font."
msgstr "Προειδοποίηση: Λόγω αναβαθμίσεων γραμματοσειρών, η προηγούμενη γραμματοσειρά ενδέχεται να μην έχει αντικατασταθεί επιτυχώς. Παρακαλώ τροποποιήστε τη γραμματοσειρά."

msgid "Warning: Text creation failed."
msgstr "Προειδοποίηση: Απέτυχε η δημιουργία κειμένου."

msgid "Warning: Text normal has an error."
msgstr "Προειδοποίηση: Το κανονικό κείμενο έχει σφάλμα."

msgid "Warning: Text normal has been reset."
msgstr "Προειδοποίηση: Το κανονικό κείμενο έχει επαναφερθεί."

msgid "Warning: Current text spacing is not optimal. If you continue editing, a more reasonable text spacing will be generated."
msgstr "Προειδοποίηση: Η τρέχουσα απόσταση κειμένου δεν είναι βέλτιστη. Εάν συνεχίσετε την επεξεργασία, θα δημιουργηθεί μια πιο λογική απόσταση κειμένου."

msgid "Warning: Old matrix has at least two parameters: mirroring, scaling, and rotation. If you continue editing, it may not be correct. Please drag the text or cancel the current pose, save and reedit again."
msgstr "Προειδοποίηση: Ο παλιός πίνακας έχει τουλάχιστον δύο παραμέτρους: κατοπτρισμό, κλιμάκωση και περιστροφή. Αν συνεχίσετε την επεξεργασία, μπορεί να μην είναι σωστός. Παρακαλούμε σύρετε το κείμενο ή ακυρώστε την τρέχουσα πόζα, αποθηκεύστε και επεξεργαστείτε ξανά."

msgid "Error: Detecting an incorrect mesh id or an unknown error, regenerating text may result in incorrect outcomes. Please drag text, save it then reedit it again."
msgstr "Σφάλμα: Ανιχνεύτηκε μη έγκυρο αναγνωριστικό πλέγματος ή άγνωστο σφάλμα, η αναδημιουργία κειμένου μπορεί να οδηγήσει σε λανθασμένα αποτελέσματα. Παρακαλούμε σύρετε το κείμενο, αποθηκεύστε το και επεξεργαστείτε το ξανά."

msgid "Warning: Due to functional upgrade, rotation information cannot be restored. Please drag or modify text, save it and reedit it to fix the issue."
msgstr "Προειδοποίηση: Λόγω αναβάθμισης λειτουργικότητας, οι πληροφορίες περιστροφής δεν μπορούν να αποκατασταθούν. Παρακαλούμε σύρετε ή τροποποιήστε το κείμενο, αποθηκεύστε το και επεξεργαστείτε το ξανά για να διορθώσετε το πρόβλημα."

msgid "Detected that text did not adhere to mesh surface. Please manually drag yellow square to mesh surface that needs to be adhered."
msgstr "Εντοπίστηκε ότι το κείμενο δεν προσκολλήθηκε στην επιφάνεια του πλέγματος. Παρακαλούμε σύρετε χειροκίνητα το κίτρινο τετράγωνο στην επιφάνεια του πλέγματος που πρέπει να προσκολληθεί."

msgid "The text cannot be written using the selected font. Please try choosing a different font."
msgstr "Το κείμενο δεν μπορεί να γραφτεί χρησιμοποιώντας την επιλεγμένη γραμματοσειρά. Παρακαλούμε δοκιμάστε να επιλέξετε μια διαφορετική γραμματοσειρά."

msgid "Embossed text cannot contain only white spaces."
msgstr "Το ανάγλυφο κείμενο δεν μπορεί να περιέχει μόνο κενά."

msgid "Unsupported characters automatically switched to fallback font."
msgstr "Οι μη υποστηριζόμενοι χαρακτήρες άλλαξαν αυτόματα σε εφεδρική γραμματοσειρά."

msgid "Text doesn't show current horizontal alignment."
msgstr "Το κείμενο δεν εμφανίζει την τρέχουσα οριζόντια ευθυγράμμιση."

#, boost-format
