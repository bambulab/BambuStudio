msgid "Caution: Mixing nozzle diameters in one print is not supported. If the selected size is only on one extruder, single-extruder printing will be enforced."
msgstr "Προσοχή: Η ανάμειξη διαμέτρων ακροφυσίων σε μία εκτύπωση δεν υποστηρίζεται. Εάν το επιλεγμένο μέγεθος είναι μόνο σε έναν εξωθητήρα, θα επιβληθεί η εκτύπωση σε έναν εξωθητήρα."

#, c-format, boost-format
msgid "Refresh %d/%d..."
msgstr "Ανανέωση %d/%d..."

msgid "Unknown nozzle detected. Refresh to update info (unrefreshed nozzles will be excluded during slicing). Verify nozzle diameter & flow rate against displayed values."
msgstr "Εντοπίστηκε άγνωστο ακροφύσιο. Ανανέωση για ενημέρωση των πληροφοριών (τα ακροφύσια που δεν έχουν ανανεωθεί θα εξαιρεθούν κατά τον τεμαχισμό). Επαληθεύστε τη διάμετρο και τον ρυθμό ροής του ακροφυσίου σε σχέση με τις εμφανιζόμενες τιμές."

msgid "Unknown nozzle detected. Refresh to update (unrefreshed nozzles will be skipped in slicing)."
msgstr "Εντοπίστηκε άγνωστο ακροφύσιο. Ανανέωση για ενημέρωση (τα μη ανανεωμένα ακροφύσια θα παραλειφθούν κατά τον τεμαχισμό)."

msgid "Please confirm whether the required nozzle diameter and flow rate match the currently displayed values."
msgstr "Ελέγξτε αν η απαιτούμενη διάμετρος ακροφυσίου και ο ρυθμός ροής αντιστοιχούν με τις εμφανιζόμενες τιμές."

msgid "Your printer has different nozzles installed. Please select a nozzle for this print."
msgstr "Ο εκτυπωτής σας έχει εγκατεστημένα διαφορετικά ακροφύσια. Επιλέξτε ένα ακροφύσιο για αυτήν την εκτύπωση."

msgid "Purge Mode Settings"
msgstr "Ρυθμίσεις λειτουργίας καθαρισμού"

msgid "Perform full purging with speed and temperature transition for the best print quality."
msgstr "Εκτελέστε πλήρη καθαρισμό με μετάβαση ταχύτητας και θερμοκρασίας για την καλύτερη ποιότητα εκτύπωσης."

msgid "Uses optimized purge temperature, multiplier and stronger extrusion for faster purging. May cause slight color mixing in some extreme cases."
msgstr "Χρησιμοποιεί βελτιστοποιημένη θερμοκρασία καθαρισμού, πολλαπλασιαστή και ισχυρότερη εξώθηση για ταχύτερο καθαρισμό. Ενδέχεται να προκαλέσει ελαφρά ανάμειξη χρωμάτων σε ορισμένες ακραίες περιπτώσεις."

msgid "Prime Saving"
msgstr "Εξοικονόμηση πλήρωσης"

msgid "Reduces prime waste and prints faster. May cause slight color mixing or small surface defects."
msgstr "Μειώνει τη σπατάλη πλήρωσης και εκτυπώνει πιο γρήγορα. Μπορεί να προκαλέσει ελαφρά ανάμειξη χρωμάτων ή μικρά επιφανειακά ελαττώματα."

msgid "Learn more about prime mode"
msgstr "Μάθετε περισσότερα για τη λειτουργία πλήρωσης"

msgid "AMS Dryness Control"
msgstr "Έλεγχος ξήρανσης AMS"

msgid "Filament Drying Settings"
msgstr "Ρυθμίσεις ξήρανσης νήματος"

msgid "Start"
msgstr "Έναρξη"

msgid "Unable to dry temporarily due to ..."
msgstr "Η ξήρανση δεν είναι δυνατή προσωρινά λόγω..."

msgid "Drying Error"
msgstr "Σφάλμα ξήρανσης"

msgid "Please check the Assistant for troubleshooting"
msgstr "Ανατρέξτε στον Βοηθό για αντιμετώπιση προβλημάτων"

msgid "Please remove and store the filament (as shown)."
msgstr "Αφαιρέστε και αποθηκεύστε το νήμα (όπως φαίνεται)."

msgid "The AMS can rotate the filament which is properly stored, providing better drying results."
msgstr "Το AMS θα περιστρέφει αυτόματα το νήμα που έχει αποθηκευτεί σωστά, παρέχοντας καλύτερα αποτελέσματα ξήρανσης."

msgid "Rotate spool when drying"
msgstr "Περιστροφή καρουλιού κατά την ξήρανση"

msgctxt "amsdrying"
msgid "Back"
msgstr "Πίσω"

msgid "Drying-Heating"
msgstr "Ξήρανση-θέρμανση"

msgid "Drying-Dehumidifying"
msgstr "Ξήρανση-αφύγρανση"

msgid " maximum drying temperature is "
msgstr " η μέγιστη θερμοκρασία ξήρανσης είναι "

msgid " minimum drying temperature is "
msgstr " η ελάχιστη θερμοκρασία ξήρανσης είναι "

msgid "This filament may not be completely dried."
msgstr "Αυτό το νήμα ενδέχεται να μην έχει ξηρανθεί πλήρως."

msgid "This AMS is currently printing. To ensure print quality, the drying temperature cannot exceed the recommended drying temperature."
msgstr "Αυτό το AMS εκτυπώνει αυτήν τη στιγμή. Για να διασφαλιστεί η ποιότητα εκτύπωσης, η θερμοκρασία ξήρανσης δεν μπορεί να υπερβαίνει την προτεινόμενη θερμοκρασία ξήρανσης."

msgid "The temperature shall not exceed the filament's heat distortion temperature"
msgstr "Η θερμοκρασία δεν πρέπει να υπερβαίνει τη θερμοκρασία θερμικής παραμόρφωσης του νήματος"

msgid "Minimum time value cannot be less than 1."
msgstr "Η ελάχιστη χρονική τιμή δεν μπορεί να είναι μικρότερη από 1."

msgid "Maximum time value cannot be greater than 24."
msgstr "Η μέγιστη χρονική τιμή δεν μπορεί να είναι μεγαλύτερη από 24."

msgid "Insufficient power"
msgstr "Ανεπαρκής ισχύς"

msgid "  Too many AMS drying simultaneously. Please plug in the power or stop other drying processes before starting."
msgstr "  Πάρα πολλά AMS πραγματοποιούν ξήρανση ταυτόχρονα. Συνδέστε το στην πρίζα ή διακόψτε άλλες διαδικασίες ξήρανσης προτού ξεκινήσετε."

msgid "AMS is busy"
msgstr "Το AMS είναι απασχολημένο"

msgid "  AMS is calibrating | reading RFID | loading/unloading material, please wait."
msgstr "  Το AMS εκτελεί ρύθμιση | πραγματοποιεί ανάγνωση RFID | φορτώνει/εκφορτώνει υλικό. Περιμένετε."

msgid "Filament in AMS outlet"
msgstr "Νήμα στην έξοδο AMS"

msgid "  The high drying temperature may cause AMS blockage, please unload first."
msgstr "  Η υψηλή θερμοκρασία ξήρανσης ενδέχεται να προκαλέσει αποκλεισμό του AMS. Πραγματοποιήστε πρώτα εκφόρτωση."

msgid "Initiating AMS drying"
msgstr "Έναρξη ξήρανσης AMS"

msgid "Not supported in 2D mode"
msgstr "Δεν υποστηρίζεται σε λειτουργία 2D"

msgid "Task in progress"
msgstr "Εργασία σε εξέλιξη"

msgid "  The AMS might be in use during Task."
msgstr "  Το AMS ενδέχεται να χρησιμοποιείται κατά τη διάρκεια της εργασίας."

msgid "  Firmware update in progress, please wait..."
msgstr "  Ενημέρωση υλικολογισμικού σε εξέλιξη, περιμένετε..."

msgid "  Please plug in the power and then use the drying function."
msgstr "  Συνδέστε την τροφοδοσία και, στη συνέχεια, χρησιμοποιήστε τη λειτουργία ξήρανσης."

msgid "  The high drying temperature may cause AMS blockage. Please unload the filament manually before proceeding."
msgstr "  Η υψηλή θερμοκρασία ξήρανσης ενδέχεται να προκαλέσει αποκλεισμό του AMS. Εκφορτώστε το νήμα χειροκίνητα προτού συνεχίσετε."

msgid "System is busy"
msgstr "Το σύστημα είναι απασχολημένο"

msgid "  Initiating other drying processes, please wait a few seconds..."
msgstr "  Εκκίνηση άλλων διαδικασιών ξήρανσης. Περιμένετε μερικά δευτερόλεπτα..."

msgid "For better drying results, remove the filament and allow it to rotate."
msgstr "Για καλύτερα αποτελέσματα ξήρανσης, αφαιρέστε το νήμα και αφήστε το να περιστραφεί."

msgid "The AMS will automatically rotate the stored filament slots to enhance the drying performance."
msgstr "Το AMS θα περιστρέφει αυτόματα τις αποθηκευμένες υποδοχές νήματος για να βελτιώσει την απόδοση ξήρανσης."

msgid "Alternatively, you can dry the filament without removing it."
msgstr "Εναλλακτικά, μπορείτε να ξηράνετε το νήμα χωρίς να το αφαιρέσετε."

msgid "Unknown filaments will be treated as PLA."
msgstr "Τα άγνωστα νήματα θα αντιμετωπίζονται ως PLA."

msgid "Please store the filament marked with an exclamation mark."
msgstr "Αποθηκεύστε το νήμα που έχει επισημανθεί με θαυμαστικό."

msgid "Filament left in the feeder during drying may soften because the drying temperature exceeds the softening point of materials like PLA and TPU."
msgstr "Το νήμα που παραμένει στον τροφοδότη κατά τη διάρκεια της ξήρανσης ενδέχεται να μαλακώσει, επειδή η θερμοκρασία ξήρανσης υπερβαίνει το σημείο στο οποίο μαλακώνουν υλικά όπως PLA και TPU."

