msgid "Warning: There is a mirror in the text matrix, and dragging it will completely regenerate it."
msgstr "Προειδοποίηση: Υπάρχει ένας καθρέφτης στον πίνακα κειμένου και, αν τον σύρετε, θα αναδημιουργηθεί εξ ολοκλήρου."

msgid "Warning: Due to font upgrades, previous font may not necessarily be replaced successfully. Please modify the font."
msgstr "Προειδοποίηση: Λόγω αναβαθμίσεων γραμματοσειρών, η προηγούμενη γραμματοσειρά ενδέχεται να μην αντικατασταθεί επιτυχώς. Παρακαλούμε τροποποιήστε τη γραμματοσειρά."

msgid "Warning: Text creation failed."
msgstr "Προειδοποίηση: Η δημιουργία κειμένου απέτυχε."

msgid "Warning: Text normal has an error."
msgstr "Προειδοποίηση: Το κείμενο «normal» περιέχει σφάλμα."

msgid "Warning: Text normal has been reset."
msgstr "Προειδοποίηση: Η κανονική μορφή κειμένου έχει επαναφερθεί."

msgid "Warning: Current text spacing is not optimal. If you continue editing, a more reasonable text spacing will be generated."
msgstr "Προειδοποίηση: Η τρέχουσα απόσταση μεταξύ των γραμμάτων δεν είναι η βέλτιστη. Εάν συνεχίσετε την επεξεργασία, θα δημιουργηθεί μια πιο λογική απόσταση μεταξύ των γραμμάτων."

msgid "Warning: Old matrix has at least two parameters: mirroring, scaling, and rotation. If you continue editing, it may not be correct. Please drag the text or cancel the current pose, save and reedit again."
msgstr "Προειδοποίηση: Η παλιά μήτρα έχει τουλάχιστον δύο παραμέτρους: κατοπτρισμό, κλιμάκωση και περιστροφή. Εάν συνεχίσετε την επεξεργασία, το αποτέλεσμα ενδέχεται να μην είναι σωστό. Παρακαλώ σύρετε το κείμενο ή ακυρώστε την τρέχουσα στάση, αποθηκεύστε και επεξεργαστείτε ξανά."

msgid "Error: Detecting an incorrect mesh id or an unknown error, regenerating text may result in incorrect outcomes. Please drag text, save it then reedit it again."
msgstr "Σφάλμα: Εντοπίστηκε λανθασμένος αναγνωριστικός κωδικός πλέγματος ή άγνωστο σφάλμα. Η εκ νέου δημιουργία κειμένου ενδέχεται να οδηγήσει σε λανθασμένα αποτελέσματα. Παρακαλούμε σύρετε το κείμενο, αποθηκεύστε το και, στη συνέχεια, επεξεργαστείτε το ξανά."

msgid "Warning: Due to functional upgrade, rotation information cannot be restored. Please drag or modify text, save it and reedit it to fix the issue."
msgstr "Προειδοποίηση: Λόγω λειτουργικής αναβάθμισης, οι πληροφορίες περιστροφής δεν μπορούν να αποκατασταθούν. Παρακαλούμε σύρετε ή τροποποιήστε το κείμενο, αποθηκεύστε το και επεξεργαστείτε το ξανά για να διορθώσετε το πρόβλημα."

msgid "Detected that text did not adhere to mesh surface. Please manually drag yellow square to mesh surface that needs to be adhered."
msgstr "Εντοπίστηκε ότι το κείμενο δεν προσκολλάται στην επιφάνεια του πλέγματος. Παρακαλώ σύρετε χειροκίνητα το κίτρινο τετράγωνο στην επιφάνεια του πλέγματος που πρέπει να προσκολληθεί."

msgid "The text cannot be written using the selected font. Please try choosing a different font."
msgstr "Το κείμενο δεν μπορεί να γραφτεί με τη γραμματοσειρά που έχετε επιλέξει. Παρακαλώ δοκιμάστε να επιλέξετε μια διαφορετική γραμματοσειρά."

msgid "Embossed text cannot contain only white spaces."
msgstr "Το ανάγλυφο κείμενο δεν μπορεί να περιέχει μόνο κενά."

