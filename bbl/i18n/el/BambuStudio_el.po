#, c-format, boost-format
msgid "The %s nozzle can not print %s."
msgstr "Το ακροφύσιο %s δεν μπορεί να εκτυπώσει %s."

#, boost-format
msgid "Mixing %1% with %2% in printing is not recommended.\n"
msgstr "Δεν συνιστάται η ανάμειξη του %1% με το %2% κατά την εκτύπωση.\n"

msgid " nozzle"
msgstr " ακροφύσιο"

