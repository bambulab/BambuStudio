msgid "Printer not connected. Please go to the device page to connect %s before syncing."
msgstr "Ο εκτυπωτής δεν είναι συνδεδεμένος. Μεταβείτε στη σελίδα της συσκευής για να συνδέσετε το %s πριν από τον συγχρονισμό."

#, c-format, boost-format
msgid "The currently connected printer on the device page is not %s. Please switch to %s before syncing."
msgstr "Ο εκτυπωτής που είναι συνδεδεμένος αυτήν τη στιγμή στη σελίδα της συσκευής δεν είναι %s. Κάντε εναλλαγή σε %s πριν από τον συγχρονισμό."

msgid "There are no filaments on the printer. Please load the filaments on the printer first."
msgstr "Δεν υπάρχουν νήματα στον εκτυπωτή. Τοποθετήστε πρώτα τα νήματα στον εκτυπωτή."

msgid "The filaments on the printer are all unknown types. Please go to the printer screen or software device page to set the filament type."
msgstr "Τα νήματα στον εκτυπωτή είναι όλα άγνωστου τύπου. Μεταβείτε στην οθόνη του εκτυπωτή ή στη σελίδα της συσκευής λογισμικού για να ορίσετε τον τύπο νήματος."

msgid "Device Page"
msgstr "Σελίδα συσκευής"

msgid "Synchronize AMS Filament Information"
msgstr "Συγχρονισμός πληροφοριών νήματος AMS"

