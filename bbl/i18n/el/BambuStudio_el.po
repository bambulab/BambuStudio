msgstr "3D κηρήθρα"

msgid "Support Cubic"
msgstr "Κυβική υποστήριξη"

msgid "Lightning"
msgstr "Αστραπή"

msgid "Cross Hatch"
msgstr "Διασταύρωση γραμμών"

msgid "Zig Zag"
