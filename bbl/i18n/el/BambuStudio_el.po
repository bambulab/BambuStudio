msgid "Filament Color"
msgstr "Χρώμα νήματος"

msgid "Decomposed Colors"
msgstr "Αποσυντεθειμένα χρώματα"

msgid "Select Color Decomposition"
msgstr "Επιλογή Αποσύνθεσης χρωμάτων"

msgid "Project Filament"
msgstr "Νήμα έργου"

msgid "Material List"
msgstr "Λίστα υλικών"

msgid "Standard Palette"
msgstr "Τυπική παλέτα"

msgid "At least two filaments of the same material type are required for decomposition"
msgstr "Για την αποσύνθεση απαιτούνται τουλάχιστον δύο νημάτια του ίδιου τύπου υλικού"

msgid "A closer mix is calculated from four base colors: cyan, magenta, yellow, and white. Currently only PLA Basic is supported. If matching filaments are not in the project, they will be added automatically."
msgstr "Ένα πιο κοντινό μείγμα υπολογίζεται από τέσσερα βασικά χρώματα: κυανό, ματζέντα, κίτρινο και λευκό. Προς το παρόν υποστηρίζεται μόνο το PLA Basic. Εάν τα αντίστοιχα νήματα δεν υπάρχουν στο έργο, θα προστεθούν αυτόματα."

msgid "A closer mix is calculated from four base colors: red, yellow, blue, and white. Currently only PLA Basic is supported. If matching filaments are not in the project, they will be added automatically."
msgstr "Ένα πιο κοντινό μείγμα υπολογίζεται από τέσσερα βασικά χρώματα: κόκκινο, κίτρινο, μπλε και λευκό. Προς το παρόν υποστηρίζεται μόνο το PLA Basic. Εάν τα αντίστοιχα νήματα δεν υπάρχουν στο έργο, θα προστεθούν αυτόματα."

#, boost-format
msgid "The material list supports at most %1% colors. After %2% decomposition, the material count would exceed %1%. Please delete unused filaments on the main screen before decomposing."
msgstr "Η λίστα υλικών υποστηρίζει έως %1% χρώματα. Μετά την αποσύνθεση %2%, ο αριθμός των υλικών θα υπερέβαινε τα %1%. Διαγράψτε τα αχρησιμοποίητα νήματα από την κύρια οθόνη πριν από την αποσύνθεση."

msgid "Decompose Color (gradient not supported)"
msgstr "Αποσύνθεση χρώματος (δεν υποστηρίζεται η διαβάθμιση)"

msgid "Decompose Color (transparent not supported)"
msgstr "Αποσύνθεση χρώματος (δεν υποστηρίζεται η διαφανής λειτουργία)"

msgid "Decompose Color (multi-color not supported)"
msgstr "Αποσύνθεση χρώματος (δεν υποστηρίζεται η πολυχρωμία)"

