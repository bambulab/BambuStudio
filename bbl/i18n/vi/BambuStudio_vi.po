msgstr "Tạm thời không thể sấy do..."

msgid "Drying Error"
msgstr "Lỗi sấy"

msgid "Please check the Assistant for troubleshooting"
msgstr "Vui lòng kiểm tra Trợ lý để khắc phục sự cố"

msgid "Please remove and store the filament (as shown)."
msgstr "Vui lòng gỡ và bảo quản sợi nhựa (như hình)."

msgid "The AMS can rotate the filament which is properly stored, providing better drying results."
msgstr "AMS có thể xoay sợi nhựa được cất giữ đúng cách, giúp kết quả sấy tốt hơn."

msgid "Rotate spool when drying"
msgstr "Xoay cuộn nhựa khi sấy"

msgctxt "amsdrying"
msgid "Back"
msgstr "Trở về"

msgid "Drying-Heating"
msgstr "Sấy – Làm nóng"

msgid "Drying-Dehumidifying"
msgstr "Sấy – Hút ẩm"

msgid " maximum drying temperature is "
msgstr " nhiệt độ sấy tối đa là "

msgid " minimum drying temperature is "
msgstr " nhiệt độ sấy tối thiểu là "

msgid "This filament may not be completely dried."
msgstr "Sợi nhựa này có thể chưa khô hoàn toàn."

msgid "This AMS is currently printing. To ensure print quality, the drying temperature cannot exceed the recommended drying temperature."
msgstr "AMS này đang in. Để đảm bảo chất lượng in, nhiệt độ sấy không thể vượt quá nhiệt độ sấy được khuyến nghị."

msgid "The temperature shall not exceed the filament's heat distortion temperature"
msgstr "Nhiệt độ không được vượt quá nhiệt độ biến dạng nhiệt của sợi nhựa"

msgid "Minimum time value cannot be less than 1."
msgstr "Giá trị thời gian tối thiểu không thể nhỏ hơn 1."

msgid "Maximum time value cannot be greater than 24."
msgstr "Giá trị thời gian tối đa không thể lớn hơn 24."

msgid "Insufficient power"
msgstr "Không đủ nguồn điện"

msgid "  Too many AMS drying simultaneously. Please plug in the power or stop other drying processes before starting."
msgstr "  Có quá nhiều AMS đang sấy cùng lúc. Vui lòng cắm nguồn điện hoặc dừng các quy trình sấy khác trước khi bắt đầu."

msgid "AMS is busy"
msgstr "AMS đang bận"

msgid "  AMS is calibrating | reading RFID | loading/unloading material, please wait."
msgstr "  AMS đang hiệu chuẩn | đọc RFID | nạp/tháo vật liệu, vui lòng chờ."

msgid "Filament in AMS outlet"
msgstr "Sợi nhựa trong cửa rút AMS"

msgid "  The high drying temperature may cause AMS blockage, please unload first."
msgstr "  Nhiệt độ sấy cao có thể gây tắc nghẽn AMS, vui lòng tháo nhựa trước."

msgid "Initiating AMS drying"
msgstr "Đang khởi động sấy AMS"

msgid "Not supported in 2D mode"
msgstr "Không được hỗ trợ trong chế độ 2D"

msgid "Task in progress"
msgstr "Tác vụ đang tiến hành"

msgid "  The AMS might be in use during Task."
msgstr "  AMS có thể đang được sử dụng trong quá trình thực hiện Tác vụ."

msgid "  Firmware update in progress, please wait..."
msgstr "  Đang cập nhật firmware, vui lòng chờ..."

msgid "  Please plug in the power and then use the drying function."
msgstr "  Vui lòng cắm nguồn điện và sau đó sử dụng chức năng sấy."

msgid "  The high drying temperature may cause AMS blockage. Please unload the filament manually before proceeding."
msgstr "  Nhiệt độ sấy cao có thể gây tắc nghẽn AMS. Vui lòng tháo sợi nhựa theo cách thủ công trước khi tiếp tục."

msgid "System is busy"
msgstr "Hệ thống đang bận"

msgid "  Initiating other drying processes, please wait a few seconds..."
msgstr "  Đang khởi tạo các quy trình sấy khác, vui lòng đợi vài giây..."

msgid "For better drying results, remove the filament and allow it to rotate."
msgstr "Để có kết quả sấy khô tốt hơn, hãy tháo sợi nhựa ra và để nó quay."

msgid "The AMS will automatically rotate the stored filament slots to enhance the drying performance."
msgstr "AMS sẽ tự động xoay các ô sợi nhựa đã lưu trữ để tăng cường hiệu suất sấy khô."

msgid "Alternatively, you can dry the filament without removing it."
msgstr "Ngoài ra, bạn có thể sấy sợi nhựa mà không cần tháo ra."

msgid "Unknown filaments will be treated as PLA."
msgstr "Sợi nhựa không xác định sẽ được xử lý như PLA."

msgid "Please store the filament marked with an exclamation mark."
msgstr "Vui lòng cất sợi nhựa được đánh dấu bằng dấu chấm than."

msgid "Filament left in the feeder during drying may soften because the drying temperature exceeds the softening point of materials like PLA and TPU."
msgstr "Sợi nhựa còn lại trong bộ nạp trong quá trình sấy có thể bị mềm do nhiệt độ sấy vượt quá điểm làm mềm của các vật liệu như PLA và TPU."

