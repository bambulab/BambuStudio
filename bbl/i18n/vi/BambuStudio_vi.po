msgid "TPU is not supported by AMS."
msgstr "TPU không được hỗ trợ bởi AMS."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS không hỗ trợ 'Bambu Lab PET-CF'."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "Sợi nhựa hiện tại không hỗ trợ vòi phun lưu lượng cao E3D và không thể sử dụng được."

#, c-format, boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "Khi sử dụng %s trên vòi đùn nhựa bên phải, nó chỉ có thể được dùng làm vật liệu hỗ trợ."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "Sợi nhựa hiện tại không hỗ trợ vòi phun TPU lưu lượng cao và không thể sử dụng."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "Tính năng Hiệu chuẩn động cho lưu lượng tự động không được hỗ trợ cho sợi nhựa TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Bambu TPU 85A không được hỗ trợ để in với vòi phun 0,4 mm Tiêu chuẩn hoặc Lưu lượng cao."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "Khi sử dụng ABS/ASA/PETG HF trên vòi đùn nhựa bên phải, nó chỉ có thể được dùng làm vật liệu hỗ trợ."

msgid "How to feed TPU filament."
msgstr "Cách nạp sợi nhựa TPU."

msgid "How to feed TPU filament on X2D."
msgstr "Cách nạp sợi nhựa TPU trên X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "Sử dụng sợi nhựa không phải của Bambu có thể gây ra vấn đề về chất lượng in."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "Vui lòng thực hiện rút nguội trước khi in TPU để tránh tắc nghẽn. Bạn có thể sử dụng bảo trì rút nguội trên máy in."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "PVA ẩm sẽ trở nên dẻo và bị kẹt bên trong AMS, vui lòng làm khô trước khi sử dụng."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "Sợi PVA ẩm có tính mềm dẻo và có thể bị kẹt trong vòi đùn nhựa. Vui lòng sấy khô trước khi sử dụng."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF giòn và có thể gãy trong ống PTFE bị uốn cong phía trên đầu in."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF giòn và có thể gãy trong ống PTFE bị uốn cong phía trên đầu in."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "PLA Glow có thể làm mài mòn bộ nạp sợi nhựa giai đoạn đầu của AMS. Thay vào đó, hãy sử dụng cuộn nhựa ngoài."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "Cài đặt mặc định có thể ảnh hưởng đến chất lượng in. Điều chỉnh khi cần để có kết quả tốt nhất."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "%s có nguy cơ làm tắc nghẽn vòi phun khi sử dụng vòi phun 0,4mm lưu lượng cao. Vui lòng sử dụng cẩn thận."

#, c-format, boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "Sợi nhựa %s cứng và giòn, có thể bị đứt trong AMS, và cũng có nguy cơ làm tắc nghẽn vòi phun khi sử dụng vòi phun lưu lượng cao 0,4mm. Vui lòng sử dụng cẩn thận."

#, c-format, boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "%s có nguy cơ làm tắc nghẽn vòi phun khi sử dụng vòi phun 0,4, 0,6, 0,8mm lưu lượng cao. Vui lòng sử dụng cẩn thận."

#, c-format, boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "%s có thể không nạp hoặc tháo được do Công tắc chuyển hướng sợi nhựa. Nếu bạn muốn tiếp tục."

