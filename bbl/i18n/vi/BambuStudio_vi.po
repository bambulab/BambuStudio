msgstr "Cấu hình chất lượng cao cho vòi phun 0,6mm, ưu tiên chất lượng in và độ bền."

msgid "Strength profile for 0.6mm nozzle, prioritizing strength."
msgstr "Cấu hình độ bền cho vòi phun 0,6mm, ưu tiên độ bền."

msgid "Standard profile for 0.6mm nozzle, prioritizing speed."
msgstr "Cấu hình tiêu chuẩn cho vòi phun 0,6mm, ưu tiên tốc độ."

msgid "High quality profile for 0.8mm nozzle, prioritizing print quality."
msgstr "Cấu hình chất lượng cao cho vòi phun 0,8mm, ưu tiên chất lượng in."

