msgid "Connection to Duet works correctly."
msgstr "Kết nối đến Duet hoạt động chính xác."

msgid "Could not connect to Duet"
msgstr "Không thể kết nối đến Duet"

msgid "Unknown error occurred"
msgstr "Đã xảy ra lỗi không xác định"

msgid "Wrong password"
msgstr "Mật khẩu không đúng"

msgid "Could not get resources to create a new connection"
msgstr "Không thể lấy tài nguyên để tạo kết nối mới"

msgid "Upload not enabled on FlashAir card."
msgstr "Tải lên không được bật trên thẻ FlashAir."

msgid "Connection to FlashAir works correctly and upload is enabled."
msgstr "Kết nối đến FlashAir hoạt động chính xác và tính năng tải lên đã được bật."

msgid "Could not connect to FlashAir"
msgstr "Không thể kết nối đến FlashAir"

msgid "Note: FlashAir with firmware 2.00.02 or newer and activated upload function is required."
msgstr "Lưu ý: Yêu cầu FlashAir có firmware 2.00.02 trở lên và chức năng tải lên được kích hoạt."

msgid "Connection to MKS works correctly."
msgstr "Kết nối đến MKS hoạt động chính xác."

msgid "Could not connect to MKS"
msgstr "Không thể kết nối đến MKS"

msgid "Connection to OctoPrint works correctly."
msgstr "Kết nối đến OctoPrint hoạt động chính xác."

msgid "Could not connect to OctoPrint"
msgstr "Không thể kết nối đến OctoPrint"

msgid "Note: OctoPrint version at least 1.1.0 is required."
msgstr "Lưu ý: Yêu cầu OctoPrint phiên bản từ 1.1.0 trở lên."

msgid "Connection to Prusa SL1 / SL1S works correctly."
msgstr "Kết nối đến Prusa SL1 / SL1S hoạt động chính xác."

msgid "Could not connect to Prusa SLA"
msgstr "Không thể kết nối với Prusa SLA"

msgid "Connection to PrusaLink works correctly."
msgstr "Kết nối với PrusaLink hoạt động chính xác."

