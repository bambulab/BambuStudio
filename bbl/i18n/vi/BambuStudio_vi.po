msgstr "kích thước vòi phun đã ghi nhớ: %d"

msgid "The size of nozzle type in preset is not consistent with memorized nozzle.Did you change your nozzle lately ? "
msgstr "Kích thước loại vòi phun trong cài đặt sẵn không khớp với vòi phun đã ghi nhớ. Bạn có vừa thay vòi phun không?"

#, c-format, boost-format
msgid "nozzle[%d] in preset: %.1f"
msgstr "vòi phun [%d] trong cài đặt sẵn: %.1f"

#, c-format, boost-format
msgid "nozzle[%d] memorized: %.1f"
msgstr "vòi phun[%d] đã ghi nhớ: %.1f"

msgid "Your nozzle type in preset is not consistent with memorized nozzle.Did you change your nozzle lately ? "
msgstr "Loại vòi phun của bạn trong cài đặt sẵn không khớp với vòi phun đã ghi nhớ. Bạn có vừa thay vòi phun không?"

#, c-format, boost-format
msgid "Printing %1s material with %2s nozzle may cause nozzle damage."
msgstr "In vật liệu %1s bằng vòi phun %2s có thể gây hỏng vòi phun."

msgid "Need select printer"
msgstr "Cần chọn máy in"

msgid "Failed to load calibration presets. Please check whether the selected printer, nozzle and print profiles are valid."
msgstr "Không thể tải cài đặt sẵn hiệu chuẩn. Vui lòng kiểm tra xem máy in, vòi phun và cấu hình in đã chọn có hợp lệ không."

msgid "The start, end or step is not valid value."
msgstr "Giá trị bắt đầu, kết thúc hoặc bước không hợp lệ."

msgid "TPU 90A/TPU 85A is too soft and does not support automatic Flow Dynamics calibration."
msgstr "TPU 90A/TPU 85A quá mềm và không hỗ trợ hiệu chuẩn động cho lưu lượng tự động."

msgid "The number of printer extruders and the printer selected for calibration does not match."
msgstr "Số lượng vòi đùn nhựa của máy in và máy in được chọn để hiệu chuẩn không khớp."

#, c-format, boost-format
msgid "The type of %sextruder is bowden which does not support automatic Flow Dynamics calibration."
msgstr "Loại vòi đùn nhựa %s là Bowden, vốn không hỗ trợ hiệu chuẩn động cho lưu lượng tự động."

#, c-format, boost-format
msgid "The nozzle diameter of %sextruder is 0.2mm which does not support automatic Flow Dynamics calibration."
msgstr "Đường kính vòi phun của vòi đùn nhựa %s là 0,2mm không hỗ trợ Hiệu chuẩn động cho lưu lượng tự động."

#, c-format, boost-format
msgid ""
"The currently selected nozzle diameter of %s extruder does not match the actual nozzle diameter.\n"
"Please click the Sync button above and restart the calibration."
msgstr ""
"Đường kính vòi phun hiện tại của vòi đùn nhựa %s không khớp với đường kính vòi phun thực tế.\n"
" Vui lòng nhấp nút Đồng bộ ở trên và khởi động lại quá trình hiệu chuẩn."

msgid ""
"The nozzle diameter does not match the actual printer nozzle diameter.\n"
"Please click the Sync button above and restart the calibration."
msgstr ""
"Đường kính vòi phun không khớp với đường kính vòi phun thực tế của máy in.\n"
" Vui lòng nhấp nút Đồng bộ ở trên và khởi động lại quá trình hiệu chuẩn."

#, c-format, boost-format
msgid ""
"The currently selected nozzle type of %s extruder does not match the actual printer nozzle type.\n"
"Please click the Sync button above and restart the calibration."
msgstr ""
"Loại vòi phun hiện tại của vòi đùn nhựa %s không khớp với loại vòi phun thực tế của máy in.\n"
" Vui lòng nhấp nút Đồng bộ ở trên và khởi động lại quá trình hiệu chuẩn."

msgid "Flow calibration does not support multiple nozzle diameters at the same time. Please ensure that the nozzle diameter used by the filament being calibrated is consistent before starting the calibration again."
msgstr "Hiệu chuẩn lưu lượng không hỗ trợ nhiều đường kính vòi phun cùng lúc. Vui lòng đảm bảo đường kính vòi phun được sử dụng bởi sợi nhựa đang hiệu chuẩn là nhất quán trước khi bắt đầu hiệu chuẩn lại."

msgid "Unable to calibrate: maybe because the set calibration value range is too large, or the step is too small"
msgstr "Không thể hiệu chuẩn: có thể do phạm vi giá trị hiệu chuẩn được đặt quá lớn hoặc bước quá nhỏ"

msgid "Physical Printer"
msgstr "Máy in vật lý"

msgid "Print Host upload"
msgstr "Tải lên máy chủ in"

msgid "Test"
msgstr "Kiểm tra"

msgid "Could not get a valid Printer Host reference"
msgstr "Không thể lấy tham chiếu Máy chủ máy in hợp lệ"

msgid "Success!"
msgstr "Thành công!"

msgid "Refresh Printers"
msgstr "Làm mới máy in"

msgid "HTTPS CA file is optional. It is only needed if you use HTTPS with a self-signed certificate."
msgstr "Tệp CA HTTPS là tùy chọn. Chỉ cần thiết nếu bạn sử dụng HTTPS với chứng chỉ tự ký."

msgid "Certificate files (*.crt, *.pem)|*.crt;*.pem|All files|*.*"
msgstr "Tệp chứng chỉ (*.crt, *.pem)|*.crt;*.pem|Tất cả các tệp|*.*"

msgid "Open CA certificate file"
msgstr "Mở tệp chứng chỉ CA"

#, c-format, boost-format
msgid "On this system, %s uses HTTPS certificates from the system Certificate Store or Keychain."
msgstr "Trên hệ thống này, %s sử dụng chứng chỉ HTTPS từ Kho chứng chỉ hoặc Chuỗi khóa của hệ thống."

msgid "To use a custom CA file, please import your CA file into Certificate Store / Keychain."
msgstr "Để sử dụng tệp CA tùy chỉnh, vui lòng nhập tệp CA của bạn vào Kho chứng chỉ / Chuỗi khóa."

msgid "Connection to printers connected via the print host failed."
msgstr "Kết nối đến các máy in được kết nối qua máy chủ in đã thất bại."

#, c-format, boost-format
msgid "Mismatched type of print host: %s"
msgstr "Loại máy chủ in không khớp: %s"

