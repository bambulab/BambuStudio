msgstr "Làm mới %d/%d..."

msgid "Unknown nozzle detected. Refresh to update info (unrefreshed nozzles will be excluded during slicing). Verify nozzle diameter & flow rate against displayed values."
msgstr "Phát hiện vòi phun không xác định. Làm mới để cập nhật thông tin (các vòi phun chưa được làm mới sẽ bị loại trừ trong quá trình cắt lớp). Xác minh đường kính vòi phun và tốc độ lưu lượng so với các giá trị hiển thị."

msgid "Unknown nozzle detected. Refresh to update (unrefreshed nozzles will be skipped in slicing)."
msgstr "Phát hiện vòi phun không xác định. Làm mới để cập nhật (các vòi phun chưa được làm mới sẽ bị bỏ qua khi cắt lớp)."

msgid "Please confirm whether the required nozzle diameter and flow rate match the currently displayed values."
msgstr "Vui lòng xác nhận xem đường kính vòi phun và tốc độ lưu lượng yêu cầu có khớp với các giá trị đang hiển thị hay không."

msgid "Your printer has different nozzles installed. Please select a nozzle for this print."
msgstr "Máy in của bạn có các vòi phun khác nhau được lắp đặt. Vui lòng chọn một vòi phun cho bản in này."

msgid "Purge Mode Settings"
msgstr "Cài đặt chế độ xả nhựa"

msgid "Perform full purging with speed and temperature transition for the best print quality."
msgstr "Thực hiện xả nhựa hoàn chỉnh với chuyển đổi tốc độ và nhiệt độ để có chất lượng in tốt nhất."

msgid "Uses optimized purge temperature, multiplier and stronger extrusion for faster purging. May cause slight color mixing in some extreme cases."
msgstr "Sử dụng nhiệt độ xả nhựa tối ưu, hệ số nhân và lực đùn mạnh hơn để xả nhựa nhanh hơn. Có thể gây lẫn màu nhẹ trong một số trường hợp cực đoan."

msgid "Prime Saving"
msgstr "Tiết kiệm vật liệu đùn mồi"

msgid "Reduces prime waste and prints faster. May cause slight color mixing or small surface defects."
msgstr "Giảm lãng phí vật liệu đùn mồi và in nhanh hơn. Có thể gây lẫn màu nhẹ hoặc các khuyết tật nhỏ trên bề mặt."

msgid "Learn more about prime mode"
msgstr "Tìm hiểu thêm về chế độ đùn mồi"

msgid "AMS Dryness Control"
msgstr "Kiểm soát độ khô AMS"

