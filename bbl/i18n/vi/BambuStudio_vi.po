msgstr "Gia tốc tối đa khi di chuyển (M204 T)"

msgid "Part cooling fan speed may be increased when auto cooling is enabled. This is the maximum speed limitation of part cooling fan"
msgstr "Tốc độ quạt làm mát bộ phận có thể tăng khi bật tính năng làm mát tự động. Đây là giới hạn tốc độ tối đa của quạt làm mát bộ phận"

msgid "Max"
msgstr "Tối đa"

msgid "The largest printable layer height for extruder. Used to limit the maximum layer height when enable adaptive layer height"
msgstr "Chiều cao lớp in lớn nhất cho vòi đùn nhựa. Dùng để giới hạn chiều cao lớp tối đa khi bật chiều cao lớp thích ứng"

msgid "Minimum speed for part cooling fan"
msgstr "Tốc độ tối thiểu của quạt làm mát bộ phận"

msgid "Speed of auxiliary part cooling fan. Auxiliary fan will run at this speed during printing except the first several layers which are defined by no cooling layers"
msgstr "Tốc độ của quạt làm mát bộ phận phụ. Quạt phụ sẽ chạy ở tốc độ này trong quá trình in, trừ một vài lớp đầu tiên được xác định là không làm mát"

msgid "Min"
msgstr "Tối thiểu"

msgid "The lowest printable layer height for extruder. Used to limit the minimum layer height when enable adaptive layer height"
msgstr "Chiều cao lớp in nhỏ nhất cho vòi đùn nhựa. Dùng để giới hạn chiều cao lớp tối thiểu khi bật chiều cao lớp thích ứng"

msgid "Min print speed"
msgstr "Tốc độ in tối thiểu"

msgid "The minimum printing speed when slow down for cooling"
msgstr "Tốc độ in tối thiểu khi giảm tốc để làm mát"

msgid "Nozzle diameter"
msgstr "Đường kính vòi phun"

msgid "Diameter of nozzle"
msgstr "Đường kính của vòi phun"

msgid "Host Type"
msgstr "Loại máy chủ"

msgid "Slic3r can upload G-code files to a printer host. This field must contain the kind of the host."
msgstr "Slic3r có thể tải các tệp Mã G lên máy chủ máy in. Trường này phải chứa loại máy chủ."

msgid "Nozzle volume"
msgstr "Thể tích vòi phun"

msgid "Volume of nozzle between the cutter and the end of nozzle"
msgstr "Thể tích của vòi phun giữa dao cắt và đầu vòi phun"

msgid "Start end points"
msgstr "Điểm bắt đầu và kết thúc"

msgid "The start and end points which are from cutter area to garbage can."
msgstr "Các điểm bắt đầu và kết thúc từ vùng dao cắt đến thùng rác."

msgid "Reduce infill retraction"
msgstr "Giảm rút sợi nhựa phần lấp đầy"

msgid "Controls whether retraction is skipped when traveling within the infill area. \"Auto\" enables this optimization for filaments with low metal stickiness (e.g. PLA) and disables it for medium/high metal stickiness filaments (e.g. PETG) to avoid oozing artifacts. \"Enabled\" always skips retraction in infill areas regardless of filament type. \"Disabled\" always retracts normally."
msgstr "Kiểm soát việc có bỏ qua việc rút sợi nhựa khi di chuyển trong khu vực lấp đầy hay không. \"Tự động\" bật tối ưu hóa này cho các sợi nhựa có độ bám dính kim loại thấp (ví dụ: PLA) và tắt cho các sợi nhựa có độ bám dính kim loại trung bình/cao (ví dụ: PETG) để tránh các vết rỉ nhựa. \"Bật\" luôn bỏ qua việc rút sợi nhựa ở các khu vực lấp đầy bất kể loại sợi nhựa. \"Tắt\" luôn rút sợi nhựa bình thường."

msgid "Filename format"
msgstr "Định dạng tên tệp"

msgid "User can self-define the project file name when export"
msgstr "Người dùng có thể tự định nghĩa tên tệp dự án khi xuất"

msgid "Detect overhang wall"
msgstr "Phát hiện thành nhô ra"

msgid "Detect the overhang percentage relative to line width and use different speed to print. For 100 percent overhang, bridge speed is used."
msgstr "Phát hiện phần trăm nhô ra tương đối so với chiều rộng đường và sử dụng tốc độ in khác nhau. Đối với độ nhô ra 100%, tốc độ bắc cầu sẽ được sử dụng."

msgid "Smooth speed discontinuity area"
msgstr "Làm mượt tốc độ vùng chuyển tiếp"

msgid "Add the speed transition between discontinuity area."
msgstr "Thêm sự chuyển tiếp tốc độ giữa các khu vực gián đoạn."

msgid "Smooth coefficient"
msgstr "Hệ số làm mượt"

msgid "The smaller the number, the longer the speed transition path. 0 means not apply."
msgstr "Số càng nhỏ, đường chuyển đổi tốc độ càng dài. 0 có nghĩa là không áp dụng."

msgid "Walls filament"
msgstr "Sợi nhựa cho thành"

msgid "Filament to print walls"
msgstr "Sợi nhựa dùng để in thành"

msgid "Line width of inner wall"
msgstr "Chiều rộng đường của thành trong"

msgid "Speed of inner wall"
msgstr "Tốc độ của thành trong"

msgid "Number of walls of every layer"
msgstr "Số lượng thành của mỗi lớp"

msgid "Embedding the wall into the infill"
msgstr "Nhúng thành vào phần lấp đầy"

msgid "Embedding the wall into parts where the wall loops are absent ensures that the wall connects seamlessly to the infill."
msgstr "Việc nhúng thành vào các phần không có số lớp thành đảm bảo thành kết nối liền mạch với phần lấp đầy."

msgid "Alternate extra wall"
msgstr "Thành bổ sung xen kẽ"

msgid "Add an extra wall on alternating layers to improve layer bonding and part strength without the full cost of a permanent extra wall."
msgstr "Thêm lớp thành bổ sung trên các lớp xen kẽ để cải thiện độ bám dính giữa các lớp và độ bền của bộ phận mà không tốn toàn bộ chi phí như khi thêm lớp thành bổ sung vĩnh viễn."

msgid "Post-processing Scripts"
msgstr "Tập lệnh hậu xử lý"

msgid "If you want to process the output G-code through custom scripts, just list their absolute paths here. Separate multiple scripts with a semicolon. Scripts will be passed the absolute path to the G-code file as the first argument, and variables of settings also can be read"
msgstr "Nếu bạn muốn xử lý tệp Mã G đầu ra bằng các tập lệnh tùy chỉnh, hãy liệt kê đường dẫn tuyệt đối của chúng tại đây. Phân tách nhiều tập lệnh bằng dấu chấm phẩy. Các tập lệnh sẽ nhận đường dẫn tuyệt đối đến tệp Mã G làm đối số đầu tiên, và các biến cài đặt cũng có thể được đọc"

msgid "Raft contact Z distance"
msgstr "Khoảng cách Z tiếp xúc đế nổi"

msgid "Z gap between object and raft. Ignored for soluble interface"
msgstr "Khoảng cách Z giữa vật thể và đế nổi. Bỏ qua cho lớp tiếp xúc hòa tan"

msgid "Raft expansion"
msgstr "Mở rộng đế nổi"

msgid "Expand all raft layers in XY plane"
msgstr "Mở rộng tất cả các lớp đế nổi trên mặt phẳng XY"

msgid "Initial layer density"
msgstr "Mật độ lớp ban đầu"

msgid "Density of the first raft or support layer"
msgstr "Mật độ của lớp đế nổi hoặc lớp hỗ trợ đầu tiên"

msgid "Initial layer expansion"
msgstr "Mở rộng lớp ban đầu"

msgid "Expand the first raft or support layer to improve bed plate adhesion, -1 means auto"
msgstr "Mở rộng lớp đế nổi hoặc lớp hỗ trợ đầu tiên để cải thiện độ bám dính vào tấm in, -1 có nghĩa là tự động"

msgid "Raft layers"
msgstr "Các lớp đế nổi"

msgid "Object will be raised by this number of support layers. Use this function to avoid warping when print ABS"
msgstr "Vật thể sẽ được nâng lên bằng số lớp cấu trúc đỡ này. Sử dụng chức năng này để tránh cong vênh khi in nhựa ABS"

msgid "G-code path is generated after simplifying the contour of model to avoid too many points and gcode lines in the gcode file. Smaller value means higher resolution and more time to slice"
msgstr "Đường dẫn Mã G được tạo ra sau khi đơn giản hóa đường bao của mô hình để tránh có quá nhiều điểm và dòng mã G trong tệp mã G. Giá trị nhỏ hơn có nghĩa là độ phân giải cao hơn và thời gian cắt lớp lâu hơn"

msgid "Travel distance threshold"
msgstr "Ngưỡng khoảng cách di chuyển"

msgid "Only trigger retraction when the travel distance is longer than this threshold"
msgstr "Chỉ kích hoạt rút sợi nhựa khi khoảng cách di chuyển dài hơn ngưỡng này"

msgid "Retract amount before wipe"
msgstr "Lượng rút sợi nhựa trước khi lau"

msgid "The length of fast retraction before wipe, relative to retraction length"
msgstr "Độ dài rút sợi nhựa nhanh trước khi lau, tính tương đối theo độ dài rút sợi nhựa"

msgid "Retract when change layer"
msgstr "Rút sợi nhựa khi đổi lớp"

msgid "Force a retraction when changes layer"
msgstr "Bắt buộc rút sợi nhựa khi đổi lớp"

msgid "Retraction Length"
msgstr "Độ dài rút sợi nhựa"

msgid "Some amount of material in extruder is pulled back to avoid ooze during long travel. Set zero to disable retraction"
msgstr "Một lượng vật liệu trong vòi đùn nhựa được rút lại để tránh rỉ nhựa khi di chuyển đường dài. Đặt về 0 để tắt rút sợi nhựa"

msgid "Long retraction when cut(experimental)"
msgstr "Rút sợi nhựa dài khi cắt (thử nghiệm)"

msgid "Experimental feature.Retracting and cutting off the filament at a longer distance during changes to minimize purge.While this reduces flush significantly, it may also raise the risk of nozzle clogs or other printing problems."
msgstr "Tính năng thử nghiệm. Rút và cắt sợi nhựa ở khoảng cách dài hơn trong quá trình thay đổi để giảm thiểu việc xả nhựa. Mặc dù điều này giúp giảm đáng kể lượng nhựa lãng phí, nhưng cũng có thể tăng nguy cơ tắc vòi phun hoặc các vấn đề in khác."

msgid "Retraction distance when cut"
msgstr "Khoảng cách rút sợi nhựa khi cắt"

msgid "Experimental feature.Retraction length before cutting off during filament change"
msgstr "Tính năng thử nghiệm. Độ dài rút sợi nhựa trước khi cắt trong quá trình thay sợi nhựa"

msgid "Long retraction when extruder change"
msgstr "Rút sợi nhựa dài khi thay vòi đùn nhựa"

msgid "Retraction distance when extruder change"
msgstr "Khoảng cách rút sợi nhựa khi thay vòi đùn nhựa"

msgid "Z hop when retract"
msgstr "Nâng trục Z khi rút sợi nhựa"

msgid "Whenever the retraction is done, the nozzle is lifted a little to create clearance between nozzle and the print. It prevents nozzle from hitting the print when travel moves. Using spiral line to lift z can prevent stringing"
msgstr "Bất cứ khi nào việc rút sợi nhựa hoàn tất, vòi phun sẽ được nâng lên một chút để tạo khoảng cách giữa vòi phun và vật in. Điều này ngăn vòi phun va chạm với vật in khi di chuyển. Sử dụng đường xoắn ốc để nâng trục Z có thể ngăn ngừa hiện tượng kéo sợi"

msgid "Z hop lower boundary"
msgstr "Giới hạn dưới nhấc trục Z"

msgid "Z hop will only come into effect when Z is above this value and is below the parameter: \"Z hop upper boundary\""
msgstr "Nhấc trục Z sẽ chỉ có hiệu lực khi độ cao Z lớn hơn giá trị này và nhỏ hơn tham số: \"Giới hạn trên nhấc trục Z\""

msgid "Z hop upper boundary"
msgstr "Giới hạn trên nhấc trục Z"

msgid "If this value is positive, Z hop will only come into effect when Z is above the parameter: \"Z hop lower boundary\" and is below this value"
msgstr "Nếu giá trị này là số dương, tính năng nhấc trục Z sẽ chỉ có hiệu lực khi độ cao Z lớn hơn tham số: \"Giới hạn dưới nhấc trục Z\" và nhỏ hơn giá trị này"

msgid "Z Hop Type"
msgstr "Loại nhấc trục Z"

msgid "Slope"
msgstr "Dạng dốc"

msgid "Spiral"
msgstr "Xoắn ốc"

msgid "Direct Drive"
msgstr "Truyền động trực tiếp"

msgid "Bowden"
msgstr ""

msgid "Nozzle Volume Type"
msgstr "Loại thể tích vòi phun"

msgid "Default Nozzle Volume Type"
msgstr "Loại thể tích vòi phun mặc định"

msgid "Saving"
msgstr "Đang lưu"

msgid "Fast"
msgstr "Nhanh"

msgid "length when change hotend"
msgstr "chiều dài khi thay đầu nung"

msgid "When this retraction value is modified, it will be used as the amount of filament retracted inside the hotend before changing hotends."
msgstr "Khi giá trị rút sợi nhựa này được sửa đổi, nó sẽ được dùng làm lượng sợi nhựa được rút vào bên trong đầu nung trước khi thay đầu nung."

msgid "Extra length on restart"
msgstr "Độ dài bổ sung khi khởi động lại"

msgid "When the retraction is compensated after the travel move, the extruder will push this additional amount of filament. This setting is rarely needed."
msgstr "Khi việc rút sợi nhựa được bù sau khi di chuyển, vòi đùn nhựa sẽ đẩy thêm lượng sợi nhựa này. Cài đặt này hiếm khi cần đến."

msgid "When the retraction is compensated after changing tool, the extruder will push this additional amount of filament."
msgstr "Khi việc rút sợi nhựa được bù sau khi thay đổi công cụ, vòi đùn nhựa sẽ đẩy thêm lượng sợi nhựa này."

msgid "Retraction Speed"
msgstr "Tốc độ rút sợi nhựa"

msgid "Speed of retractions"
msgstr "Tốc độ rút sợi nhựa"

msgid "Deretraction Speed"
msgstr "Tốc độ đùn sợi nhựa lại"

msgid "Speed for reloading filament into extruder. Zero means the same speed as retraction"
msgstr "Tốc độ nạp lại sợi nhựa vào vòi đùn nhựa. 0 nghĩa là tốc độ tương tự như rút sợi nhựa"

msgid "Seam position"
msgstr "Vị trí mối nối"

msgid "The start position to print each part of outer wall"
msgstr "Vị trí bắt đầu để in từng phần của thành ngoài"

msgid "Nearest"
msgstr "Gần nhất"

msgid "Aligned"
msgstr "Căn chỉnh"

msgid "Back"
msgstr "Trở về"

msgid "Random"
msgstr "Ngẫu nhiên"

msgid "Seam placement away from overhangs(experimental)"
msgstr "Đặt mối nối tránh khỏi các phần nhô ra (thử nghiệm)"

msgid "Ensure seam placement away from overhangs for alignment and backing modes."
msgstr "Đảm bảo đặt mối nối tránh các phần nhô ra đối với các chế độ căn chỉnh và mặt sau."

msgid "Seam gap"
msgstr "Khoảng cách mối nối"

msgid ""
"In order to reduce the visibility of the seam in a closed loop extrusion, the loop is interrupted and shortened by a specified amount.\n"
"This amount as a percentage of the current extruder diameter. The default value for this parameter is 15"
msgstr ""
"Để giảm độ lộ của mối nối trong quá trình đùn vòng kín, vòng lặp bị gián đoạn và rút ngắn một lượng nhất định.\n"
"Lượng này được tính theo tỷ lệ phần trăm đường kính vòi đùn nhựa hiện tại. Giá trị mặc định cho tham số này là 15"

msgid "Smart scarf seam application"
msgstr "Áp dụng mối nối vát thông minh"

msgid "Apply scarf joints only to smooth perimeters where traditional seams do not conceal the seams at sharp corners effectively."
msgstr "Chỉ áp dụng mối nối vát cho các đường thành nhẵn, nơi các mối nối truyền thống không thể che giấu hiệu quả mối nối ở các góc nhọn."

msgid "Scarf application angle threshold"
msgstr "Ngưỡng góc áp dụng mối nối vát"

msgid ""
"This option sets the threshold angle for applying a conditional scarf joint seam.\n"
"If the seam angle within the perimeter loop exceeds this value (indicating the absence of sharp corners), a scarf joint seam will be used. The default value is 155°."
msgstr ""
"Tùy chọn này đặt góc ngưỡng giới hạn để áp dụng mối nối vát có điều kiện.\n"
"Nếu góc mối nối trong vòng đường thành vượt quá giá trị này (cho thấy không có góc nhọn), mối nối vát sẽ được sử dụng. Giá trị mặc định là 155°."

msgid "Scarf around entire wall"
msgstr "Nối vát quanh toàn bộ thành"

msgid "The scarf extends to the entire length of the wall."
msgstr "Mối nối vát kéo dài hết toàn bộ chiều dài của thành."

msgid "Scarf steps"
msgstr "Các bước nối vát"

msgid "Minimum number of segments of each scarf."
msgstr "Số lượng phân đoạn tối thiểu của mỗi mối nối vát."

msgid "Scarf joint for inner walls"
msgstr "Mối nối vát cho các thành trong"

msgid "Use scarf joint for inner walls as well."
msgstr "Cũng sử dụng mối nối vát cho các thành trong."

msgid "Override filament scarf seam setting"
msgstr "Ghi đè cài đặt mối nối vát sợi nhựa"

msgid "Overrider filament scarf seam setting and could control settings by modifier."
msgstr "Ghi đè cài đặt mối nối vát của sợi nhựa và có thể điều khiển cài đặt bằng bộ chỉnh sửa."

msgid "Wipe speed"
msgstr "Tốc độ lau"

msgid "The wipe speed is determined by the speed setting specified in this configuration.If the value is expressed as a percentage (e.g. 80%), it will be calculated based on the travel speed setting above.The default value for this parameter is 80%"
msgstr "Tốc độ lau được xác định bởi cài đặt tốc độ được chỉ định trong cấu hình này. Nếu giá trị được biểu thị bằng phần trăm (ví dụ: 80%), nó sẽ được tính toán dựa trên cài đặt tốc độ di chuyển ở trên. Giá trị mặc định cho tham số này là 80%"

msgid "Role-based wipe speed"
msgstr "Tốc độ lau dựa trên vai trò"

msgid "The wipe speed is determined by speed of current extrusion role. e.g if a wipe action is executed immediately following an outer wall extrusion, the speed of the outer wall extrusion will be utilized for the wipe action."
msgstr "Tốc độ lau được xác định bởi tốc độ của vai trò đùn hiện tại. Ví dụ, nếu một hành động lau được thực hiện ngay sau khi đùn thành ngoài, tốc độ của quá trình đùn thành ngoài sẽ được sử dụng cho hành động lau."

msgid "Skirt distance"
msgstr "Khoảng cách viền ngoài"

msgid "Distance from skirt to brim or object"
msgstr "Khoảng cách từ viền ngoài đến vành hoặc vật thể"

msgid "Skirt per object"
msgstr "Viền ngoài theo vật thể"

msgid "Generate independent skirt around each object in sequential printing mode. When disabled, a single skirt is drawn around all objects."
msgstr "Tạo viền ngoài độc lập xung quanh mỗi vật thể trong chế độ in tuần tự. Khi tắt, một viền ngoài duy nhất sẽ được vẽ xung quanh tất cả các vật thể."

msgid "Skirt height"
msgstr "Chiều cao viền ngoài"

msgid "How many layers of skirt. Usually only one layer"
msgstr "Số lớp viền ngoài. Thường chỉ một lớp"

msgid "Skirt loops"
msgstr "Số lớp viền ngoài"

msgid "Number of loops for the skirt. Zero means disabling skirt"
msgstr "Số lớp viền ngoài. Bằng 0 nghĩa là tắt viền ngoài"

msgid "The printing speed in exported gcode will be slowed down, when the estimated layer time is shorter than this value, to get better cooling for these layers"
msgstr "Tốc độ in trong Mã G xuất ra sẽ được giảm khi thời gian phủ lớp ước tính ngắn hơn giá trị này, để làm mát tốt hơn cho các lớp này"

msgid "Minimum sparse infill threshold"
msgstr "Ngưỡng lấp đầy thưa tối thiểu"

msgid "Sparse infill area which is smaller than threshold value is replaced by internal solid infill"
msgstr "Vùng lấp đầy thưa nhỏ hơn giá trị ngưỡng sẽ được thay thế bằng lớp lấp đầy đặc bên trong"

msgid "Solid infill filament"
msgstr "Sợi nhựa lấp đầy đặc"

msgid "Filament to print solid infill"
msgstr "Sợi nhựa dùng để in lấp đầy đặc"

msgid "Line width of internal solid infill"
msgstr "Chiều rộng đường của lớp lấp đầy đặc bên trong"

msgid "Speed of internal solid infill, not the top and bottom surface"
msgstr "Tốc độ lớp lấp đầy đặc bên trong, không phải bề mặt trên cùng và dưới cùng"

msgid "Spiralize smooths out the z moves of the outer contour. And turns a solid model into a single walled print with solid bottom layers. The final generated model has no seam"
msgstr "Chế độ xoắn ốc làm mượt các chuyển động theo trục Z của đường bao ngoài. Và biến một mô hình đặc thành một bản in thành đơn với các lớp đáy đặc. Mô hình cuối cùng tạo ra không có mối nối"

msgid "Smooth Spiral"
msgstr "Xoắn ốc mượt"

msgid "Smooth Spiral smoothes out X and Y moves as wellresulting in no visible seam at all, even in the XY directions on walls that are not vertical"
msgstr "Xoắn ốc mượt cũng làm mịn các chuyển động X và Y, loại bỏ hoàn toàn các mối nối có thể nhìn thấy, ngay cả ở các hướng XY trên các thành không dọc"

msgid "Max XY Smoothing"
msgstr "Làm mượt XY tối đa"

msgid "Maximum distance to move points in XY to try to achieve a smooth spiralIf expressed as a %, it will be computed over nozzle diameter"
msgstr "Khoảng cách tối đa để di chuyển các điểm trong XY nhằm đạt được đường xoắn ốc mượt. Nếu biểu thị bằng %, nó sẽ được tính theo đường kính vòi phun"

msgid "If smooth or instant mode is selected, a timelapse video will be generated for each print. After each layer is printed, a snapshot is taken with the chamber camera. All of these snapshots are composed into a timelapse video when printing completes. If smooth mode is selected, the toolhead will move to the excess chute after each layer is printed and then take a snapshot. Since the melt filament may leak from the nozzle during the process of taking a snapshot, prime tower is required for smooth mode to wipe nozzle."
msgstr ""

msgid "Instant"
msgstr ""

msgid "Farthest point timelapse"
msgstr "Quay phim Timelapse tại điểm xa nhất"

msgid "When enabled, the timelapse snapshot is taken at the farthest point from camera instead of traveling to the wipe tower or excess chute. Only effective in instant timelapse mode on non-I3 printers."
msgstr ""

msgid "Temperature variation"
msgstr "Biến thiên nhiệt độ"

msgid "Start G-code"
msgstr "Mã G khởi động"

msgid "Start G-code when start the whole printing"
msgstr "Mã G khởi động khi bắt đầu toàn bộ quá trình in"

msgid "Start G-code when start the printing of this filament"
msgstr "Mã G khởi động khi bắt đầu in bằng sợi nhựa này"

msgid "No sparse layers (experimental)"
msgstr "Không lớp thưa (thử nghiệm)"

msgid "If enabled, the wipe tower will not be printed on layers with no toolchanges. On layers with a toolchange, extruder will travel downward to print the wipe tower. User is responsible for ensuring there is no collision with the print."
msgstr "Nếu bật, tháp mồi sẽ không được in trên các lớp không có thay đổi đầu in. Trên các lớp có thay đổi đầu in, vòi đùn nhựa sẽ di chuyển xuống dưới để in tháp mồi. Người dùng cần tự đảm bảo không xảy ra va chạm với mô hình in."

msgid "Slice gap closing radius"
msgstr "Bán kính đóng khoảng hở cắt lớp"

msgid "Cracks smaller than 2x gap closing radius are being filled during the triangle mesh slicing. The gap closing operation may reduce the final print resolution, therefore it is advisable to keep the value reasonably low."
msgstr "Các vết nứt nhỏ hơn 2 lần bán kính đóng khoảng hở sẽ được lấp đầy trong quá trình cắt lớp lưới tam giác. Thao tác đóng khoảng hở có thể làm giảm độ phân giải in cuối cùng, do đó nên giữ giá trị ở mức thấp hợp lý."

msgid "Slicing Mode"
msgstr "Chế độ cắt lớp"

msgid "Other"
msgstr "Khác"

msgid "Use \"Even-odd\" for 3DLabPrint airplane models. Use \"Close holes\" to close all holes in the model."
msgstr "Sử dụng \"Chẵn-lẻ\" cho các mô hình máy bay 3DLabPrint. Sử dụng \"Bịt kín lỗ\" để đóng tất cả các lỗ trong mô hình."

msgid "Regular"
msgstr "Thường"

msgid "Even-odd"
msgstr "Chẵn-lẻ"

msgid "Close holes"
msgstr "Bịt kín lỗ"

msgid "Enable support"
msgstr "Bật cấu trúc đỡ"

msgid "Enable support generation."
msgstr "Bật tạo cấu trúc đỡ."

msgid "normal(auto) and tree(auto) is used to generate support automatically. If normal(manual) or tree(manual) is selected, only support enforcers are generated"
msgstr "tiêu chuẩn (tự động) và dạng cây (tự động) được sử dụng để tự động tạo cấu trúc đỡ. Nếu chọn tiêu chuẩn (thủ công) hoặc dạng cây (thủ công), chỉ các khối ép tạo cấu trúc đỡ mới được tạo"

msgid "normal(auto)"
msgstr "tiêu chuẩn (tự động)"

msgid "tree(auto)"
msgstr "dạng cây (tự động)"

msgid "normal(manual)"
msgstr "tiêu chuẩn (thủ công)"

msgid "tree(manual)"
msgstr "dạng cây (thủ công)"

msgid "Support/object xy distance"
msgstr "Khoảng cách XY giữa cấu trúc đỡ/vật thể"

msgid "XY separation between an object and its support"
msgstr "Khoảng cách XY giữa vật thể và cấu trúc đỡ của nó"

msgid "Support/object first layer gap"
msgstr "Khoảng hở lớp đầu giữa cấu trúc đỡ/vật thể"

msgid "XY separation between an object and its support at the first layer."
msgstr "Khoảng cách XY giữa vật thể và cấu trúc đỡ của nó ở lớp đầu."

msgid "Pattern angle"
msgstr "Góc kiểu"

msgid "Use this setting to rotate the support pattern on the horizontal plane."
msgstr "Sử dụng cài đặt này để xoay kiểu cấu trúc đỡ trên mặt phẳng ngang."

msgid "On build plate only"
msgstr "Chỉ trên bàn in"

msgid "Don't create support on model surface, only on build plate"
msgstr "Không tạo cấu trúc đỡ trên bề mặt mô hình, chỉ trên bàn in"

msgid "Support critical regions only"
msgstr "Chỉ tạo cấu trúc đỡ cho vùng quan trọng"

msgid "Only create support for critical regions including sharp tail, cantilever, etc."
msgstr "Chỉ tạo cấu trúc đỡ cho các vùng quan trọng, bao gồm phần nhọn, phần nhô ra, v.v."

msgid "Remove small overhangs"
msgstr "Loại bỏ các phần nhô ra nhỏ"

msgid "Remove small overhangs that possibly need no supports."
msgstr "Loại bỏ các phần nhô ra nhỏ có thể không cần cấu trúc đỡ."

msgid "Top Z distance"
msgstr "Khoảng cách Z trên cùng"

msgid "The z gap between the top support interface and object"
msgstr "Khoảng cách Z giữa lớp tiếp xúc cấu trúc đỡ trên cùng và vật thể"

msgid "Bottom Z distance"
msgstr "Khoảng cách Z dưới cùng"

msgid "The z gap between the bottom support interface and object"
msgstr "Khoảng cách Z giữa lớp tiếp xúc cấu trúc đỡ dưới cùng và vật thể"

msgid "Support/raft base"
msgstr "Đế cấu trúc đỡ/đế nổi"

msgid "Filament to print support base and raft. \"Default\" means no specific filament for support and current filament is used"
msgstr "Sợi nhựa dùng để in đế cấu trúc đỡ và đế nổi. \"Mặc định\" có nghĩa là không có sợi nhựa cụ thể nào cho cấu trúc đỡ và sợi nhựa hiện tại sẽ được sử dụng"

msgid "Avoid interface filament for base"
msgstr "Tránh sử dụng sợi nhựa lớp tiếp xúc cho đế"

msgid "Avoid using support interface filament to print support base if possible."
msgstr "Tránh sử dụng sợi nhựa lớp tiếp xúc cấu trúc đỡ để in đế cấu trúc đỡ nếu có thể."

msgid "Line width of support"
msgstr "Chiều rộng đường của cấu trúc đỡ"

msgid "Interface use loop pattern"
msgstr "Lớp tiếp xúc sử dụng kiểu vòng"

msgid "Cover the top contact layer of the supports with loops. Disabled by default."
msgstr "Phủ lớp tiếp xúc trên cùng của cấu trúc đỡ bằng các vòng lặp. Tắt theo mặc định."

msgid "Support/raft interface"
msgstr "Lớp tiếp xúc cấu trúc đỡ/đế nổi"

msgid "Filament to print support interface. \"Default\" means no specific filament for support interface and current filament is used"
msgstr "Sợi nhựa dùng để in lớp tiếp xúc cấu trúc đỡ. \"Mặc định\" có nghĩa là không có sợi nhựa cụ thể nào cho lớp tiếp xúc cấu trúc đỡ và sợi nhựa hiện tại sẽ được sử dụng"

msgid "Top interface layers"
msgstr "Các lớp tiếp xúc trên cùng"

msgid "Number of top interface layers"
msgstr "Số lượng các lớp tiếp xúc trên cùng"

msgid "Bottom interface layers"
msgstr "Các lớp tiếp xúc dưới cùng"

msgid "Number of bottom interface layers"
msgstr "Số lượng các lớp tiếp xúc dưới cùng"

msgid "Same as top"
msgstr "Giống như trên cùng"

msgid "Top interface spacing"
msgstr "Khoảng cách lớp tiếp xúc trên cùng"

msgid "Spacing of interface lines. Zero means solid interface.And zero spacing is required to access the enable_support_ironing option"
msgstr "Khoảng cách giữa các đường lớp tiếp xúc. Bằng 0 nghĩa là lớp tiếp xúc đặc. Và khoảng cách bằng 0 là bắt buộc để truy cập tùy chọn bật_ủi_cấu_trúc_đỡ"

msgid "Enable ironing support interface"
msgstr "Bật ủi lớp tiếp xúc cấu trúc đỡ"

msgid "Ironing is using small flow to print on same height of surface again to make flat surface more smooth. This setting controls whether support interface or raft interface will be ironned.Support ironing could only works on solid interface,that is, support_interface_spacing was zero and support_interface_pattern was't grid"
msgstr "Ủi là việc sử dụng lưu lượng nhỏ để in lại trên cùng độ cao bề mặt nhằm làm cho bề mặt phẳng mịn hơn. Cài đặt này kiểm soát việc lớp tiếp xúc cấu trúc đỡ hay lớp tiếp xúc đế nổi sẽ được ủi. Ủi cấu trúc đỡ chỉ có thể hoạt động trên lớp tiếp xúc đặc, tức là khoảng_cách_lớp_tiếp_xúc_cấu_trúc_đỡ bằng 0 và kiểu_lớp_tiếp_xúc_cấu_trúc_đỡ không phải là dạng lưới"

msgid "Support ironing pattern"
msgstr "Kiểu ủi cấu trúc đỡ"

msgid "Support ironing flow"
msgstr "Lưu lượng ủi cấu trúc đỡ"

msgid "Support ironing line spacing"
msgstr "Khoảng cách đường ủi cấu trúc đỡ"

msgid "Support ironing inset"
msgstr "Khoảng lùi ủi cấu trúc đỡ"

msgid "Support ironing speed"
msgstr "Tốc độ ủi cấu trúc đỡ"

msgid "Support ironing direction"
msgstr "Hướng ủi cấu trúc đỡ"

msgid "Bottom interface spacing"
msgstr "Khoảng cách lớp tiếp xúc dưới cùng"

msgid "Spacing of bottom interface lines. Zero means solid interface"
msgstr "Khoảng cách giữa các đường lớp tiếp xúc dưới cùng. Giá trị 0 nghĩa là lớp tiếp xúc đặc"

msgid "Speed of support interface"
msgstr "Tốc độ lớp tiếp xúc cấu trúc đỡ"

msgid "Base pattern"
msgstr "Kiểu đế"

msgid "Line pattern of support"
msgstr "Kiểu đường của cấu trúc đỡ"

msgid "Rectilinear grid"
msgstr "Lưới hình chữ nhật"

msgid "Hollow"
msgstr "Rỗng"

msgid "Interface pattern"
msgstr "Kiểu lớp tiếp xúc"

msgid "Line pattern of support interface. Default pattern for support interface is Rectilinear Interlaced"
msgstr "Kiểu đường của lớp tiếp xúc cấu trúc đỡ. Kiểu mặc định cho lớp tiếp xúc cấu trúc đỡ là Đan xen hình chữ nhật"

msgid "Rectilinear Interlaced"
msgstr "Đan xen hình chữ nhật"

msgid "Base pattern spacing"
msgstr "Khoảng cách kiểu đế"

msgid "Spacing between support lines"
msgstr "Khoảng cách giữa các đường cấu trúc đỡ"

msgid "Normal Support expansion"
msgstr "Mở rộng cấu trúc đỡ truyền thống"

msgid "Expand (+) or shrink (-) the horizontal span of normal support"
msgstr "Mở rộng (+) hoặc thu hẹp (-) phạm vi ngang của cấu trúc đỡ truyền thống"

msgid "Speed of support"
msgstr "Tốc độ cấu trúc đỡ"

msgid ""
"Style and shape of the support. For normal support, projecting the supports into a regular grid will create more stable supports (default), while snug support towers will save material and reduce object scarring.\n"
"For tree support, slim style will merge branches more aggressively and save a lot of material, strong style will make larger and stronger support structure and use more materials, while hybrid style is the combination of slim tree and normal support with normal nodes under large flat overhangs. Organic style will produce more organic shaped tree structure and less interfaces which makes it easer to be removed. The default style is organic tree for most cases, and hybrid tree if adaptive layer height or soluble interface is enabled."
msgstr ""
"Kiểu dáng và hình dạng của cấu trúc đỡ. Đối với cấu trúc đỡ truyền thống, việc chiếu các cấu trúc đỡ vào một lưới thông thường sẽ tạo ra các cấu trúc đỡ ổn định hơn (mặc định), trong khi các tháp đỡ vừa vặn sẽ tiết kiệm vật liệu và giảm thiểu vết hằn trên vật thể.\n"
"Đối với cấu trúc đỡ dạng cây, kiểu mỏng sẽ sáp nhập các nhánh mạnh mẽ hơn và tiết kiệm nhiều vật liệu, kiểu cứng cáp sẽ tạo ra cấu trúc đỡ lớn hơn và chắc chắn hơn, sử dụng nhiều vật liệu hơn, trong khi kiểu lai là sự kết hợp giữa cây mỏng và cấu trúc đỡ truyền thống với các điểm nối thông thường dưới các phần nhô ra lớn, phẳng. Kiểu hữu cơ sẽ tạo ra cấu trúc cây có hình dạng hữu cơ hơn và ít lớp tiếp xúc hơn, giúp dễ dàng tháo gỡ hơn. Kiểu mặc định là cây hữu cơ cho hầu hết các trường hợp, và cây lai nếu chiều cao lớp thích ứng hoặc lớp tiếp xúc hòa tan được bật."

msgid "Snug"
msgstr "Bám sát"

msgid "Tree Slim"
msgstr "Cây mỏng"

msgid "Tree Strong"
msgstr "Cây cứng cáp"

msgid "Tree Hybrid"
msgstr "Cây lai"

msgid "Tree Organic"
msgstr "Cây hữu cơ"

msgid "Z overrides X/Y"
msgstr "Trục Z ghi đè lên trục X/Y"

msgid "When top z distance overrides support/object xy distance, give priority to ensuring that supports are generated beneath overhangs, and a gap of the same size as top z distance is leaved with the model. Whereas in the opposite case, the gap between supports and the model follows support/object xy distance all the time. Only recommended to enable when using HybridTree."
msgstr "Khi khoảng cách Z trên cùng ghi đè khoảng cách XY giữa cấu trúc đỡ/vật thể, hãy ưu tiên đảm bảo rằng cấu trúc đỡ được tạo ra bên dưới các phần nhô ra, và để lại một khoảng hở có kích thước bằng khoảng cách Z trên cùng với mô hình. Trong trường hợp ngược lại, khoảng hở giữa cấu trúc đỡ và mô hình luôn tuân theo khoảng cách XY giữa cấu trúc đỡ/vật thể. Chỉ nên bật khi sử dụng Cây lai."

msgid "Independent support layer height"
msgstr "Chiều cao lớp cấu trúc đỡ độc lập"

msgid "Support layer uses layer height independent with object layer. This is to support customizing z-gap and save print time.This option will be invalid when the prime tower is enabled."
msgstr "Lớp cấu trúc đỡ sử dụng chiều cao lớp độc lập với lớp vật thể. Điều này giúp tùy chỉnh khoảng cách Z và tiết kiệm thời gian in. Tùy chọn này sẽ không hợp lệ khi tháp mồi được bật."

msgid "Threshold angle"
msgstr "Góc ngưỡng giới hạn"

msgid "Support will be generated for overhangs whose slope angle is below the threshold."
msgstr "Cấu trúc đỡ sẽ được tạo cho các phần nhô ra có góc dốc thấp hơn ngưỡng giới hạn."

msgid "Branch angle"
msgstr "Góc nhánh"

msgid "This setting determines the maximum overhang angle that t he branches of tree support allowed to make.If the angle is increased, the branches can be printed more horizontally, allowing them to reach farther."
msgstr "Cài đặt này xác định góc nhô ra tối đa mà các nhánh của cấu trúc đỡ dạng cây được phép tạo. Nếu góc được tăng lên, các nhánh có thể được in theo chiều ngang hơn, cho phép chúng vươn xa hơn."

msgid "Branch distance"
msgstr "Khoảng cách nhánh"

msgid "This setting determines the distance between neighboring tree support nodes."
msgstr "Cài đặt này xác định khoảng cách giữa các nút cấu trúc đỡ dạng cây lân cận."

msgid "Branch diameter"
msgstr "Đường kính nhánh"

msgid "This setting determines the initial diameter of support nodes."
msgstr "Cài đặt này xác định đường kính ban đầu của các nút cấu trúc đỡ."

msgid "Branch diameter angle"
msgstr "Góc đường kính nhánh"

msgid "The angle of the branches' diameter as they gradually become thicker towards the bottom. An angle of 0 will cause the branches to have uniform thickness over their length. A bit of an angle can increase stability of the tree support."
msgstr "Góc của đường kính nhánh khi chúng dần dày hơn về phía dưới. Góc 0 sẽ khiến các nhánh có độ dày đồng nhất trên toàn bộ chiều dài của chúng. Một góc nhỏ có thể tăng độ ổn định của cấu trúc đỡ dạng cây."

msgid "Support wall loops"
msgstr "Số lớp thành cấu trúc đỡ"

msgid "This setting specifies the count of support walls in the range of [-1,2]. -1 means auto, and 0 means allowing infill-only mode where support is thick enough."
msgstr "Cài đặt này chỉ định số lượng thành hỗ trợ trong phạm vi [-1,2]. -1 nghĩa là tự động, và 0 nghĩa là cho phép chế độ chỉ in phần lấp đầy tại những vị trí cấu trúc đỡ đủ dày."

msgid "Chamber temperature"
msgstr "Nhiệt độ buồng in"

msgid "Higher chamber temperature can help suppress or reduce warping and potentially lead to higher interlayer bonding strength for high temperature materials like ABS, ASA, PC, PA and so on.At the same time, the air filtration of ABS and ASA will get worse.While for PLA, PETG, TPU, PVA and other low temperature materials,the actual chamber temperature should not be high to avoid cloggings, so 0 which stands for turning off is highly recommended"
msgstr "Nhiệt độ buồng in cao hơn có thể giúp ngăn chặn hoặc giảm thiểu cong vênh và nâng cao độ bền liên kết giữa các lớp đối với các vật liệu in nhiệt độ cao như ABS, ASA, PC, PA, v.v. Tuy nhiên, khả năng lọc không khí của ABS và ASA sẽ kém đi. Đối với PLA, PETG, TPU, PVA và các vật liệu nhiệt độ thấp khác, nhiệt độ buồng in thực tế không nên quá cao để tránh tắc nghẽn, do đó rất khuyến nghị đặt là 0 để tắt tính năng này"

msgid "Nozzle temperature for layers after the initial one"
msgstr "Nhiệt độ vòi phun cho các lớp sau lớp đầu tiên"

msgid "Impact Strength Z"
msgstr "Độ bền va đập Z"

msgid "Detect thin wall"
msgstr "Phát hiện thành mỏng"

msgid "Detect thin wall which can't contain two line width. And use single line to print. Maybe printed not very well, because it's not closed loop"
msgstr "Phát hiện thành mỏng không thể chứa hai chiều rộng đường. Và sử dụng một đường duy nhất để in. Chất lượng in có thể không thật sự tốt do đường in không tạo thành một vòng khép kín"

msgid "This gcode is inserted when change filament, including T command to trigger tool change"
msgstr "Mã G này được chèn khi thay sợi nhựa, bao gồm lệnh T để kích hoạt thay đổi công cụ"

msgid "Line width for top surfaces"
msgstr "Chiều rộng đường cho các bề mặt trên cùng"

msgid "Speed of top surface infill which is solid"
msgstr "Tốc độ lấp đầy bề mặt trên cùng dạng đặc"

msgid "Top shell layers"
msgstr "Số lớp vỏ trên cùng"

msgid "This is the number of solid layers of top shell, including the top surface layer. When the thickness calculated by this value is thinner than top shell thickness, the top shell layers will be increased"
msgstr "Đây là số lớp đặc của vỏ trên cùng, bao gồm lớp bề mặt trên cùng. Khi độ dày được tính toán bằng giá trị này mỏng hơn độ dày của lớp vỏ trên cùng, số lớp vỏ trên cùng sẽ được tăng lên"

msgid "Top solid layers"
msgstr "Số lớp đặc trên cùng"

msgid "Top shell thickness"
msgstr "Độ dày của lớp vỏ trên cùng"

msgid "The number of top solid layers is increased when slicing if the thickness calculated by top shell layers is thinner than this value. This can avoid having too thin shell when layer height is small. 0 means that this setting is disabled and thickness of top shell is absolutely determained by top shell layers"
msgstr "Số lớp đặc trên cùng được tăng lên khi cắt lớp nếu độ dày được tính toán theo số lớp vỏ trên cùng mỏng hơn giá trị này. Tùy chọn này giúp tránh vỏ trên cùng quá mỏng khi in ở chiều cao lớp nhỏ. 0 có nghĩa là cài đặt này bị tắt và độ dày vỏ trên cùng được xác định hoàn toàn theo số lớp vỏ trên cùng"

msgid "Top paint penetration layers"
msgstr "Số lớp thấm màu trên cùng"

msgid "This is  the number of layers of top paint penetration."
msgstr "Đây là số lớp thấm màu trên cùng."

msgid "Bottom paint penetration layers"
msgstr "Số lớp thấm màu dưới cùng"

msgid "This is the number of layers of bottom paint penetration."
msgstr "Đây là số lớp xuyên thấu của màu tô mặt đáy."

msgid "Use infill instead of top and bottom surfaces"
msgstr "Sử dụng phần lấp đầy thay cho bề mặt trên và dưới"

msgid "Using infill instead of top and bottom surfaces."
msgstr "Sử dụng phần lấp đầy thay cho bề mặt trên và dưới."

msgid "Speed of travel which is faster and without extrusion"
msgstr "Tốc độ di chuyển nhanh hơn và không đùn nhựa"

msgid "Use relative E distances"
msgstr "Sử dụng khoảng cách E tương đối"

msgid "If your firmware requires relative E values, check this, otherwise leave it unchecked. Must use relative e distance for Bambu printer"
msgstr "Nếu firmware của bạn yêu cầu giá trị E tương đối, hãy chọn tùy chọn này, nếu không thì bỏ chọn. Phải sử dụng khoảng cách E tương đối cho máy in Bambu"

msgid "Use firmware retraction"
msgstr "Sử dụng rút sợi nhựa firmware"

msgid "Convert the retraction moves to G10 and G11 gcode"
msgstr "Chuyển đổi các chuyển động rút sợi nhựa sang mã G G10 và G11"

msgid "Wipe while retracting"
msgstr "Lau khi rút sợi nhựa"

msgid "Move nozzle along the last extrusion path when retracting to clean leaked material on nozzle. This can minimize blob when printing new part after travel"
msgstr "Di chuyển vòi phun dọc theo đường dẫn đùn nhựa cuối cùng khi rút sợi nhựa để làm sạch vật liệu bị rò rỉ trên vòi phun. Điều này có thể giảm thiểu hiện tượng vón cục khi in bộ phận mới sau khi di chuyển"

msgid "Wipe Distance"
msgstr "Khoảng cách lau"

msgid "Describe how long the nozzle will move along the last path when retracting"
msgstr "Mô tả vòi phun sẽ di chuyển bao xa dọc theo đường dẫn cuối cùng khi rút sợi nhựa"

msgid "Mixed color sublayer"
msgstr "Lớp phụ phối màu"

msgid "Enable mixed color sublayer splitting. When enabled, layers containing mixed color filaments will be split into sub-layers to achieve color mixing effects."
msgstr "Bật tính năng tách lớp phụ phối màu. Khi bật, các lớp chứa sợi nhựa màu pha trộn sẽ được tách thành các lớp phụ để đạt được hiệu ứng pha màu."

msgid "The wiping tower can be used to clean up the residue on the nozzle and stabilize the chamber pressure inside the nozzle, in order to avoid appearance defects when printing objects."
msgstr "Tháp mồi có thể được sử dụng để làm sạch cặn bám trên vòi phun và ổn định áp suất buồng bên trong vòi phun, nhằm tránh các khuyết tật về hình thức khi in vật thể."

msgid "Internal ribs"
msgstr "Gân bên trong"

msgid "Enable internal ribs to increase the stability of the prime tower."
msgstr "Bật gân bên trong để tăng độ ổn định của tháp mồi."

msgid "Auto circle contour-hole compensation"
msgstr "Tự động bù lỗ và đường bao tròn"

msgid "Expirment feature to compensate the circle holes and circle contour. This feature is used to improve the accuracy of the circle holes and contour within the diameter below 50mm. Only support PLA Basic, PLA CF, PET CF, PETG CF and PETG HF."
msgstr "Tính năng thử nghiệm để bù lỗ tròn và đường bao tròn. Tính năng này được sử dụng để cải thiện độ chính xác của lỗ tròn và đường bao có đường kính dưới 50mm. Chỉ hỗ trợ PLA Basic, PLA CF, PET CF, PETG CF và PETG HF."

msgid "User Customized Offset"
msgstr "Độ lệch tùy chỉnh của người dùng"

msgid "If you want to have tighter or looser assemble, you can set this value. When it is positive, it indicates tightening, otherwise, it indicates loosening"
msgstr "Nếu bạn muốn lắp ráp chặt hơn hoặc lỏng hơn, bạn có thể đặt giá trị này. Đặt giá trị dương để lắp chặt hơn, giá trị âm sẽ lỏng hơn"

msgid "Scarf Seam On Compensation Circles"
msgstr "Mối nối vát trên các vòng tròn bù"

msgid "Scarf seam will be applied on circles for better dimensional accuracy."
msgstr "Mối nối vát sẽ được áp dụng trên các vòng tròn để có độ chính xác kích thước tốt hơn."

msgid "Circle Compensation Speed"
msgstr "Tốc độ bù vòng tròn"

msgid "circle_compensation_speed"
msgstr "tốc_độ_bù_đường_tròn"

msgid "Counter Coef 1"
msgstr "Hệ số đường bao 1"

msgid "counter_coef_1"
msgstr "hệ_số_lỗ_bậc_1"

msgid "Contour Coef 2"
msgstr "Hệ số đường bao 2"

msgid "counter_coef_2"
msgstr "hệ_số_lỗ_bậc_2"

msgid "Contour Coef 3"
msgstr "Hệ số đường bao 3"

msgid "counter_coef_3"
msgstr "hệ_số_lỗ_bậc_3"

msgid "Hole Coef 1"
msgstr "Hệ số lỗ 1"

msgid "hole_coef_1"
msgstr "hệ_số_lỗ_1"

msgid "Hole Coef 2"
msgstr "Hệ số lỗ 2"

msgid "hole_coef_2"
msgstr "hệ_số_lỗ_2"

msgid "Hole Coef 3"
msgstr "Hệ số lỗ 3"

msgid "hole_coef_3"
msgstr "hệ_số_lỗ_3"

msgid "Contour limit min"
msgstr "Giới hạn đường bao tối thiểu"

msgid "counter_limit_min"
msgstr "giới_hạn_lỗ_tối_thiểu"

msgid "Contour limit max"
msgstr "Giới hạn đường bao tối đa"

msgid "counter_limit_max"
msgstr "giới_hạn_lỗ_bậc_tối_đa"

msgid "Hole limit min"
msgstr "Giới hạn lỗ tối thiểu"

msgid "hole_limit_min"
msgstr "giới_hạn_lỗ_tối_thiểu"

msgid "Hole limit max"
msgstr "Giới hạn lỗ tối đa"

msgid "hole_limit_max"
msgstr "giới_hạn_lỗ_tối_đa"

msgid "Diameter limit"
msgstr "Giới hạn đường kính"

msgid "diameter_limit"
msgstr "giới_hạn_đường_kính"

msgid "Purging volumes"
msgstr "Thể tích xả nhựa"

msgid "Flush multiplier"
msgstr "Hệ số xả"

msgid "The actual flushing volumes is equal to the flush multiplier multiplied by the flushing volumes in the table."
msgstr "Lượng xả thực tế bằng hệ số xả nhân với lượng xả trong bảng."

msgid "Flush multiplier (Fast mode)"
msgstr "Hệ số xả (Chế độ nhanh)"

msgid "The flush multiplier used in fast purge mode."
msgstr "Hệ số xả được sử dụng trong chế độ xả nhựa nhanh."

msgid "Width of prime tower"
msgstr "Chiều rộng tháp mồi"

msgid "Max speed"
msgstr "Tốc độ tối đa"

msgid "The maximum printing speed on the prime tower excluding ramming."
msgstr "Tốc độ in tối đa trên tháp mồi, không bao gồm quá trình ép sợi nhựa."

msgid "Brim width of prime tower, negative number means auto calculated width based on the height of prime tower."
msgstr "Chiều rộng vành của tháp mồi, số âm có nghĩa là chiều rộng tự động tính toán dựa trên chiều cao của tháp mồi."

msgid "Extra rib length"
msgstr "Chiều dài gân bổ sung"

msgid "Positive values can increase the size of the rib wall, while negative values can reduce the size.However, the size of the rib wall can not be smaller than that determined by the cleaning volume."
msgstr "Giá trị dương có thể làm tăng kích thước thành gân, trong khi giá trị âm có thể làm giảm kích thước. Tuy nhiên, kích thước thành gân không thể nhỏ hơn kích thước được xác định bởi thể tích làm sạch."

msgid "Rib width"
msgstr "Chiều rộng gân"

msgid "Rib width is always less than half the prime tower side length."
msgstr "Chiều rộng gân luôn nhỏ hơn một nửa chiều dài cạnh tháp mồi."

msgid "Skip points"
msgstr "Bỏ qua điểm"

msgid "The wall of prime tower will skip the start points of wipe path"
msgstr "Thành của tháp mồi sẽ bỏ qua các điểm bắt đầu của đường lau"

msgid "Rib wall"
msgstr "Thành gân"

msgid "The wall of prime tower will add four ribs and make its cross-section as close to a square as possible, so the width will be fixed."
msgstr "Thành của tháp mồi sẽ thêm bốn gân và làm cho tiết diện của nó gần với hình vuông nhất có thể, do đó chiều rộng sẽ được cố định."

msgid "Fillet wall"
msgstr "Thành bo tròn"

msgid "The wall of prime tower will fillet"
msgstr "Thành của tháp mồi sẽ được bo tròn"

msgid "Infill gap"
msgstr "Khoảng trống lấp đầy"

msgid "Purging after filament change will be done inside objects' infills. This may lower the amount of waste and decrease the print time. If the walls are printed with transparent filament, the mixed color infill will be seen outside. It will not take effect, unless the prime tower is enabled."
msgstr "Việc xả nhựa sau khi thay sợi nhựa sẽ được thực hiện bên trong phần lấp đầy của vật thể. Điều này có thể giảm lượng chất thải và giảm thời gian in. Nếu các thành được in bằng sợi nhựa trong suốt, phần lấp đầy có màu hỗn hợp sẽ bị nhìn thấy từ bên ngoài. Chức năng này sẽ không có hiệu lực trừ khi tháp mồi được bật."

msgid "Purging after filament change will be done inside objects' support. This may lower the amount of waste and decrease the print time. It will not take effect, unless the prime tower is enabled."
msgstr "Việc xả nhựa sau khi thay sợi nhựa sẽ được thực hiện bên trong cấu trúc đỡ của vật thể. Điều này có thể giảm lượng chất thải và giảm thời gian in. Chức năng này sẽ không có hiệu lực trừ khi tháp mồi được bật."

msgid "This object will be used to purge the nozzle after a filament change to save filament and decrease the print time. Colours of the objects will be mixed as a result. It will not take effect, unless the prime tower is enabled."
msgstr "Vật thể này sẽ được sử dụng để xả nhựa khỏi vòi phun sau khi thay sợi nhựa nhằm tiết kiệm sợi nhựa và giảm thời gian in. Kết quả là màu sắc của các vật thể sẽ bị lẫn vào nhau. Chức năng này sẽ không có hiệu lực trừ khi tháp mồi được bật."

msgid "X-Y hole compensation"
msgstr "Bù lỗ X-Y"

msgid "Holes of object will be grown or shrunk in XY plane by the configured value. Positive value makes holes bigger. Negative value makes holes smaller. This function is used to adjust size slightly when the object has assembling issue"
msgstr "Các lỗ của vật thể sẽ được tăng hoặc giảm kích thước trên mặt phẳng XY theo giá trị đã cấu hình. Giá trị dương làm lỗ lớn hơn. Giá trị âm làm lỗ nhỏ hơn. Chức năng này được sử dụng để tinh chỉnh nhẹ kích thước khi vật thể gặp sự cố về lắp ráp"

msgid "X-Y contour compensation"
msgstr "Bù đường bao X-Y"

msgid "Contour of object will be grown or shrunk in XY plane by the configured value. Positive value makes contour bigger. Negative value makes contour smaller. This function is used to adjust size slightly when the object has assembling issue"
msgstr "Đường bao của vật thể sẽ được tăng hoặc giảm kích thước trên mặt phẳng XY theo giá trị đã cấu hình. Giá trị dương làm đường bao lớn hơn. Giá trị âm làm đường bao nhỏ hơn. Chức năng này được sử dụng để tinh chỉnh nhẹ kích thước khi vật thể gặp sự cố về lắp ráp"

msgid "Classic wall generator produces walls with constant extrusion width and for very thin areas is used gap-fill. Arachne engine produces walls with variable extrusion width"
msgstr "Trình tạo thành kinh điển tạo ra các thành với chiều rộng đùn không đổi và sử dụng lấp đầy khoảng trống cho các khu vực rất mỏng. Công cụ Arachne tạo ra các thành với chiều rộng đùn biến thiên"

msgid "Arachne"
msgstr ""

msgid "Wall transition length"
msgstr "Chiều dài chuyển tiếp thành"

msgid "When transitioning between different numbers of walls as the part becomes thinner, a certain amount of space is allotted to split or join the wall segments. It's expressed as a percentage over nozzle diameter"
msgstr "Khi chuyển đổi giữa các số lượng thành khác nhau khi bộ phận trở nên mỏng hơn, một khoảng cách nhất định được dành để tách hoặc nối các đoạn thành. Nó được biểu thị theo tỷ lệ phần trăm của đường kính vòi phun"

msgid "Wall transitioning filter margin"
msgstr "Biên lọc chuyển tiếp thành"

msgid "Prevent transitioning back and forth between one extra wall and one less. This margin extends the range of extrusion widths which follow to [Minimum wall width - margin, 2 * Minimum wall width + margin]. Increasing this margin reduces the number of transitions, which reduces the number of extrusion starts/stops and travel time. However, large extrusion width variation can lead to under- or overextrusion problems. It's expressed as a percentage over nozzle diameter"
msgstr "Ngăn chặn việc chuyển tiếp qua lại giữa thêm một thành và bớt một thành. Biên này mở rộng phạm vi chiều rộng đùn tuân theo [Chiều rộng thành tối thiểu - biên, 2 * Chiều rộng thành tối thiểu + biên]. Việc tăng biên này làm giảm số lần chuyển tiếp, từ đó giảm số lần bắt đầu/dừng đùn và thời gian di chuyển. Tuy nhiên, sự thay đổi lớn về chiều rộng đùn có thể dẫn đến các vấn đề đùn thiếu hoặc đùn thừa. Nó được biểu thị bằng phần trăm so với đường kính vòi phun"

msgid "Wall transitioning threshold angle"
msgstr "Góc ngưỡng giới hạn chuyển tiếp thành"

msgid "When to create transitions between even and odd numbers of walls. A wedge shape with an angle greater than this setting will not have transitions and no walls will be printed in the center to fill the remaining space. Reducing this setting reduces the number and length of these center walls, but may leave gaps or overextrude"
msgstr "Xác định thời điểm tạo các bước chuyển tiếp giữa số lượng vòng thành chẵn và lẻ. Cấu trúc hình nêm có góc lớn hơn cài đặt này sẽ không có chuyển tiếp và không có thành nào được in ở giữa để lấp đầy không gian còn lại. Giảm giá trị cài đặt này làm giảm số lượng và chiều dài của các thành trung tâm này, nhưng có thể để lại khoảng hở hoặc gây đùn thừa"

msgid "Wall distribution count"
msgstr "Số lượng phân bố thành"

msgid "The number of walls, counted from the center, over which the variation needs to be spread. Lower values mean that the outer walls don't change in width"
