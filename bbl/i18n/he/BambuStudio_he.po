msgstr "ההסרה הושלמה בהצלחה. ניתן כעת להסיר בבטחה את ההתקן %s(%s) מהמחשב."

#, possible-c-format, possible-boost-format
msgid "Ejecting of device %s(%s) has failed."
msgstr "הוצאת ההתקן %s(%s) נכשלה."

msgid ""
"It seems that you have projects that were not closed properly. Would you like to restore your last unsaved project?\n"
"If you have a currently opened project and click \"Restore\", the current project will be closed."
msgstr "נראה שיש פרויקטים שלא נסגרו כראוי. האם ברצונך לשחזר את הפרויקט האחרון שלא נשמר?\nלחיצה על \"שחזור\" כאשר קיים פרויקט פתוח תסגור את הפרויקט הנוכחי."

msgid "Restore"
msgstr "שחזור"

msgid "The nozzle hardness required by the filament is higher than the default nozzle hardness of the printer. Please replace the hardened nozzle or filament, otherwise, the nozzle will be attrited or damaged."
msgstr "קשיחות הנחיר הנדרשת על ידי הפילמנט גבוהה מקשיחות הנחיר שמוגדרת כברירת מחדל במדפסת. יש להחליף לנחיר מוקשה או לפילמנט אחר, אחרת הנחיר יישחק או ייפגע."

msgid "Enabling instant timelapse photography may cause surface imperfections. It is recommended to change to smooth mode."
msgstr "הפעלת צילום טיימלאפס מיידי עלולה לגרום לפגמים במשטח. מומלץ לעבור למצב חלק."

msgid "\n"
msgstr "\n"

msgid "(Path to modify: 'Process'-'Others'-'Special Mode'-'Timelapsed')"
msgstr "(נתיב לשינוי: 'תהליך'-'אחר'-'מצב מיוחד'-'טיימלאפס')"

msgid "Smooth mode for timelapse is enabled, but the prime tower is off, which may cause print defects. Please enable the prime tower, re-slice and print again."
msgstr "מצב חלק לטיימלאפס מופעל, אך מגדל הניקוי כבוי, מה שעלול לגרום לפגמי הדפסה. יש להפעיל את מגדל הניקוי, לבצע סלייס מחדש ולהדפיס שוב."

msgid "Expand sidebar"
msgstr "הרחבת סרגל הצד"

msgid "Collapse sidebar"
msgstr "כיווץ סרגל הצד"

