msgid "TPU is not supported by AMS."
msgstr "TPU אינו נתמך ב-AMS."

msgid "AMS does not support 'Bambu Lab PET-CF'."
msgstr "AMS אינו תומך ב-'Bambu Lab PET-CF'."

msgid "The current filament doesn't support the E3D high-flow nozzle and can't be used."
msgstr "הפילמנט הנוכחי אינו תומך בנחיר E3D בזרימה גבוהה ולא ניתן להשתמש בו."

#, possible-c-format, possible-boost-format
msgid "When using %s on the right extruder, it can only be used as support material."
msgstr "בשימוש ב-%s באקסטרודר הימני, ניתן להשתמש בו רק כחומר סאפורט."

msgid "The current filament doesn't support the TPU high-flow nozzle and can't be used."
msgstr "הפילמנט הנוכחי אינו תומך בנחיר TPU בזרימה גבוהה ולא ניתן להשתמש בו."

msgid "Auto dynamic flow calibration is not supported for TPU filament."
msgstr "כיול דינמיקת זרימה אוטומטי אינו נתמך עבור פילמנט TPU."

msgid "Bambu TPU 85A is not supported for printing with 0.4 mm Standard or High Flow nozzles."
msgstr "Bambu TPU 85A אינו נתמך להדפסה עם נחירים רגילים או בזרימה גבוהה בקוטר 0.4 mm."

msgid "When using ABS/ASA/PETG HF on the right extruder, it can only be used as support material."
msgstr "בשימוש ב-ABS/ASA/PETG HF באקסטרודר הימני, ניתן להשתמש בו רק כחומר סאפורט."

msgid "How to feed TPU filament."
msgstr "כיצד להזין פילמנט TPU."

msgid "How to feed TPU filament on X2D."
msgstr "כיצד להזין פילמנט TPU ב-X2D."

msgid "Using non-bambu filament may have printing quality issues."
msgstr "שימוש בפילמנט שאינו של Bambu עלול לגרום לבעיות באיכות ההדפסה."

msgid "Please cold pull before printing TPU to avoid clogging. You may use cold pull maintenance on the printer."
msgstr "יש לבצע משיכה קרה (cold pull) לפני הדפסת TPU כדי למנוע סתימה. ניתן להשתמש בתחזוקת משיכה קרה במדפסת."

msgid "Damp PVA will become flexible and get stuck inside AMS,please take care to dry it before use."
msgstr "PVA לח הופך לגמיש ועלול להיתקע בתוך ה-AMS, יש לייבש אותו לפני השימוש."

msgid "Damp PVA is flexible and may get stuck in extruder. Dry it before use."
msgstr "PVA לח הוא גמיש ועלול להיתקע באקסטרודר. יש לייבש אותו לפני השימוש."

msgid "PPS-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPS-CF שביר ועלול להישבר בצינור PTFE מכופף שמעל ראש ההדפסה."

msgid "PPA-CF is brittle and could break in bended PTFE tube above Toolhead."
msgstr "PPA-CF שביר ועלול להישבר בצינור PTFE מכופף שמעל ראש ההדפסה."

msgid "CF/GF filaments are hard and brittle, It's easy to break or get stuck in AMS, please use with caution."
msgstr "פילמנטים מסוג CF/GF קשים ושבירים, ועלולים להישבר בקלות או להיתקע ב-AMS. יש לנקוט זהירות בשימוש."

msgid "PLA Glow may wear the AMS first stage feeder. Use an external spool instead."
msgstr "PLA Glow עלול לשחוק את מזין השלב הראשון של ה-AMS. מומלץ להשתמש בגליל חיצוני במקום זאת."

msgid "Default settings may affect print quality. Adjust as needed for best results."
msgstr "הגדרות ברירת המחדל עלולות להשפיע על איכות ההדפסה. יש להתאים אותן לפי הצורך לקבלת תוצאות מיטביות."

#, possible-c-format, possible-boost-format
msgid "%s has a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "ל-%s יש סיכון לסתימת נחיר בעת שימוש בנחירי זרימה גבוהה בקוטר 0.4mm. יש לנקוט זהירות."

#, possible-c-format, possible-boost-format
msgid "%s filaments are hard and brittle and could break in AMS, and there is also a risk of nozzle clogging when using 0.4mm high-flow nozzles. Use with caution."
msgstr "פילמנטים מסוג %s קשים ושבירים ועלולים להישבר ב-AMS, וקיים גם סיכון לסתימת נחיר בעת שימוש בנחירי זרימה גבוהה בקוטר 0.4mm. יש לנקוט זהירות."

#, possible-c-format, possible-boost-format
msgid "%s has a risk of nozzle clogging when using 0.4, 0.6, 0.8mm high-flow nozzles. Use with caution."
msgstr "ל-%s יש סיכון לסתימת נחיר בעת שימוש בנחירי זרימה גבוהה בקוטר 0.4, 0.6, 0.8mm. יש לנקוט זהירות."

#, possible-c-format, possible-boost-format
msgid "%s may fail to load or unload due to the Filament Track Switch. If you wish to continue."
msgstr "הטעינה או הפריקה של %s עלולות להיכשל בגלל Filament Track Switch. אם ברצונך להמשיך."

#, possible-c-format, possible-boost-format
msgid "%s is not supported by %s extruder."
msgstr "%s אינו נתמך על ידי אקסטרודר %s."

#, possible-c-format, possible-boost-format
msgid "There may be critical print quality issues when printing '%s' with %s Bowden extruder. Use with caution!"
msgstr "ייתכנו בעיות קריטיות באיכות ההדפסה בעת הדפסת '%s' עם אקסטרודר Bowden %s. יש לנקוט זהירות!"

#, possible-c-format, possible-boost-format
msgid "There may be critical print quality issues when printing '%s' with %s extruder. Use with caution!"
msgstr "ייתכנו בעיות קריטיות באיכות ההדפסה בעת הדפסת '%s' עם אקסטרודר %s. יש לנקוט זהירות!"

