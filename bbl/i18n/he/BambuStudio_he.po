msgstr "הפילמנט שנבחר למחיקה נמצא כעת בשימוש על ידי %s. לאחר המחיקה, פילמנט המודל יאופס לפילמנט הראשון ברשימה."

msgid "Tips: If you wish to replace it with another filament, please use the \"Merge to\" function on the right side of the filament list."
msgstr "טיפים: כדי להחליף בפילמנט אחר, ניתן להשתמש בפונקציה \"מיזוג אל\" בצד ימין של רשימת הפילמנטים."

msgid "Delete Filament"
msgstr "מחיקת פילמנט"

msgid "The target mixed filament uses this physical filament as a component. Merging will remove this physical filament and may invalidate the mixed filament. Continue?"
msgstr "הפילמנט המעורב היעד משתמש בפילמנט הפיזי הזה כרכיב. המיזוג יסיר את הפילמנט הפיזי ועלול לפגוע בתקינות הפילמנט המעורב. להמשיך?"

#, possible-c-format, possible-boost-format
msgid "After completing your operation, %s project will be closed and create a new project."
msgstr "לאחר השלמת הפעולה, פרויקט %s ייסגר ויווצר פרויקט חדש."

msgid "There are no compatible filaments, and sync is not performed."
msgstr "אין פילמנטים תואמים, ולא בוצע סנכרון."

msgid "Sync filaments with AMS"
msgstr "סנכרון פילמנטים עם AMS"

msgid ""
"There are some unknown or uncompatible filaments mapped to generic preset.\n"
"Please update Bambu Studio or restart Bambu Studio to check if there is an update to system presets."
