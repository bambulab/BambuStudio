+template <typename Traits>
+template <typename iPoint, typename iPoints, typename iTri, typename iTris>
+void MeshBoolean_Impl<Traits>::exportLabeledArrangement(
+  iPoints &points, iTris &tris, std::vector<Label> &surface,
+  std::vector<Label> &inside, std::vector<Label> &opposite) const
+{
+  const size_t num_tris = arr_out_tris.size() / 3;
+  points.clear();
+  tris.clear();
+  tris.reserve(num_tris);
+
+  // compact the vertices in use, in order of first use
+  size_t               num_vertices = 0;
+  std::vector<index_t> vertex_index(arr_out_verts.size(), InvalidIndex);
+  for (index_t t_id = 0; t_id < num_tris; ++t_id)
+  {
+    std::array<index_t, 3> out_tri;
+    for (size_t i = 0; i < 3; i++)
+    {
+      const index_t old_vid = arr_out_tris[3 * t_id + i];
+      if (!is_valid_idx(vertex_index[old_vid]))
+        vertex_index[old_vid] = num_vertices++;
+      out_tri[i] = vertex_index[old_vid];
+    }
+    tris.push_back(iTri(out_tri[0], out_tri[1], out_tri[2]));
+  }
+
+  points.resize(num_vertices);
+  tbb::parallel_for(index_t(0), arr_out_verts.size(),
+                    [this, &vertex_index, &points](index_t v_id)
+                    {
+                      if (!is_valid_idx(vertex_index[v_id]))
+                        return;
+                      EPoint3 ep = ToEP()(*arr_out_verts[v_id]);
+                      points[vertex_index[v_id]] = iPoint(ep.x(), ep.y(), ep.z());
+                    });
+
+  surface  = arr_out_labels.surface;
+  inside   = arr_out_labels.inside;
+  opposite = arr_out_labels.opposite;
+  opposite.resize(num_tris);
+}
