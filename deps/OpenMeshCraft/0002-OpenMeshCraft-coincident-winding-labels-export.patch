+/// Four affinely independent explicit points: at least one is off any plane.
+template <typename Traits>
+auto Triangulation<Traits>::offPlanePoints() -> const std::array<EPoint3, 4> &
+{
+  static const std::array<EPoint3, 4> pnts = {
+    EPoint3(0., 0., 0.), EPoint3(1., 0., 0.), EPoint3(0., 1., 0.),
+    EPoint3(0., 0., 1.)};
+  return pnts;
+}
+
+template <typename Traits>
+bool Triangulation<Traits>::oppositeWinding(const index_t *t0,
+                                            const index_t *t1) const
+{
+  // Coplanar triangles wind the same way iff they see a point off their plane
+  // on the same side.
+  for (const EPoint3 &jp : offPlanePoints())
+  {
+    const Sign s0 = Orient3D()(ts.vert(t0[0]), ts.vert(t0[1]), ts.vert(t0[2]),
+                               AsGP()(jp));
+    if (s0 == Sign::ZERO)
+      continue;
+    const Sign s1 = Orient3D()(ts.vert(t1[0]), ts.vert(t1[1]), ts.vert(t1[2]),
+                               AsGP()(jp));
+    return s0 != s1;
+  }
+  OMC_THROW_RUNTIME_ERROR("degenerate triangle in coincident pocket.");
+  return false;
+}
