diff --git a/src/OpenMeshCraft/Utils/ContainerOp.h b/src/OpenMeshCraft/Utils/ContainerOp.h
index a5d161c..38d2ff6 100644
--- a/src/OpenMeshCraft/Utils/ContainerOp.h
+++ b/src/OpenMeshCraft/Utils/ContainerOp.h
@@ -34,7 +34,15 @@ template <typename T>
 inline void remove_duplicates(tbb::concurrent_vector<T> &values)
 {
   std::sort(values.begin(), values.end());
-  values.resize(std::unique(values.begin(), values.end()) - values.begin());
+  const size_t n = std::unique(values.begin(), values.end()) - values.begin();
+  if (n == values.size())
+    return;
+  // Do not shrink with resize(): it frees segments that belong to the reserved first
+  // block, and a later push_back into them spins forever waiting for that segment
+  // (oneTBB 2021.5 - 2022.1). clear() keeps the segments.
+  std::vector<T> unique_values(values.begin(), values.begin() + n);
+  values.clear();
+  values.grow_by(unique_values.begin(), unique_values.end());
 }
 
 // This function removes duplicate elements from a vector of type T in parallel.
