+// validation at all (see BufferView::Read), so they can describe a region far
+// larger than the buffer allocation they point into. Checking that an accessor
+// stays inside its bufferView is therefore not enough on its own - the view has
+// to be proven to fit in the buffer as well, or reads through it run off the end
+// of the heap block. Buffer::byteLength always matches the allocation made in
+// Buffer::Read/LoadFromStream, which makes it the one bound worth trusting.
+inline void ValidateBufferViewBounds(BufferView &bv) {
+    if (bv.buffer->EncodedRegion_Current != nullptr) {
+        // GetPointer() serves this view out of a separate decoded block, which
+        // the buffer length does not describe.
+        return;
+    }
+    if (bv.byteOffset > bv.buffer->byteLength ||
