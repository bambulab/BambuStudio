@@ -310,8 +310,12 @@ void MeshGeometry::ReadVertexData(const std::string& type, int index, const Scop
     );
 
     if (type == "LayerElementUV") {
-        if(index >= AI_MAX_NUMBER_OF_TEXTURECOORDS) {
